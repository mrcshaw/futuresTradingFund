# Orders are built and logged, and are not sent, until this is false.
DRY_RUN=true

# CrossTrade dashboard: Webhook URL and Secret Key.
# The key stays here. Do not put it in the TradingView alert.
CROSSTRADE_WEBHOOK_URL=
CROSSTRADE_KEY=

# Path token for the TradingView alert URL:
# https://YOUR_PUBLIC_HOST/hooks/tradingview/THIS_TOKEN
TV_WEBHOOK_TOKEN=

# Prop account names exactly as they appear in NinjaTrader or Tradovate.
# Comma-separated. An alert for any other account is refused.
PROP_ACCOUNTS=

# Largest contract count one alert may send.
FUTURES_MAX_QTY=5

# 8:00am Monday-Friday and 5:00pm Sunday-Friday keep the current strategy or adjust it. They do not send orders.
MEETING_TRADES=false

# Reports are sent from the base Gmail account. SMTP_PASSWORD is that account's app password.
# REPORT_TO is the inbox that receives the reports and the prop-firm mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rece2005@gmail.com
SMTP_PASSWORD=
REPORT_FROM=rece2005@gmail.com
REPORT_TO=thefutureoffuturestrading@gmail.com

# Bearer token for the NinjaTrader 8 API (My Account on CrossTrade).
# Used to confirm fills and to read the live position. Orders are still sent through the webhook above.
CROSSTRADE_API_TOKEN=

# Path token for inbound prop-firm mail:
# https://YOUR_PUBLIC_HOST/hooks/mail/THIS_TOKEN
MAIL_WEBHOOK_TOKEN=
