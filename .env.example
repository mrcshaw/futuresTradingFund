# Orders are built and logged, and are not sent, until this is false.
DRY_RUN=true

# CrossTrade dashboard: Webhook URL and Secret Key.
# The key stays here. Do not put it in the TradingView alert.
CROSSTRADE_WEBHOOK_URL=
CROSSTRADE_KEY=

# Path token for the TradingView alert URL:
# https://YOUR_PUBLIC_HOST/hooks/tradingview/THIS_TOKEN
TV_WEBHOOK_TOKEN=

# Prop account names exactly as they appear in NinjaTrader or Tradovate.
# Comma-separated. An alert for any other account is refused.
PROP_ACCOUNTS=

# Largest contract count one alert may send.
FUTURES_MAX_QTY=5

# 8:00am and 3:00pm keep the current strategy or adjust it. They do not send orders.
MEETING_TRADES=false
