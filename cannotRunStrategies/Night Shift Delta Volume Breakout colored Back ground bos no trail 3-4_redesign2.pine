//@version=5
strategy("Delta Volume Breakout Night Shift Redesign 2", overlay=true, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=5.50, slippage=1, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false, max_bars_back=5000)

// ===== RISK =====
pv                = input.float(5, "Point Value ($)", minval=1, maxval=100)
stop_dollars      = input.int(250, "Stop ($)", minval=250, maxval=700)
tp_dollars        = input.int(500, "Take Profit ($)", minval=250, maxval=5000)

// ===== SESSION =====
use_session   = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)", minval=0, maxval=23)
sess_start_mn = input.int(0,  "Session Start Minute", minval=0, maxval=59)
sess_end_hr   = input.int(16,  "Session End Hour (ET)", minval=0, maxval=23)
sess_end_mn   = input.int(0,  "Session End Minute", minval=0, maxval=59)

sess_bar_hr = hour(time, "America/New_York")
sess_bar_mn = minute(time, "America/New_York")
sess_bar_t = sess_bar_hr * 100 + sess_bar_mn
sess_clock_start = sess_start_hr * 100 + sess_start_mn
sess_clock_end = sess_end_hr * 100 + sess_end_mn

in_session = not use_session or (sess_clock_start > sess_clock_end ? (sess_bar_t >= sess_clock_start or sess_bar_t < sess_clock_end) : (sess_bar_t >= sess_clock_start and sess_bar_t < sess_clock_end))

// ===== PROFILE INPUTS =====
profile_lookback  = input.int(120, "Profile Lookback (bars)", minval=20, maxval=2000, step=10)
profile_rows      = input.int(10, "Price Levels (rows)", minval=5, maxval=100, step=5)

// ===== TREND AND DELTA INPUTS =====
min_delta_pct     = input.float(5.0, "Min Delta Imbalance (%)", minval=0, maxval=80, step=5)
vwma_len          = input.int(20, "VWMA Length", minval=5, maxval=200)

// ===== ENTRY INPUT =====
pivot_len         = input.int(5, "Pivot Length", minval=2, maxval=50)

// ===== REVERSAL INPUT =====
use_reversal_after_stop = input.bool(true, "Use Reversal After Stop")

// ===== VOLUME PROFILE =====
int lb   = math.min(profile_lookback, bar_index)
int rows = profile_rows

float prof_hi   = ta.highest(high, lb > 0 ? lb : 1)
float prof_lo   = ta.lowest(low, lb > 0 ? lb : 1)
float prof_span = prof_hi - prof_lo
float step_size = prof_span > 0 ? prof_span / rows : na

var array<float> vol_total = array.new_float(100, 0.0)
var array<float> vol_up    = array.new_float(100, 0.0)
var array<float> vol_dn    = array.new_float(100, 0.0)

float poc_price = na
float poc_hi    = na
float poc_lo    = na
float poc_delta_pct = na
int   poc_row   = 0

if not na(step_size) and prof_span > 0 and lb > 1
    for a = 0 to 2
        arr = a == 0 ? vol_total : a == 1 ? vol_up : vol_dn
        if arr.size() != rows
            arr.clear()
            for i = 0 to rows - 1
                arr.push(0.0)
        else
            for i = 0 to rows - 1
                arr.set(i, 0.0)

    for iBar = 0 to lb - 1
        float bar_vol = volume[iBar]
        if bar_vol <= 0
            continue

        float bar_lo  = low[iBar]
        float bar_hi  = high[iBar]
        bool  bar_up  = close[iBar] >= open[iBar]

        int s_row = math.max(math.floor((bar_lo - prof_lo) / step_size), 0)
        int e_row = math.min(math.floor((bar_hi - prof_lo) / step_size), rows - 1)
        int span  = e_row - s_row + 1

        if span <= 0
            continue

        float per_row = bar_vol / span
        for k = 0 to span - 1
            int r = s_row + k
            if r >= 0 and r < rows
                vol_total.set(r, vol_total.get(r) + per_row)
                if bar_up
                    vol_up.set(r, vol_up.get(r) + per_row)
                else
                    vol_dn.set(r, vol_dn.get(r) + per_row)

    float max_vol = 0.0
    for r = 0 to rows - 1
        float v = vol_total.get(r)
        if v > max_vol
            max_vol := v
            poc_row := r

    poc_price := prof_lo + (poc_row + 0.5) * step_size
    poc_lo    := prof_lo + poc_row * step_size
    poc_hi    := prof_lo + (poc_row + 1) * step_size

    float poc_up  = vol_up.get(poc_row)
    float poc_dn  = vol_dn.get(poc_row)
    float poc_tot = vol_total.get(poc_row)
    poc_delta_pct := poc_tot > 0 ? ((poc_up - poc_dn) / poc_tot) * 100 : 0.0

// ===== VWMA =====
float vwma_val = ta.vwma(close, vwma_len)

// ===== ARMING LOGIC =====
var int armed_dir = 0
var int arm_start_bar = na

bool inside_poc = not na(poc_lo) and not na(poc_hi) and close >= poc_lo and close <= poc_hi

bool long_arm_cond = not na(poc_hi) and close > poc_hi and close > vwma_val and poc_delta_pct >= min_delta_pct
bool short_arm_cond = not na(poc_lo) and close < poc_lo and close < vwma_val and poc_delta_pct <= -min_delta_pct

if inside_poc
    armed_dir := 0
    arm_start_bar := na

// ===== PIVOT DETECTION =====
float ph_val = ta.pivothigh(high, pivot_len, pivot_len)
float pl_val = ta.pivotlow(low, pivot_len, pivot_len)

bool pivot_high_confirmed = not na(ph_val)
bool pivot_low_confirmed  = not na(pl_val)

float pivot_high_price = pivot_high_confirmed ? high[pivot_len] : na
float pivot_low_price  = pivot_low_confirmed ? low[pivot_len] : na

// ===== REVERSAL LOGIC =====
var bool reversal_active = false
var int reversal_dir = 0
var bool last_exit_was_stop = false
var int last_trade_dir = 0

bool position_closed = strategy.position_size == 0 and strategy.position_size[1] != 0

if position_closed
    bool was_long = strategy.position_size[1] > 0
    bool was_short = strategy.position_size[1] < 0
    last_trade_dir := was_long ? 1 : -1
    
    float entry_price_prev = strategy.position_avg_price[1]
    float stop_price_prev = was_long ? entry_price_prev - stop_dollars / pv : entry_price_prev + stop_dollars / pv
    
    bool hit_stop = was_long ? (low <= stop_price_prev) : (high >= stop_price_prev)
    
    last_exit_was_stop := hit_stop

    if use_reversal_after_stop and hit_stop
        reversal_active := true
        reversal_dir := -last_trade_dir
    else
        reversal_active := false
        reversal_dir := 0

if reversal_active
    if inside_poc or not in_session
        reversal_active := false
        reversal_dir := 0

// ===== ENTRY LOGIC =====
bool long_entry_sig = false
bool short_entry_sig = false

bool pivot_after_arm_long = false
if pivot_high_confirmed and not na(arm_start_bar)
    int pivot_bar = bar_index - pivot_len
    if pivot_bar >= arm_start_bar
        pivot_after_arm_long := true

bool pivot_after_arm_short = false
if pivot_low_confirmed and not na(arm_start_bar)
    int pivot_bar = bar_index - pivot_len
    if pivot_bar >= arm_start_bar
        pivot_after_arm_short := true

if armed_dir == 1 and pivot_high_confirmed and pivot_high_price > poc_hi and in_session and strategy.position_size == 0 and pivot_after_arm_long
    if reversal_active
        if reversal_dir == 1
            long_entry_sig := true
            reversal_active := false
            reversal_dir := 0
    else
        long_entry_sig := true

if armed_dir == -1 and pivot_low_confirmed and pivot_low_price < poc_lo and in_session and strategy.position_size == 0 and pivot_after_arm_short
    if reversal_active
        if reversal_dir == -1
            short_entry_sig := true
            reversal_active := false
            reversal_dir := 0
    else
        short_entry_sig := true

// ===== EXITS =====
long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
short_limit = close - tp_dollars / pv

if strategy.position_size > 0
    strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Backup Stop")

if strategy.position_size < 0
    strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Backup Stop")

if long_entry_sig
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)
    arm_start_bar := bar_index
    strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)

if short_entry_sig
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)
    arm_start_bar := bar_index
    strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)

// ===== SESSION END FLATTEN =====
if not in_session
    strategy.close_all(comment="Session")

bool is_1600 = hour(time, "America/New_York") == 16 and minute(time, "America/New_York") == 0
if is_1600 and strategy.position_size != 0
    strategy.close_all(comment="Session Close")

// ===== PLOTS =====
plot(vwma_val, "VWMA", color.blue, linewidth=2)

float plo  = not na(poc_lo) ? poc_lo : na
float ppoc = not na(poc_price) ? poc_price : na
float phi  = not na(poc_hi) ? poc_hi : na

plot_lo  = plot(plo, "POC Low", #2962FF, style=plot.style_stepline, linewidth=2)
plot_poc = plot(ppoc, "POC", color.yellow, style=plot.style_stepline, linewidth=1)
plot_hi  = plot(phi, "POC High", #2962FF, style=plot.style_stepline, linewidth=2)
fill(plot_lo, plot_hi, color.new(color.gray, 90))

plotshape(long_entry_sig, "Long Signal", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(short_entry_sig, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

plot(not na(poc_delta_pct) ? poc_delta_pct : na, "POC Delta %", color.orange, display=display.data_window)
