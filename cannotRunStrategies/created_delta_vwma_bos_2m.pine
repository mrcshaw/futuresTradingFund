//@version=5
// Built from: Engine4_DeltaVWMA_BOS_v1 (Delta Volume BOS), ta.vwma, ta.ema, ta.crossover, ta.crossunder
strategy("Delta VWMA BOS 2m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(100, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")

long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")

sess_start = time(timeframe.period, "1800-0000")
sess_end = time(timeframe.period, "0000-1600")
in_session = use_session ? (time >= sess_start and time < sess_end) : true

// ===== LOGIC =====
vwma_len = input.int(20, "VWMA Length", minval=5, maxval=100)
ema_len = input.int(50, "EMA Length", minval=10, maxval=200)
vol_ma_len = input.int(20, "Vol MA Length", minval=5, maxval=100)
cooldown_bars = input.int(5, "Cooldown Bars", minval=1, maxval=50)

v = ta.vwma(close, vwma_len)
e = ta.ema(close, ema_len)
vol_ma = ta.sma(volume, vol_ma_len)

long_sig = ta.crossover(v, e) and volume > vol_ma
short_sig = ta.crossunder(v, e) and volume > vol_ma

var int last_entry_bar = 0

if in_session and strategy.position_size == 0 and bar_index - last_entry_bar >= cooldown_bars
    if long_sig
        strategy.entry("Long", strategy.long)
        last_entry_bar := bar_index
    else if short_sig
        strategy.entry("Short", strategy.short)
        last_entry_bar := bar_index

if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)
else if strategy.position_size < 0
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)

if not in_session
    strategy.close_all(comment="Session")

if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
