//@version=5
// Built from: Delta Volume BOS Night Shift (cooldown, session timing) + Day Shift Delta Volume Breakout (slope filter), ta.ema, ta.rsi, ta.highest, ta.lowest, ta.change, ta.crossover, ta.crossunder, math.sum
strategy("EMA Slope RSI Volume Surge", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(50, "Point Value ($)")
stop_dollars = input.int(500, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(750, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")
cur_tm = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
start_tm = sess_start_hr * 60 + sess_start_mn
end_tm = sess_end_hr * 60 + sess_end_mn
in_session = use_session ? (start_tm < end_tm ? (cur_tm >= start_tm and cur_tm < end_tm) : (cur_tm >= start_tm or cur_tm < end_tm)) : true

// ===== STRATEGY PARAMS =====
ema_len = input.int(30, "EMA Length", minval=10, maxval=100)
rsi_len = input.int(14, "RSI Length", minval=7, maxval=30)
rsi_long_lvl = input.int(55, "RSI Long Level", minval=40, maxval=70)
rsi_short_lvl = input.int(45, "RSI Short Level", minval=30, maxval=60)
struct_lb = input.int(10, "Structure Lookback", minval=5, maxval=30)
vol_lb = input.int(20, "Volume Lookback", minval=5, maxval=50)
vol_mult = input.float(1.5, "Volume Multiplier", minval=1.0, maxval=3.0)
cooldown = input.int(12, "Cooldown Bars", minval=4, maxval=60)

// ===== INDICATORS =====
ema_val = ta.ema(close, ema_len)
ema_slope = ta.change(ema_val, 3)
rsi_val = ta.rsi(close, rsi_len)
avg_vol = math.sum(volume, vol_lb) / vol_lb
vol_ok = volume > avg_vol * vol_mult
hi_ref = ta.highest(high, struct_lb)[2]
lo_ref = ta.lowest(low, struct_lb)[2]

// ===== COOLDOWN =====
var int last_entry_bar = 0
cd_ok = bar_index - last_entry_bar >= cooldown

// ===== ENTRY LOGIC =====
long_sig = in_session and cd_ok and ema_slope > 0 and close > hi_ref and ta.crossover(rsi_val, rsi_long_lvl) and vol_ok
short_sig = in_session and cd_ok and ema_slope < 0 and close < lo_ref and ta.crossunder(rsi_val, rsi_short_lvl) and vol_ok

if long_sig
    strategy.entry("L", strategy.long)
    last_entry_bar := bar_index
if short_sig
    strategy.entry("S", strategy.short)
    last_entry_bar := bar_index

// ===== EXIT =====
if strategy.position_size > 0
    strategy.exit("XL", from_entry="L", stop=long_stop, limit=long_limit)
if strategy.position_size < 0
    strategy.exit("XS", from_entry="S", stop=long_stop, limit=long_limit)

// ===== OPEN P&L CHECK =====
if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
