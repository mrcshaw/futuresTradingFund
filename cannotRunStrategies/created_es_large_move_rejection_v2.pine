//@version=5
// Built from: Large Move Rejection ES.txt lesson, ta.highest, ta.lowest, ta.barssince
strategy("ES Large Move Rejection v2", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(50, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")

// ===== PATTERN INPUTS =====
impulse_ticks = input.int(250, "Impulse Ticks", minval=50, maxval=1000)
impulse_minutes = input.int(15, "Impulse Minutes", minval=5, maxval=60)
move_minutes = input.int(45, "Move Minutes", minval=15, maxval=120)
move_points = input.int(10, "Move Points", minval=5, maxval=50)
retest_points = input.int(3, "Retest Points", minval=1, maxval=20)
cooldown_bars = input.int(5, "Cooldown Bars", minval=1, maxval=50)
daily_profit_cap = input.int(1000, "Daily Profit Cap ($)", minval=500, maxval=5000)
daily_loss_cap = input.int(750, "Daily Loss Cap ($)", minval=500, maxval=5000)

// ===== SESSION LOGIC =====
in_session = false
if use_session
    h = hour(time, "America/New_York")
    m = minute(time, "America/New_York")
    if sess_start_hr < sess_end_hr
        in_session := (h > sess_start_hr or (h == sess_start_hr and m >= sess_start_mn)) and (h < sess_end_hr or (h == sess_end_hr and m < sess_end_mn))
    else
        in_session := (h > sess_start_hr or (h == sess_start_hr and m >= sess_start_mn)) or (h < sess_end_hr or (h == sess_end_hr and m < sess_end_mn))

// ===== STATE =====
var int last_flat_bar = na
var float session_pnl = 0.0
var int last_session_day = na

// Reset session PnL at new day
if ta.change(time("D")) != 0
    session_pnl := 0.0
    last_session_day := dayofmonth(time)

// Track realized PnL
if strategy.position_size == 0 and not na(strategy.closedtrades)
    if strategy.closedtrades > 0
        session_pnl += strategy.closedtrades

// Cooldown check
can_enter = true
if not na(last_flat_bar)
    can_enter := bar_index - last_flat_bar >= cooldown_bars

// Daily caps
if session_pnl >= daily_profit_cap or session_pnl <= -daily_loss_cap
    can_enter := false

// ===== PATTERN LOGIC =====
// Identify impulse: move > impulse_ticks within impulse_minutes
impulse_len = impulse_minutes * 12 // 5-min chart, 12 bars per hour
impulse_move = high - ta.lowest(low, impulse_len)
impulse_down = ta.highest(high, impulse_len) - low

// Identify move completion: extreme within move_minutes after impulse
move_len = move_minutes * 12
recent_high = ta.highest(high, move_len)
recent_low = ta.lowest(low, move_len)

// Short setup: Impulse up, then retest high and close down
short_signal = false
if impulse_move > impulse_ticks and high == recent_high
    retest_dist = recent_high - low
    if retest_dist <= retest_points * pv and close < open
        short_signal := true

// Buy setup: Impulse down, then retest low and close up
buy_signal = false
if impulse_down > impulse_ticks and low == recent_low
    retest_dist = high - recent_low
    if retest_dist <= retest_points * pv and close > open
        buy_signal := true

// ===== ENTRIES =====
if in_session and can_enter and short_signal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=short_stop, limit=short_limit)
    last_session_day := bar_index
    last_flat_bar := bar_index

if in_session and can_enter and buy_signal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=long_stop, limit=long_limit)
    last_session_day := bar_index
    last_flat_bar := bar_index

// ===== EXITS =====
if strategy.position_size > 0
    long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
    long_limit = close + tp_dollars / pv
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")

if strategy.position_size < 0
    short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
    short_limit = close - tp_dollars / pv
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
    last_flat_bar := bar_index
