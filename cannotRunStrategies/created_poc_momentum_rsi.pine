//@version=5
// Built from: POC Pullback Momentum v2, RSI 3system v2. Indicators: ta.ema, ta.rsi, ta.atr, ta.crossover, ta.crossunder.
strategy("POC Momentum RSI", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv                = input.float(50, "Point Value ($)")
stop_dollars      = input.int(250, "Stop ($)", minval=250, maxval=750)
tp_dollars        = input.int(500, "Take Profit ($)", minval=250)
use_trail         = input.bool(false, "Enable Trailing Stop")
trail_pct         = input.float(50, "Trail keep (%)", minval=0, maxval=100)
trail_step_amt    = input.int(500, "Trail: Tighten every ($)", minval=0, maxval=2000)
trail_step_pct    = input.float(50, "Trail step (%)", minval=0, maxval=100)
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)", minval=0, maxval=2000)
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
if strategy.position_size != 0 and not na(stop_dollars)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION =====
use_session   = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0,  "Session Start Minute")
sess_end_hr   = input.int(16,  "Session End Hour (ET)")
sess_end_mn   = input.int(0,  "Session End Minute")
sess_bar_hr = hour(time, "America/New_York")
sess_bar_mn = minute(time, "America/New_York")
sess_bar_t = sess_bar_hr * 100 + sess_bar_mn
sess_clock_start = sess_start_hr * 100 + sess_start_mn
sess_clock_end = sess_end_hr * 100 + sess_end_mn
in_session = not use_session or (sess_clock_start > sess_clock_end ? (sess_bar_t >= sess_clock_start or sess_bar_t < sess_clock_end) : (sess_bar_t >= sess_clock_start and sess_bar_t < sess_clock_end))
if not in_session
    strategy.close_all(comment="Session")

// === INPUTS ===
lookback = input.int(20, "Lookback", minval=10, maxval=100)
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)
atrLen = input.int(14, "ATR Length", minval=5, maxval=50)

// === RISK CALCULATIONS ===

// === INDICATORS ===
rsi = ta.rsi(close, rsiLen)
emaFast = ta.ema(close, 9)
emaSlow = ta.ema(close, 21)
atr = ta.atr(atrLen)

// Momentum: Price relative to EMA slope and RSI position
// Condition 1: Trend Filter (Fast EMA > Slow EMA)
trendUp = ta.crossover(emaFast, emaSlow) or (emaFast > emaSlow and ta.rising(emaFast, 3))
trendDown = ta.crossunder(emaFast, emaSlow) or (emaFast < emaSlow and ta.falling(emaFast, 3))

// Condition 2: RSI Momentum Filter
// Long: RSI crosses above 40 (oversold bounce) or RSI > 50 and rising
// Short: RSI crosses below 60 (overbought drop) or RSI < 50 and falling
rsiCrossUp = ta.crossover(rsi, 40)
rsiCrossDown = ta.crossunder(rsi, 60)

// === SESSION CHECK ===
// Guideline 1: Flatten at 16:45 NY. Enter only during session.

// === EXECUTION ===
// Cooldown mechanism to avoid overtrading
var int lastEntryBar = -100
cooldownBars = 2
barsSinceEntry = bar_index - lastEntryBar

// Long Entry
if in_session and trendUp and rsiCrossUp and barsSinceEntry > cooldownBars
    stopPrice = close - stop_dollars / pv
    tpPrice = close + tp_dollars / pv
    strategy.entry("Long", strategy.long)
    strategy.exit("Long", "Long", stop=long_stop, limit=long_limit)
    lastEntryBar := bar_index

// Short Entry
if in_session and trendDown and rsiCrossDown and barsSinceEntry > cooldownBars
    stopPrice = close + stop_dollars / pv
    tpPrice = close - tp_dollars / pv
    strategy.entry("Short", strategy.short)
    strategy.exit("Short", "Short", stop=short_stop, limit=short_limit)
    lastEntryBar := bar_index

// === SESSION END FLATTEN ===
// Guideline 1: Must flatten every open trade at 16:45 NY
