//@version=5
// Built from: POC Color + Pullback card (profile_lookback 66 to 63), ta.rsi, ta.ema, ta.atr
strategy("VWMA RSI Pullback 15m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(50, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")

long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
short_limit = close - tp_dollars / pv

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")

in_session = false
if use_session
    t = time(timeframe.period, "0000-2359")
    start_t = time(timeframe.period, str.tostring(sess_start_hr) + str.tostring(sess_start_mn))
    end_t = time(timeframe.period, str.tostring(sess_end_hr) + str.tostring(sess_end_mn))
    if sess_start_hr > sess_end_hr
        in_session := t >= start_t or t < end_t
    else
        in_session := t >= start_t and t < end_t

// ===== INDICATORS =====
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)
ema_len = input.int(20, "EMA Length", minval=10, maxval=50)
cooldown_bars = input.int(5, "Cooldown Bars", minval=1, maxval=20)

rsi_val = ta.rsi(close, rsi_len)
ema_val = ta.ema(close, ema_len)

var int last_entry_bar = 0
can_trade = bar_index - last_entry_bar >= cooldown_bars

// ===== LOGIC =====
long_condition = in_session and can_trade and close > ema_val and rsi_val < 30
short_condition = in_session and can_trade and close < ema_val and rsi_val > 70

if long_condition
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=long_stop, limit=long_limit)
    last_entry_bar := bar_index

if short_condition
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=short_stop, limit=short_limit)
    last_entry_bar := bar_index

if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)

if strategy.position_size < 0
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)

if not in_session
    strategy.close_all(comment="Session")

if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
