//@version=5
// Built from: Delta Volume BOS Night Shift (vwma + volume delta), POC RSI Reversal (RSI trigger). Indicators: ta.vwma, ta.rsi, ta.ema, math.sum
strategy("VWMA RSI Volume Shift", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(50, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")

// ===== INDICATORS =====
vwma_len = input.int(20, "VWMA Length", minval=5, maxval=100)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=50)
rsi_long = input.int(35, "RSI Long Level", minval=20, maxval=50)
rsi_short = input.int(65, "RSI Short Level", minval=50, maxval=80)
vol_ma_len = input.int(20, "Volume MA Length", minval=5, maxval=100)
vol_mult = input.float(1.2, "Volume Multiplier", minval=1.0, maxval=3.0)
ema_len = input.int(50, "EMA Length", minval=10, maxval=200)
cooldown_bars = input.int(5, "Cooldown Bars", minval=1, maxval=50)

// ===== SESSION LOGIC =====
t = time(timeframe.period, "America/New_York")
cur_hm = hour(t) * 100 + minute(t)
start_hm = sess_start_hr * 100 + sess_start_mn
end_hm = sess_end_hr * 100 + sess_end_mn
in_session = use_session ? (start_hm > end_hm ? (cur_hm >= start_hm or cur_hm < end_hm) : (cur_hm >= start_hm and cur_hm < end_hm)) : true

// ===== INDICATOR VALUES =====
v = ta.vwma(close, vwma_len)
r = ta.rsi(close, rsi_len)
e = ta.ema(close, ema_len)
avg_vol = math.sum(volume, vol_ma_len) / vol_ma_len
vol_ok = volume > avg_vol * vol_mult

// ===== COOLDOWN =====
var int last_entry_bar = -9999
cd_ok = bar_index - last_entry_bar >= cooldown_bars

// ===== ENTRY CONDITIONS =====
long_sig = close > v and close > e and ta.crossover(r, rsi_long) and vol_ok and cd_ok and in_session
short_sig = close < v and close < e and ta.crossunder(r, rsi_short) and vol_ok and cd_ok and in_session

// ===== EXECUTION =====
if long_sig and strategy.position_size == 0
    strategy.entry("L", strategy.long)
    last_entry_bar := bar_index
if short_sig and strategy.position_size == 0
    strategy.entry("S", strategy.short)
    last_entry_bar := bar_index

// ===== EXITS =====
if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=long_stop, limit=long_limit)
if strategy.position_size < 0
    strategy.exit("SX", from_entry="S", stop=long_stop, limit=long_limit)

// ===== OPEN P&L CHECK =====
if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
