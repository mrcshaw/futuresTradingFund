//@version=5
// How this script works
// The script identifies a 5-candle range. It enters on a breakout of this range in the direction of the 5th candle's color.
// Crucially, it adds a momentum filter: the entry is only taken if the price is moving in the direction of the trade relative to a short-term moving average (EMA 20).
// This filters out breakouts that are likely to fail or reverse immediately, aiming to improve the win rate and profit factor.
// The stop and take profit remain fixed dollar amounts.

strategy("5-Candle Breakout v2", overlay=true,
  initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=5.50,
  slippage=3, pyramiding=0, process_orders_on_close=false, calc_on_every_tick=true)
// ===== RISK =====
pv                = input.float(50, "Point Value ($)")
stop_dollars      = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars        = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail         = input.bool(false, "Enable Trailing Stop")
trail_pct         = input.float(50, "Trail keep (%)", minval=0, maxval=100)
trail_step_amt    = input.int(500, "Trail: Tighten every ($)", minval=0, maxval=2000)
trail_step_pct    = input.float(50, "Trail step (%)", minval=0, maxval=100)
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)", minval=0, maxval=2000)
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
if strategy.position_size != 0 and not na(stop_dollars)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")
// ===== SESSION =====
use_session   = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0,  "Session Start Minute")
sess_end_hr   = input.int(16,  "Session End Hour (ET)")
sess_end_mn   = input.int(0,  "Session End Minute")
sess_bar_hr = hour(time, "America/New_York")
sess_bar_mn = minute(time, "America/New_York")
sess_bar_t = sess_bar_hr * 100 + sess_bar_mn
sess_clock_start = sess_start_hr * 100 + sess_start_mn
sess_clock_end = sess_end_hr * 100 + sess_end_mn
in_session = not use_session or (sess_clock_start > sess_clock_end ? (sess_bar_t >= sess_clock_start or sess_bar_t < sess_clock_end) : (sess_bar_t >= sess_clock_start and sess_bar_t < sess_clock_end))
if not in_session
    strategy.close_all(comment="Session")


// ===== INPUTS =====
set_size         = input.int(5, "Candles Per Set", minval=2)
watch_bars       = input.int(4, "Max Bars to Wait for Breakout", minval=1)
doji_threshold   = input.float(0.75, "Doji Threshold (pts)", tooltip="If |close - open| <= this, candle is a doji.")
ema_len          = input.int(20, "Momentum EMA Length", minval=5)

// ===== SESSIONS =====
use_ny_sess      = input.bool(true, "Use NY Session")
ny_start_hr      = input.int(9, "NY Start Hour")
ny_start_mn      = input.int(30, "NY Start Minute")
ny_end_hr        = input.int(16, "NY End Hour")
ny_end_mn        = input.int(0, "NY End Minute")

// ===== STATE VARIABLES =====
int phase = 0
int gather_count = 0
int watch_count = 0
int signal_dir = 0
float set_high = na
float set_low = na
float entry_price = na
float long_stop = na
float long_limit = na
float short_stop = na
float short_limit = na

// ===== MOMENTUM INDICATOR =====
ema_val = ta.ema(close, ema_len)

// ===== SESSION LOGIC =====
inSession = false
if use_ny_sess
    inSession = time("1", "0930-1600", "America/New_York")
    
// Flatten at 16:45 NY
if strategy.position_size != 0 and time("1", "1645-1646", "America/New_York")
    strategy.close_all(comment="EOD Flatten")

// ===== LOGIC =====

// Phase 0: Gathering
if phase == 0
    if strategy.position_size == 0
        gather_count += 1
        if gather_count == 1
            set_high := high
            set_low := low
        else
            set_high := math.max(set_high, high)
            set_low := math.min(set_low, low)
        
        if gather_count == set_size
            // Check Doji on the last candle of the set
            body = math.abs(close - open)
            if body > doji_threshold
                signal_dir := close > open ? 1 : -1
                phase := 1
                watch_count := 0
            else
                signal_dir := 0
                phase := 1
                watch_count := 0
                // If doji, we skip this set. We effectively restart gathering immediately? 
                // The original script says "doji to skip". Usually implies waiting for next set.
                // Let's reset to start a new set immediately if doji.
                gather_count := 0
                set_high := na
                set_low := na
                phase := 0

// Phase 1: Watching for Breakout
if phase == 1
    if strategy.position_size == 0
        watch_count += 1
        
        // Check Breakout
        bool longBreak = close > set_high
        bool shortBreak = close < set_low
        
        // Momentum Filter: 
        // Long: Price must be above EMA (uptrend)
        // Short: Price must be below EMA (downtrend)
        bool longMomentum = close > ema_val
        bool shortMomentum = close < ema_val
        
        if longBreak and signal_dir == 1 and longMomentum and inSession
            // Enter Long
            if in_session
                strategy.entry("Long", strategy.long)
            entry_price := close
            long_stop := close - (stop_dollars / pv)
            long_limit := close + (tp_dollars / pv)
            strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)
            phase := 2
            
        else if shortBreak and signal_dir == -1 and shortMomentum and inSession
            // Enter Short
            if in_session
                strategy.entry("Short", strategy.short)
            entry_price := close
            short_stop := close + (stop_dollars / pv)
            short_limit := close - (tp_dollars / pv)
            strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)
            phase := 2
            
        // Timeout or No Breakout
        if watch_count >= watch_bars and strategy.position_size == 0
            // Reset to gather new set
            phase := 0
            gather_count := 0
            set_high := na
            set_low := na
            signal_dir := 0

// Phase 2: In Trade
if phase == 2
    if strategy.position_size == 0
        // Trade closed, reset to gather
        phase := 0
        gather_count := 0
        set_high := na
        set_low := na
        signal_dir := 0

// ===== VISUALS =====
plot(not na(set_high) and strategy.position_size == 0 ? set_high : na, "Set High", color.blue, style=plot.style_stepline)
plot(not na(set_low) and strategy.position_size == 0 ? set_low : na, "Set Low", color.blue, style=plot.style_stepline)
plot(ema_val, "EMA", color.orange)
