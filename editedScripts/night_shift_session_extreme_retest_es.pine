//@version=5
strategy("Night Shift Session High/Low Retest ES", overlay=true,
  initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=5.50,
  slippage=1, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false,
  max_bars_back=5000)

// The evening session opens at 18:00 ET. The session high and low are tracked from that bar.
// Short: price makes the session high, pulls away by at least the pullback, comes back into the
//        zone under the session high without breaking it, and a bar closes down with RSI falling:
//        the retest lacks momentum, so it is sold.
// Long:  the mirror at the session low.

// ===== SESSION — Night 18:00–8:00 ET =====
use_session   = input.bool(true, "Use Session Filter", group="Session")
sess_start_hr = input.int(18, "Session Start Hour (ET)", group="Session")
sess_start_mn = input.int(0,  "Session Start Minute", group="Session")
sess_end_hr   = input.int(8,  "Session End Hour (ET)", group="Session")
sess_end_mn   = input.int(0,  "Session End Minute", group="Session")
wait_bars     = input.int(6, "Bars to wait after the open", minval=0, maxval=200, group="Session", tooltip="No trade until the session high and low have had this many bars to form.")

// ===== RETEST =====
zone_pts      = input.float(3.0, "Retest Zone (pts)", minval=0.25, step=0.25, group="Retest", tooltip="Price must come back within this many points of the session high (short) or low (long).")
pullback_pts  = input.float(8.0, "Min Pullback Before Retest (pts)", minval=0.25, step=0.25, group="Retest", tooltip="Price must first move this far away from the high/low.")
sweep_pts     = input.float(1.0, "Allowed Poke Through (pts)", minval=0.0, step=0.25, group="Retest", tooltip="A wick this far past the high/low still counts as a retest. Further than this makes a new high/low and resets the setup.")
confirm_bars  = input.int(3, "Bars to Confirm After Touch", minval=1, maxval=20, group="Retest", tooltip="The rejection bar must close within this many bars of touching the zone.")
rsi_len       = input.int(14, "RSI Length", minval=2, group="Momentum")
rsi_short_max = input.float(65.0, "Short: RSI Below", minval=1, maxval=100, group="Momentum")
rsi_long_min  = input.float(35.0, "Long: RSI Above", minval=0, maxval=99, group="Momentum")
max_trades    = input.int(2, "Max Trades a Session", minval=1, maxval=20, group="Retest")
cooldown_bars = input.int(5, "Cooldown (bars)", minval=0, maxval=100, step=1, group="Retest")

// ===== RISK =====
pv           = input.float(50.0, "Point Value ($)")
stop_dollars = input.float(300.0, "Stop ($)")
tp_dollars   = input.float(750.0, "Take Profit ($)")
use_trail    = input.bool(true, "Enable Trailing Stop", group="Trailing")
trail_pct    = input.float(45.0, "Trail: Keep % of Peak Profit", minval=10, maxval=90, group="Trailing")
trail_step_amt = input.float(500.0, "Trail: Tighten every $X profit", minval=100, group="Trailing")
trail_step_pct = input.float(15.0, "Trail: Tighten by X% per step", minval=1, maxval=20, group="Trailing")
trail_min_dollars = input.float(500.0, "Trail: Min Profit Before Trailing ($)", minval=50, group="Trailing")
use_breakeven = input.bool(false, "Enable Breakeven", group="Breakeven")
be_trigger_dollars = input.float(150.0, "BE Trigger ($)", minval=50, group="Breakeven")

float stop_pts = stop_dollars / pv
float tp_pts   = tp_dollars / pv
float be_trigger_pts = be_trigger_dollars / pv

// ===== SESSION LOGIC =====
bar_t  = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")
prev_t = hour(time[1], "America/New_York") * 100 + minute(time[1], "America/New_York")
int s_start = sess_start_hr * 100 + sess_start_mn
int s_end   = sess_end_hr * 100 + sess_end_mn
bool in_session     = not use_session or (s_start > s_end ? (bar_t >= s_start or bar_t < s_end) : (bar_t >= s_start and bar_t < s_end))
bool was_in_session = not use_session or (s_start > s_end ? (prev_t >= s_start or prev_t < s_end) : (prev_t >= s_start and prev_t < s_end))
bool session_ended  = was_in_session and not in_session
// The first bar of the evening: the clock reaches the start, or the session filter is off and the 18:00 ET day begins.
bool session_open   = use_session ? (in_session and not was_in_session) : (bar_t >= 1800 and prev_t < 1800)

if session_ended and strategy.position_size != 0
    strategy.close_all(comment="Session Close")

// ===== SESSION HIGH / LOW =====
var float sess_hi = na
var float sess_lo = na
var int   sess_bar = 0
var int   sess_trades = 0
var bool  short_armed = false
var bool  long_armed  = false
var int   short_touch_bar = -9999
var int   long_touch_bar  = -9999

if session_open
    sess_hi := high
    sess_lo := low
    sess_bar := bar_index
    sess_trades := 0
    short_armed := false
    long_armed := false
    short_touch_bar := -9999
    long_touch_bar := -9999
else if in_session and not na(sess_hi)
    // A move past the poke-through allowance is a new high or low, and the setup on that side starts over.
    if high > sess_hi + sweep_pts
        sess_hi := high
        short_armed := false
        short_touch_bar := -9999
    if low < sess_lo - sweep_pts
        sess_lo := low
        long_armed := false
        long_touch_bar := -9999

// Price has pulled away from the extreme.
if in_session and not na(sess_hi)
    if not short_armed and low <= sess_hi - pullback_pts
        short_armed := true
    if not long_armed and high >= sess_lo + pullback_pts
        long_armed := true

// Price comes back into the zone after the pullback.
if short_armed and high >= sess_hi - zone_pts and high <= sess_hi + sweep_pts
    short_touch_bar := bar_index
if long_armed and low <= sess_lo + zone_pts and low >= sess_lo - sweep_pts
    long_touch_bar := bar_index

// ===== MOMENTUM =====
float rsi = ta.rsi(close, rsi_len)
bool short_reject = close < open and close < sess_hi - zone_pts * 0.5 and rsi < rsi[1] and rsi < rsi_short_max
bool long_reject  = close > open and close > sess_lo + zone_pts * 0.5 and rsi > rsi[1] and rsi > rsi_long_min

// ===== SIGNALS =====
var int last_trade_bar = -9999
bool cooled_down = bar_index - last_trade_bar >= cooldown_bars
bool formed      = not na(sess_hi) and bar_index - sess_bar >= wait_bars
bool can_trade   = in_session and formed and cooled_down and sess_trades < max_trades and strategy.position_size == 0

bool short_sig = can_trade and short_armed and bar_index - short_touch_bar <= confirm_bars and short_reject
bool long_sig  = can_trade and long_armed and bar_index - long_touch_bar <= confirm_bars and long_reject and not short_sig

// ===== ENTRIES =====
var float current_stop    = 0.0
var float entry_price     = 0.0
var float peak_profit_pts = 0.0
var bool  be_active       = false

if long_sig
    current_stop    := close - stop_pts
    entry_price     := close
    peak_profit_pts := 0.0
    be_active       := false
    last_trade_bar  := bar_index
    sess_trades     += 1
    long_armed      := false
    long_touch_bar  := -9999
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=current_stop, limit=close + tp_pts)
else if short_sig
    current_stop    := close + stop_pts
    entry_price     := close
    peak_profit_pts := 0.0
    be_active       := false
    last_trade_bar  := bar_index
    sess_trades     += 1
    short_armed     := false
    short_touch_bar := -9999
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", stop=current_stop, limit=close - tp_pts)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    be_active       := false
    peak_profit_pts := 0.0

if use_breakeven and strategy.position_size != 0 and not be_active
    if strategy.position_size > 0
        if close - entry_price >= be_trigger_pts
            be_active    := true
            current_stop := entry_price + 0.25
            strategy.exit("XL", "Long", stop=current_stop, limit=entry_price + tp_pts)
    else if strategy.position_size < 0
        if entry_price - close >= be_trigger_pts
            be_active    := true
            current_stop := entry_price - 0.25
            strategy.exit("XS", "Short", stop=current_stop, limit=entry_price - tp_pts)

// ===== TRAILING STOP =====
if use_trail and strategy.position_size != 0
    if strategy.position_size > 0
        float avg        = strategy.position_avg_price
        float profit_now = high - avg
        if profit_now > peak_profit_pts
            peak_profit_pts := profit_now
        if peak_profit_pts >= trail_min_dollars / pv
            float peak_dollars = peak_profit_pts * pv
            int   steps        = math.floor(peak_dollars / trail_step_amt)
            float keep_pct     = math.min(trail_pct + steps * trail_step_pct, 95.0)
            float new_stop     = avg + peak_profit_pts * (keep_pct / 100.0)
            if new_stop > current_stop
                current_stop := new_stop
                strategy.exit("XL", "Long", stop=current_stop, limit=avg + tp_pts)
    else if strategy.position_size < 0
        float avg        = strategy.position_avg_price
        float profit_now = avg - low
        if profit_now > peak_profit_pts
            peak_profit_pts := profit_now
        if peak_profit_pts >= trail_min_dollars / pv
            float peak_dollars = peak_profit_pts * pv
            int   steps        = math.floor(peak_dollars / trail_step_amt)
            float keep_pct     = math.min(trail_pct + steps * trail_step_pct, 95.0)
            float new_stop     = avg - peak_profit_pts * (keep_pct / 100.0)
            if new_stop < current_stop
                current_stop := new_stop
                strategy.exit("XS", "Short", stop=current_stop, limit=avg - tp_pts)

// ===== PLOT =====
plot(in_session ? sess_hi : na, "Session High", color.blue, style=plot.style_linebr, linewidth=2)
plot(in_session ? sess_lo : na, "Session Low", color.blue, style=plot.style_linebr, linewidth=2)
plot(in_session and short_armed ? sess_hi - zone_pts : na, "Short Zone", color.new(color.red, 50), style=plot.style_linebr)
plot(in_session and long_armed ? sess_lo + zone_pts : na, "Long Zone", color.new(color.lime, 50), style=plot.style_linebr)
plot(strategy.position_size != 0 ? current_stop : na, "Stop", color.fuchsia, style=plot.style_stepline, linewidth=2)
plotshape(short_sig, "Short", shape.triangledown, location.abovebar, color.yellow, size=size.small)
plotshape(long_sig, "Long", shape.triangleup, location.belowbar, color.yellow, size=size.small)
