//@version=5
strategy("Delta Volume BOS Night Shift (use_breakeven=False)", overlay=true, default_qty_type=strategy.cash, default_qty_value=10000, commission_type=strategy.commission.percent, commission_value=0.1)

// Parameters
use_breakeven = false
takeprofit = 750

// Volume breakout condition (simplified example)
volBreakout = volume > 2 * ta.sma(volume, 20)

// Entry logic
if volBreakout
    strategy.entry("Long", strategy.long)

// Exit logic
if close > strategy.position_avg_price + takeprofit
    strategy.close("Long")

// Strategy settings
strategy.option = strategy.option.none
strategy.entry("Long", strategy.long, when=volBreakout)
strategy.exit("Take Profit", "Long", profit=takeprofit, loss=0, comment="Take Profit")
