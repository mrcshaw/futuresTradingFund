//@version=5
strategy("POC Confluence (ema_len=97)", overlay=true, default_qty_type=strategy.cash, default_qty_value=10000, commission_type=strategy.commission.percent, commission_value=0.1)

// Parameters
ema_len = 97
takeprofit = 1100

// EMA calculation for volume breakout
emaVolume = ta.ema(volume, ema_len)
volBreakout = volume > 2 * emaVolume

// Entry logic
if volBreakout
    strategy.entry("Long", strategy.long)

// Exit logic
if close > strategy.position_avg_price + takeprofit
    strategy.close("Long")

// Strategy settings
strategy.option = strategy.option.none
strategy.entry("Long", strategy.long, when=volBreakout)
strategy.exit("Take Profit", "Long", profit=takeprofit, loss=0, comment="Fixed Take Profit")
