//@version=5
strategy("Day Shift Delta Volume Breakout colored Back ground Good Copy Redesign 1", overlay=true,
  initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=5.50,
  slippage=1, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false,
  max_bars_back=5000, max_boxes_count=500)

// ===== RISK =====
pv                = input.float(5, "Point Value ($)")
stop_dollars      = input.int(250, "Stop ($)", minval=250, maxval=700)
tp_dollars        = input.int(500, "Take Profit ($)", minval=250)

// Risk validation: TP must be > Stop
bool risk_valid = tp_dollars > stop_dollars

long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
short_limit = close - tp_dollars / pv

// Fix short_stop calculation (cannot reference itself)
short_stop_calc = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv

if strategy.position_size != 0 and risk_valid
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")

// ===== VOLUME PROFILE =====
profile_lookback = input.int(120, "Profile Lookback (bars)", minval=20, maxval=2000, step=10)
profile_rows     = input.int(10, "Price Levels (rows)", minval=5, maxval=100, step=5, tooltip="More rows = finer resolution but slower.")

// ===== DELTA VOLUME =====
min_delta_pct = input.float(3.0, "Min Delta Imbalance (%)", minval=0, maxval=80, step=5, tooltip="Net delta at POC must exceed this % of total POC volume to confirm direction. 0 = disabled.")

// ===== TREND FILTER =====
vwma_len       = input.int(50, "Trend VWMA Length", minval=1)
vwma_slope_len = input.int(5, "VWMA Slope Lookback (bars)", minval=1)
min_slope      = input.float(2.0, "Min VWMA Slope (pts)", minval=0.0, tooltip="0 = disabled.")

// ===== ENTRY PARAMETERS =====
pivot_len            = input.int(5, "Pivot Length", minval=2, maxval=20)
pivot_wait_bars      = input.int(20, "Pivot Wait Bars (Arm Expiry)", minval=1, maxval=200)
cooldown_bars        = input.int(10, "Cooldown (bars)", minval=0, maxval=100, step=1)
use_reversal         = input.bool(true, "Enable Reversal")
reversal_cooldown_bars = input.int(5, "Reversal Cooldown (bars)", minval=0, maxval=100)

// ===== COMPUTED =====
float stop_pts = stop_dollars / pv
float tp_pts   = tp_dollars / pv

// ===== SESSION LOGIC =====
// Fixed Session: 18:00 to 16:00 New York
bar_hr = hour(time, "America/New_York")
bar_mn = minute(time, "America/New_York")
bar_t  = bar_hr * 100 + bar_mn

int sess_start = 1800
int sess_end   = 1600

bool in_session = (sess_start > sess_end) ? (bar_t >= sess_start or bar_t < sess_end) : (bar_t >= sess_start and bar_t < sess_end)

prev_hr = hour(time[1], "America/New_York")
prev_mn = minute(time[1], "America/New_York")
prev_t  = prev_hr * 100 + prev_mn
bool was_in_session = (sess_start > sess_end) ? (prev_t >= sess_start or prev_t < sess_end) : (prev_t >= sess_start and prev_t < sess_end)

bool session_ended = was_in_session and not in_session

if session_ended and strategy.position_size != 0
    strategy.close_all(comment="Session Close")

// ===== VWMA TREND =====
float vwma_val   = ta.vwma(close, vwma_len)
float vwma_slope = vwma_val - vwma_val[vwma_slope_len]
bool  vwma_up    = min_slope <= 0 or vwma_slope > min_slope
bool  vwma_dn    = min_slope <= 0 or vwma_slope < -min_slope

// ===== VOLUME PROFILE WITH DELTA =====
int lb   = math.min(profile_lookback, bar_index)
int rows = profile_rows

float prof_hi   = ta.highest(high, lb > 0 ? lb : 1)
float prof_lo   = ta.lowest(low, lb > 0 ? lb : 1)
float prof_span = prof_hi - prof_lo
float step_size = prof_span > 0 ? prof_span / rows : na

var array<float> vol_total = array.new_float(100, 0.0)
var array<float> vol_up    = array.new_float(100, 0.0)
var array<float> vol_dn    = array.new_float(100, 0.0)

float poc_price = na
float poc_hi    = na
float poc_lo    = na
float poc_delta_pct = na
int   poc_row   = 0

if not na(step_size) and prof_span > 0 and lb > 1
    for a = 0 to 2
        arr = a == 0 ? vol_total : a == 1 ? vol_up : vol_dn
        if arr.size() != rows
            arr.clear()
            for i = 0 to rows - 1
                arr.push(0.0)
        else
            for i = 0 to rows - 1
                arr.set(i, 0.0)

    for iBar = 0 to lb - 1
        float bar_vol = volume[iBar]
        if bar_vol <= 0
            continue

        float bar_lo  = low[iBar]
        float bar_hi  = high[iBar]
        bool  bar_up  = close[iBar] >= open[iBar]

        int s_row = math.max(math.floor((bar_lo - prof_lo) / step_size), 0)
        int e_row = math.min(math.floor((bar_hi - prof_lo) / step_size), rows - 1)
        int span  = e_row - s_row + 1

        if span <= 0
            continue

        float per_row = bar_vol / span
        for k = 0 to span - 1
            int r = s_row + k
            if r >= 0 and r < rows
                vol_total.set(r, vol_total.get(r) + per_row)
                if bar_up
                    vol_up.set(r, vol_up.get(r) + per_row)
                else
                    vol_dn.set(r, vol_dn.get(r) + per_row)

    // Find POC
    float max_vol = 0.0
    for r = 0 to rows - 1
        float v = vol_total.get(r)
        if v > max_vol
            max_vol := v
            poc_row := r

    poc_price := prof_lo + (poc_row + 0.5) * step_size
    poc_lo    := prof_lo + poc_row * step_size
    poc_hi    := prof_lo + (poc_row + 1) * step_size

    // Delta at POC
    float poc_up  = vol_up.get(poc_row)
    float poc_dn  = vol_dn.get(poc_row)
    float poc_tot = vol_total.get(poc_row)
    poc_delta_pct := poc_tot > 0 ? ((poc_up - poc_dn) / poc_tot) * 100 : 0.0

// ===== ARM LOGIC =====
// Arm Long: Close crosses above POC High + VWMA Up + Delta Bull
// Arm Short: Close crosses below POC Low + VWMA Down + Delta Bear

bool cross_above_poc = not na(poc_hi) and close > poc_hi and close[1] <= poc_hi
bool cross_below_poc = not na(poc_lo) and close < poc_lo and close[1] >= poc_lo

bool delta_bull = not na(poc_delta_pct) and poc_delta_pct > 0 and (min_delta_pct <= 0 or poc_delta_pct > min_delta_pct)
bool delta_bear = not na(poc_delta_pct) and poc_delta_pct < 0 and (min_delta_pct <= 0 or poc_delta_pct < -min_delta_pct)

bool in_poc_zone = not na(poc_lo) and not na(poc_hi) and close >= poc_lo and close <= poc_hi

var int armed_dir     = 0 // 1: Long, -1: Short, 0: None
var int arm_start_bar = 0

// Update Arm State
if cross_above_poc and vwma_up and delta_bull and armed_dir != 1
    armed_dir     := 1
    arm_start_bar := bar_index
else if cross_below_poc and vwma_dn and delta_bear and armed_dir != -1
    armed_dir     := -1
    arm_start_bar := bar_index

// Disarm if price returns inside POC or wait expires
if armed_dir != 0
    bool expired = bar_index - arm_start_bar >= pivot_wait_bars
    if in_poc_zone or expired
        armed_dir := 0

// ===== PIVOT CONFIRMATION =====
// Fractal Pivot Low: Low is lower than pivot_len bars on both sides
// Fractal Pivot High: High is higher than pivot_len bars on both sides

bool pivot_low_confirmed = false
bool pivot_high_confirmed = false

if bar_index > pivot_len
    float current_low = low[pivot_len]
    float current_high = high[pivot_len]
    
    bool is_low_pivot = true
    bool is_high_pivot = true
    
    for i = 1 to pivot_len
        if low[pivot_len + i] <= current_low or low[pivot_len - i] <= current_low
            is_low_pivot := false
        if high[pivot_len + i] >= current_high or high[pivot_len - i] >= current_high
            is_high_pivot := false
            
    // Pivot is confirmed at bar_index - pivot_len, but we act on the current bar if the pivot was just confirmed in the past?
    // Standard fractal: The pivot is at bar_index - pivot_len. We know it's a pivot now.
    // We enter on the *current* bar if the condition holds? Or do we enter when the pivot is formed?
    // Plan: "Enter only on a confirmed pivot low... At entry, the VWMA trend and POC delta must still align".
    // Usually, you enter on the bar where the pivot is confirmed (which is pivot_len bars after the pivot point).
    // Let's assume the signal generates on the bar where the pivot is confirmed (current bar).
    
    if is_low_pivot
        pivot_low_confirmed := true
    if is_high_pivot
        pivot_high_confirmed := true

// ===== ENTRY LOGIC =====

var int last_trade_bar = -9999
var bool last_trade_was_stop = false
var int last_exit_bar = -9999

// Check if last trade closed at stop
if strategy.closedtrades > 0
    int last_trade_id = strategy.closedtrades - 1
    // We need to check if the exit reason was stop. 
    // Pine doesn't easily expose "exit reason" directly in a simple bool for the last trade without complex logic.
    // However, we can track if the position was closed by the stop price.
    // Alternative: Track if the trade hit the stop.
    // For simplicity and robustness in this script structure, we will track if the previous position was closed by a stop loss.
    // We can infer this if the exit price is close to the stop price, or we can just use a flag set when the stop is hit.
    // Let's use a flag: `hit_stop`
    
    // Actually, `strategy.closedtrades.profit(i)` is available. 
    // To detect stop loss specifically: 
    // We can check if the exit price matches the stop price roughly.
    // Or, we can just rely on the "Reversal" logic being triggered if the previous trade was a loss? 
    // Plan says: "if a trade closes at the stop".
    // Let's track a variable `last_exit_was_stop`.
    
    // We will set `last_exit_was_stop` when we close a position due to stop.
    // Since `strategy.exit` handles the stop, we don't get a direct callback.
    // We can check if the last closed trade's exit price is within a small tolerance of the stop price.
    // Or simpler: If the trade was a loss, it likely hit the stop (since TP is usually larger or similar).
    // But TP could be hit for a loss? No, TP is profit.
    // So if `strategy.closedtrades.profit(last_trade_id) < 0`, it hit the stop (or session close, but session close is 16:00).
    // Let's assume negative P&L implies stop hit for the purpose of reversal eligibility, unless it was a session close.
    // Session close happens at 16:00. If it was a session close, we shouldn't reverse immediately? 
    // "Reversal: ... allow one opposite-direction entry ... that satisfies the same arm, pivot, trend, delta, and session rules".
    // If session ended, we are out. Reversal implies immediate re-entry.
    // Let's stick to: If last trade P&L < 0, consider it a stop-out for reversal purposes.

    float last_profit = strategy.closedtrades.profit(last_trade_id)
    last_trade_was_stop := last_profit < 0
    last_exit_bar := bar_index

bool cooled_down = bar_index - last_trade_bar >= cooldown_bars

// Reversal Logic:
// If use_reversal is true, and last trade was a stop, and we are within reversal_cooldown_bars of the exit,
// we can bypass the normal cooldown.
bool reversal_allowed = false
if use_reversal and last_trade_was_stop
    if bar_index - last_exit_bar <= reversal_cooldown_bars
        reversal_allowed := true

bool can_enter = risk_valid and in_session and strategy.position_size == 0
bool cooldown_ok = cooled_down or reversal_allowed

// Long Entry:
// 1. Armed Long
// 2. Pivot Low Confirmed (on this bar)
// 3. Pivot Low Price > POC High
// 4. VWMA Up
// 5. Delta Bull
// 6. Cooldown OK

float pivot_low_price = pivot_low_confirmed ? low[pivot_len] : na
float pivot_high_price = pivot_high_confirmed ? high[pivot_len] : na

bool long_entry_cond = armed_dir == 1 and pivot_low_confirmed and not na(pivot_low_price) and pivot_low_price > poc_hi and vwma_up and delta_bull and can_enter and cooldown_ok and (bar_index - pivot_len > arm_start_bar)
bool short_entry_cond = armed_dir == -1 and pivot_high_confirmed and not na(pivot_high_price) and pivot_high_price < poc_lo and vwma_dn and delta_bear and can_enter and cooldown_ok and (bar_index - pivot_len > arm_start_bar)

if long_entry_cond
    last_trade_bar := bar_index
    last_trade_was_stop := false
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)
    armed_dir := 0 // Disarm after entry

else if short_entry_cond
    last_trade_bar := bar_index
    last_trade_was_stop := false
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)
    armed_dir := 0 // Disarm after entry

// ===== POC PRESSURE — fill only when delta meets min_delta_pct threshold =====
float delta_strength = 0.0
color channel_fill = na
if not na(poc_delta_pct) and min_delta_pct > 0
    if poc_delta_pct > min_delta_pct
        delta_strength := math.min(1.0, poc_delta_pct / min_delta_pct)
        channel_fill := color.new(color.green, 95 - math.round(delta_strength * 45))
    else if poc_delta_pct < -min_delta_pct
        delta_strength := math.min(1.0, -poc_delta_pct / min_delta_pct)
        channel_fill := color.new(color.red, 95 - math.round(delta_strength * 45))

// ===== POC DELTA LABEL =====
var label lbl_poc = na
if not na(poc_hi) and not na(poc_lo) and not na(poc_delta_pct)
    float mid_y = (poc_lo + poc_hi) / 2
    string txt = poc_delta_pct >= 0 ? "+" + str.tostring(poc_delta_pct, "#.#") + "%" : str.tostring(poc_delta_pct, "#.#") + "%"
    if na(lbl_poc)
        lbl_poc := label.new(bar_index, mid_y, txt, style=label.style_label_center, color=color.new(color.gray, 70), textcolor=color.white, size=size.normal)
    else
        label.set_xy(lbl_poc, bar_index, mid_y)
        label.set_text(lbl_poc, txt)

// ===== PLOT =====
plot(vwma_val, "VWMA", vwma_up ? color.lime : vwma_dn ? color.red : color.gray, linewidth=2)
float plo  = not na(poc_lo) ? poc_lo : na
float ppoc = not na(poc_price) ? poc_price : na
float phi  = not na(poc_hi) ? poc_hi : na
plot_lo  = plot(plo, "POC Low", #2962FF, style=plot.style_stepline, linewidth=2)
plot_poc = plot(ppoc, "POC", color.yellow, style=plot.style_stepline, linewidth=1)
plot_hi  = plot(phi, "POC High", #2962FF, style=plot.style_stepline, linewidth=2)
fill(plot_lo, plot_hi, channel_fill)

plot(strategy.position_size != 0 ? (strategy.position_size > 0 ? strategy.position_avg_price - stop_pts : strategy.position_avg_price + stop_pts) : na, "Stop", color.fuchsia, style=plot.style_stepline, linewidth=2)

plotshape(long_entry_cond, "Long Signal", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(short_entry_cond, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

plot(not na(poc_delta_pct) ? poc_delta_pct : na, "POC Delta %", color.orange, display=display.data_window)

// Arm Status Plot
plot(armed_dir == 1 ? poc_hi : armed_dir == -1 ? poc_lo : na, "Arm Zone", color.orange, style=plot.style_cross, linewidth=1)
