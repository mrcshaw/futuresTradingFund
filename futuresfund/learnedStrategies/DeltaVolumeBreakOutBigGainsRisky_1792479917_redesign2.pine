//@version=5
strategy("Delta Volume Breakout Redesign 2", overlay=true,
  initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=5.50,
  slippage=1, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false,
  max_bars_back=5000)

// ===== RISK =====
pv             = input.float(5, "Point Value ($)")
stop_dollars   = input.int(250, "Stop ($)", minval=250, maxval=700)
tp_dollars     = input.int(500, "Take Profit ($)", minval=250)
effective_tp   = math.max(tp_dollars, stop_dollars + 1)

long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
short_limit = close - tp_dollars / pv

if strategy.position_size != 0 and not na(stop_dollars)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")

// ===== VOLUME PROFILE =====
profile_lookback = input.int(120, "Profile Lookback (bars)", minval=20, maxval=2000, step=10)
profile_rows     = input.int(10, "Price Levels (rows)", minval=5, maxval=100, step=5, tooltip="More rows = finer resolution but slower.")

// ===== DELTA VOLUME =====
min_delta_pct = input.float(5, "Min Delta Imbalance (%)", minval=0, maxval=80, step=5, tooltip="Net delta at POC must exceed this % of total POC volume to confirm direction. 0 = disabled.")

// ===== TREND FILTER =====
vwma_len  = input.int(20, "VWMA Length", minval=1)
pivot_len = input.int(3, "Pivot Length", minval=2, maxval=20)

// ===== SESSION =====
// Fixed GC futures session 18:00 to 16:00 New York

// ===== COMPUTED =====
float stop_pts = stop_dollars / pv
float tp_pts   = effective_tp / pv

// ===== SESSION LOGIC =====
bar_hr = hour(time, "America/New_York")
bar_mn = minute(time, "America/New_York")
bar_t  = bar_hr * 100 + bar_mn
int s_start = 1800
int s_end   = 1600

bool in_session = (s_start > s_end ? (bar_t >= s_start or bar_t < s_end) : (bar_t >= s_start and bar_t < s_end))

prev_hr = hour(time[1], "America/New_York")
prev_mn = minute(time[1], "America/New_York")
prev_t  = prev_hr * 100 + prev_mn
bool was_in_session = (s_start > s_end ? (prev_t >= s_start or prev_t < s_end) : (prev_t >= s_start and prev_t < s_end))
bool session_ended = was_in_session and not in_session

if session_ended and strategy.position_size != 0
    strategy.close_all(comment="Session Close")

// ===== VWMA TREND =====
float vwma_val = ta.vwma(close, vwma_len)
bool  vwma_up  = close > vwma_val
bool  vwma_dn  = close < vwma_val

// ===== VOLUME PROFILE WITH DELTA =====
int lb   = math.min(profile_lookback, bar_index)
int rows = profile_rows

float prof_hi   = ta.highest(high, lb > 0 ? lb : 1)
float prof_lo   = ta.lowest(low, lb > 0 ? lb : 1)
float prof_span = prof_hi - prof_lo
float step_size = prof_span > 0 ? prof_span / rows : na

var array<float> vol_total = array.new_float(100, 0.0)
var array<float> vol_up    = array.new_float(100, 0.0)
var array<float> vol_dn    = array.new_float(100, 0.0)

float poc_price = na
float poc_hi    = na
float poc_lo    = na
float poc_delta_pct = na
int   poc_row   = 0

if not na(step_size) and prof_span > 0 and lb > 1
    for a = 0 to 2
        arr = a == 0 ? vol_total : a == 1 ? vol_up : vol_dn
        if arr.size() != rows
            arr.clear()
            for i = 0 to rows - 1
                arr.push(0.0)
        else
            for i = 0 to rows - 1
                arr.set(i, 0.0)

    for iBar = 0 to lb - 1
        float bar_vol = volume[iBar]
        if bar_vol <= 0
            continue

        float bar_lo  = low[iBar]
        float bar_hi  = high[iBar]
        bool  bar_up  = close[iBar] >= open[iBar]

        int s_row = math.max(math.floor((bar_lo - prof_lo) / step_size), 0)
        int e_row = math.min(math.floor((bar_hi - prof_lo) / step_size), rows - 1)
        int span  = e_row - s_row + 1

        if span <= 0
            continue

        float per_row = bar_vol / span
        for k = 0 to span - 1
            int r = s_row + k
            if r >= 0 and r < rows
                vol_total.set(r, vol_total.get(r) + per_row)
                if bar_up
                    vol_up.set(r, vol_up.get(r) + per_row)
                else
                    vol_dn.set(r, vol_dn.get(r) + per_row)

    // Find POC
    float max_vol = 0.0
    for r = 0 to rows - 1
        float v = vol_total.get(r)
        if v > max_vol
            max_vol := v
            poc_row := r

    poc_price := prof_lo + (poc_row + 0.5) * step_size
    poc_lo    := prof_lo + poc_row * step_size
    poc_hi    := prof_lo + (poc_row + 1) * step_size

    // Delta at POC
    float poc_up  = vol_up.get(poc_row)
    float poc_dn  = vol_dn.get(poc_row)
    float poc_tot = vol_total.get(poc_row)
    poc_delta_pct := poc_tot > 0 ? ((poc_up - poc_dn) / poc_tot) * 100 : 0.0

// ===== PIVOT DETECTION (price pattern, not library) =====
// Pivot high: current high is the highest of pivot_len bars on each side
bool pivot_high = false
bool pivot_low  = false
if bar_index >= pivot_len
    pivot_high := true
    pivot_low  := true
    for i = 1 to pivot_len
        if high[bar_index - i] >= high[bar_index - i + 1]
            pivot_high := false
        if low[bar_index - i] <= low[bar_index - i + 1]
            pivot_low := false
    // Confirm: current bar high is >= all bars to the left (already checked) and to the right
    for i = 1 to pivot_len
        if high[bar_index - i] > high
            pivot_high := false
        if low[bar_index - i] < low
            pivot_low := false

// ===== BREAKOUT / ARMING LOGIC =====
bool delta_bull = min_delta_pct <= 0 or (not na(poc_delta_pct) and poc_delta_pct > min_delta_pct)
bool delta_bear = min_delta_pct <= 0 or (not na(poc_delta_pct) and poc_delta_pct < -min_delta_pct)

var int armed_dir = 0

// Arm long: close breaks above POC zone, VWMA long, delta bull
if not na(poc_hi) and close > poc_hi and close[1] <= poc_hi and vwma_up and delta_bull
    armed_dir := 1
// Arm short: close breaks below POC zone, VWMA short, delta bear
else if not na(poc_lo) and close < poc_lo and close[1] >= poc_lo and vwma_dn and delta_bear
    armed_dir := -1

// Stay armed while close remains outside POC zone in that direction
if armed_dir == 1
    if na(poc_hi) or close <= poc_hi
        armed_dir := 0
else if armed_dir == -1
    if na(poc_lo) or close >= poc_lo
        armed_dir := 0

// ===== POST-STOP REVERSAL FLAG =====
var int last_exit_dir = 0
var bool reversal_flag = false

// Detect stop-out: position was open and now flat, and loss equals stop
if strategy.position_size == 0 and strategy.position_size[1] != 0
    float prev_pos = strategy.position_size[1]
    float prev_avg = strategy.position_avg_price[1]
    float exit_loss = prev_pos > 0 ? (prev_avg - close) * pv : (close - prev_avg) * pv
    if exit_loss >= stop_dollars
        last_exit_dir := prev_pos > 0 ? 1 : -1
        reversal_flag := true

// Clear reversal flag if next valid signal is not opposite or session ends
if reversal_flag
    if session_ended
        reversal_flag := false
    else if last_exit_dir == 1 and armed_dir == 1
        reversal_flag := false
    else if last_exit_dir == -1 and armed_dir == -1
        reversal_flag := false

// ===== ENTRY SIGNALS =====
// Long: armed long, next confirmed pivot high above POC zone
bool long_entry_sig = false
bool short_entry_sig = false

if armed_dir == 1 and pivot_high and not na(poc_hi) and high > poc_hi and in_session and strategy.position_size <= 0
    long_entry_sig := true
    if reversal_flag and last_exit_dir == -1
        reversal_flag := false

if armed_dir == -1 and pivot_low and not na(poc_lo) and low < poc_lo and in_session and strategy.position_size >= 0
    short_entry_sig := true
    if reversal_flag and last_exit_dir == 1
        reversal_flag := false

// ===== ENTRIES =====
if long_entry_sig
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)
    armed_dir := 0
else if short_entry_sig
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)
    armed_dir := 0

// ===== PLOT =====
plot(vwma_val, "VWMA", vwma_up ? color.lime : vwma_dn ? color.red : color.gray, linewidth=2)
plot(not na(poc_price) ? poc_price : na, "POC", color.yellow, style=plot.style_stepline, linewidth=1)
plot(not na(poc_hi) ? poc_hi : na, "POC High", #2962FF, style=plot.style_stepline, linewidth=2)
plot(not na(poc_lo) ? poc_lo : na, "POC Low", #2962FF, style=plot.style_stepline, linewidth=2)
plot(strategy.position_size != 0 ? long_stop : na, "Long Stop", color.fuchsia, style=plot.style_stepline, linewidth=2)
plot(strategy.position_size != 0 ? short_stop : na, "Short Stop", color.fuchsia, style=plot.style_stepline, linewidth=2)

bgcolor(not na(poc_hi) and not na(poc_lo) and close >= poc_lo and close <= poc_hi ? color.new(#2962FF, 90) : na)

plotshape(long_entry_sig, "Long Signal", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(short_entry_sig, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

plot(not na(poc_delta_pct) ? poc_delta_pct : na, "POC Delta %", color.orange, display=display.data_window)
