//@version=5
// Built from: Delta Volume BOS Night Shift (structure + volume) and POC RSI Reversal (RSI trigger), using ta.ema, ta.rsi, ta.highest, ta.lowest, ta.sma, ta.crossover, ta.crossunder
strategy("EMA RSI Structure Break", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")

// ===== PARAMETERS =====
ema_len = input.int(28, "EMA Length", minval=5, maxval=100)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=50)
rsi_long = input.int(35, "RSI Long Level", minval=20, maxval=50)
rsi_short = input.int(65, "RSI Short Level", minval=50, maxval=80)
struct_len = input.int(10, "Structure Lookback", minval=5, maxval=50)
vol_ma_len = input.int(48, "Volume MA Length", minval=10, maxval=100)
cooldown_bars = input.int(8, "Cooldown Bars", minval=2, maxval=50)

// ===== SESSION LOGIC =====
cur_min = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
sess_start = sess_start_hr * 60 + sess_start_mn
sess_end = sess_end_hr * 60 + sess_end_mn
in_session = use_session ? (sess_start < sess_end ? (cur_min >= sess_start and cur_min < sess_end) : (cur_min >= sess_start or cur_min < sess_end)) : true

// ===== INDICATORS =====
ema_val = ta.ema(close, ema_len)
rsi_val = ta.rsi(close, rsi_len)
vol_avg = ta.sma(volume, vol_ma_len)
hi_struct = ta.highest(high, struct_len)[1]
lo_struct = ta.lowest(low, struct_len)[1]

// ===== SIGNALS =====
vol_ok = volume > vol_avg
long_sig = close > ema_val and ta.crossover(rsi_val, rsi_long) and close > hi_struct and vol_ok
short_sig = close < ema_val and ta.crossunder(rsi_val, rsi_short) and close < lo_struct and vol_ok

// ===== COOLDOWN =====
var int last_entry_bar = 0
can_trade = bar_index - last_entry_bar >= cooldown_bars

// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")

// ===== OPEN P&L STOP =====
if strategy.position_size != 0 and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")

// ===== EXITS =====
if strategy.position_size > 0
    long_stop = close - stop_dollars / pv
    long_limit = close + tp_dollars / pv
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)
if strategy.position_size < 0
    short_stop = close + stop_dollars / pv
    short_limit = close - tp_dollars / pv
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)

// ===== ENTRIES =====
if in_session and can_trade and long_sig and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index
if in_session and can_trade and short_sig and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index
