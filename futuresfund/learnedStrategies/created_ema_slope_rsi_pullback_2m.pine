//@version=5
// Built from: POC RSI Reversal v4 (RSI pullback in trend) + Delta Volume BOS (volume confirmation), indicators: ta.ema, ta.rsi, ta.sma, ta.crossover, ta.crossunder, ta.change
strategy("EMA Slope RSI Pullback 2m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")
// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")
// ===== PARAMETERS =====
ema_len = input.int(20, "EMA Length", minval=5, maxval=100)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)
vol_sma_len = input.int(20, "Volume SMA Length", minval=5, maxval=50)
rsi_os = input.int(30, "RSI Oversold", minval=20, maxval=40)
rsi_ob = input.int(70, "RSI Overbought", minval=60, maxval=80)
cooldown_bars = input.int(6, "Cooldown Bars", minval=1, maxval=50)
// ===== SESSION LOGIC =====
tod = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
s_min = sess_start_hr * 60 + sess_start_mn
e_min = sess_end_hr * 60 + sess_end_mn
in_session = use_session ? (s_min < e_min ? (tod >= s_min and tod < e_min) : (tod >= s_min or tod < e_min)) : true
// ===== INDICATORS =====
ema_val = ta.ema(close, ema_len)
ema_slope = ta.change(ema_val, 1)
rsi_val = ta.rsi(close, rsi_len)
vol_ok = volume > ta.sma(volume, vol_sma_len)
// ===== COOLDOWN =====
var int last_entry_bar = -999
cd_ok = (bar_index - last_entry_bar) >= cooldown_bars
// ===== CONDITIONS =====
long_ok = in_session and ema_slope > 0 and close > ema_val and ta.crossover(rsi_val, rsi_os) and vol_ok and cd_ok
short_ok = in_session and ema_slope < 0 and close < ema_val and ta.crossunder(rsi_val, rsi_ob) and vol_ok and cd_ok
// ===== EXITS =====
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
// ===== MANAGEMENT =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
if strategy.position_size != 0 and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
// ===== ENTRIES =====
if long_ok and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    strategy.exit("LX", from_entry="Long", stop=long_stop, limit=long_limit)
    last_entry_bar := bar_index
if short_ok and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    strategy.exit("SX", from_entry="Short", stop=short_stop, limit=short_limit)
    last_entry_bar := bar_index
