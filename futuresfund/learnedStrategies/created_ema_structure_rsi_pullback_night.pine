//@version=5
// Built from: POC Momentum RSI Breakout + Delta Volume BOS Night Shift, ta.ema, ta.rsi, math.sum
strategy("EMA Structure RSI Pullback Night", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(500, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(750, "Take Profit ($)", minval=250, maxval=2000)
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")
// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")
// ===== PARAMETERS =====
ema_len = input.int(50, "EMA Length", minval=10, maxval=200)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)
vol_ma_len = input.int(20, "Volume MA Length", minval=5, maxval=50)
rsi_long_th = input.int(40, "RSI Long Threshold", minval=20, maxval=50)
rsi_short_th = input.int(60, "RSI Short Threshold", minval=50, maxval=80)
cooldown_bars = input.int(6, "Cooldown Bars", minval=2, maxval=60)
// ===== SESSION LOGIC =====
cur_min = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
ss = sess_start_hr * 60 + sess_start_mn
se = sess_end_hr * 60 + sess_end_mn
in_session = not use_session or (ss < se ? cur_min >= ss and cur_min < se : cur_min >= ss or cur_min < se)
// ===== INDICATORS =====
ema_val = ta.ema(close, ema_len)
rsi_val = ta.rsi(close, rsi_len)
vol_ma = math.sum(volume, vol_ma_len) / vol_ma_len
// ===== ENTRY =====
long_sig = close > ema_val and ta.crossover(rsi_val, rsi_long_th) and volume > vol_ma
short_sig = close < ema_val and ta.crossunder(rsi_val, rsi_short_th) and volume > vol_ma
var int last_entry_bar = 0
var float l_stop = na
var float l_limit = na
var float s_stop = na
var float s_limit = na
can_trade = bar_index - last_entry_bar >= cooldown_bars
if in_session and can_trade and long_sig and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    l_stop := close - stop_dollars / pv
    l_limit := close + tp_dollars / pv
    last_entry_bar := bar_index
if in_session and can_trade and short_sig and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    s_stop := close + stop_dollars / pv
    s_limit := close - tp_dollars / pv
    last_entry_bar := bar_index
// ===== EXITS =====
if strategy.position_size > 0
    strategy.exit("LX", from_entry="Long", stop=long_stop, limit=long_limit)
if strategy.position_size < 0
    strategy.exit("SX", from_entry="Short", stop=short_stop, limit=short_limit)
// ===== RISK CHECK =====
if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
