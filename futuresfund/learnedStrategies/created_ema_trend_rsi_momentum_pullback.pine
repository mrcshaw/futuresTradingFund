//@version=5
// Built from: POC Momentum RSI Breakout + Delta Volume BOS, ta.ema, ta.rsi, ta.mom, ta.crossover, ta.crossunder
strategy("EMA Trend RSI Momentum Pullback", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)", minval=0, maxval=23)
sess_start_mn = input.int(0, "Session Start Minute", minval=0, maxval=59)
sess_end_hr = input.int(16, "Session End Hour (ET)", minval=0, maxval=23)
sess_end_mn = input.int(0, "Session End Minute", minval=0, maxval=59)

// ===== PARAMS =====
ema_len = input.int(30, "EMA Length", minval=10, maxval=200)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)
rsi_long = input.int(35, "RSI Long Trigger", minval=20, maxval=50)
rsi_short = input.int(65, "RSI Short Trigger", minval=50, maxval=80)
mom_len = input.int(5, "Momentum Length", minval=2, maxval=20)
cooldown_bars = input.int(10, "Cooldown Bars", minval=3, maxval=100)

// ===== INDICATORS =====
ema_val = ta.ema(close, ema_len)
rsi_val = ta.rsi(close, rsi_len)
mom_val = ta.mom(close, mom_len)

// ===== SESSION LOGIC =====
hr = hour(time, "America/New_York")
mn = minute(time, "America/New_York")
cur = hr * 60 + mn
s_start = sess_start_hr * 60 + sess_start_mn
s_end = sess_end_hr * 60 + sess_end_mn
in_session = use_session ? (s_start > s_end ? (cur >= s_start or cur < s_end) : (cur >= s_start and cur < s_end)) : true

// ===== COOLDOWN =====
var int last_entry_bar = -9999
bars_since_entry = bar_index - last_entry_bar

// ===== ENTRY =====
long_trend = close > ema_val
short_trend = close < ema_val
long_trigger = ta.crossover(rsi_val, rsi_long)
short_trigger = ta.crossunder(rsi_val, rsi_short)
long_mom = mom_val > 0
short_mom = mom_val < 0
can_enter = in_session and bars_since_entry >= cooldown_bars and strategy.position_size == 0

if can_enter and long_trend and long_trigger and long_mom
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index

if can_enter and short_trend and short_trigger and short_mom
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index

// ===== EXITS =====
if strategy.position_size > 0
    long_stop = close - stop_dollars / pv
    long_limit = close + tp_dollars / pv
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)

if strategy.position_size < 0
    short_stop = close + stop_dollars / pv
    short_limit = close - tp_dollars / pv
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)

// ===== OPEN P&L CHECK =====
if strategy.position_size != 0 and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
