//@version=5
// Built from: POC RSI Reversal v4 (RSI pullback in trend) + EMA 200+55 trend filter, ta.ema, ta.rsi, ta.crossover, ta.crossunder, ta.mom
strategy("EMA Trend RSI Pullback 5m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")

// ===== PARAMETERS =====
ema_fast_len = input.int(20, "EMA Fast", minval=5, maxval=100)
ema_slow_len = input.int(50, "EMA Slow", minval=20, maxval=200)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)
rsi_buy = input.int(40, "RSI Buy Level", minval=20, maxval=50)
rsi_sell = input.int(60, "RSI Sell Level", minval=50, maxval=80)
mom_len = input.int(5, "Momentum Length", minval=2, maxval=20)
cooldown_bars = input.int(6, "Cooldown Bars", minval=1, maxval=50)

// ===== SESSION LOGIC =====
hour_et = hour(time, "America/New_York")
min_et = minute(time, "America/New_York")
sess_start = sess_start_hr * 60 + sess_start_mn
sess_end = sess_end_hr * 60 + sess_end_mn
cur_min = hour_et * 60 + min_et
in_session = use_session ? (sess_start < sess_end ? (cur_min >= sess_start and cur_min < sess_end) : (cur_min >= sess_start or cur_min < sess_end)) : true

// ===== INDICATORS =====
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
mom_val = ta.mom(close, mom_len)

// ===== ENTRY LOGIC =====
bull_trend = ema_fast > ema_slow and close > ema_slow
bear_trend = ema_fast < ema_slow and close < ema_slow
rsi_buy_trigger = ta.crossover(rsi_val, rsi_buy)
rsi_sell_trigger = ta.crossunder(rsi_val, rsi_sell)
mom_bull = mom_val > 0
mom_bear = mom_val < 0
long_signal = bull_trend and rsi_buy_trigger and mom_bull
short_signal = bear_trend and rsi_sell_trigger and mom_bear

// ===== COOLDOWN =====
var int last_entry_bar = 0
can_enter = bar_index - last_entry_bar >= cooldown_bars

// ===== EXITS =====
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv

// ===== EXECUTION =====
if in_session and can_enter and long_signal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)
    last_entry_bar := bar_index

if in_session and can_enter and short_signal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)
    last_entry_bar := bar_index

if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")

if strategy.position_size != 0 and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
