//@version=5
// Built from: POC RSI Reversal (RSI extreme reversal) + Engine4 VWMA (trend filter), ta.rsi, ta.ema, ta.mom
strategy("EMA Trend RSI Reversal 2m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(400, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(700, "Take Profit ($)", minval=250, maxval=2000)
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")

// ===== INDICATORS =====
ema_len = input.int(50, "EMA Length", minval=10, maxval=200)
rsi_len = input.int(14, "RSI Length", minval=7, maxval=30)
rsi_os = input.int(30, "RSI Oversold", minval=15, maxval=40)
rsi_ob = input.int(70, "RSI Overbought", minval=60, maxval=85)
mom_len = input.int(5, "Momentum Length", minval=2, maxval=20)
cooldown_bars = input.int(12, "Cooldown Bars", minval=4, maxval=60)

// ===== SESSION LOGIC =====
h = hour(time, "America/New_York")
m = minute(time, "America/New_York")
ss = sess_start_hr * 60 + sess_start_mn
se = sess_end_hr * 60 + sess_end_mn
cm = h * 60 + m
in_session = use_session ? (ss < se ? (cm >= ss and cm < se) : (cm >= ss or cm < se)) : true

// ===== COOLDOWN =====
var int last_entry_bar = 0
can_enter = bar_index - last_entry_bar >= cooldown_bars

// ===== SIGNALS =====
ema_v = ta.ema(close, ema_len)
rsi_v = ta.rsi(close, rsi_len)
mom_v = ta.mom(close, mom_len)
long_sig = close > ema_v and ta.crossover(rsi_v, rsi_os) and mom_v > 0
short_sig = close < ema_v and ta.crossunder(rsi_v, rsi_ob) and mom_v < 0

// ===== ENTRIES =====
if in_session and can_enter and strategy.position_size == 0
    if long_sig
        strategy.entry("Long", strategy.long)
        last_entry_bar := bar_index
    else if short_sig
        strategy.entry("Short", strategy.short)
        last_entry_bar := bar_index

// ===== EXITS =====
if strategy.position_size > 0
    strategy.exit("LX", from_entry="Long", stop=long_stop, limit=long_limit)
if strategy.position_size < 0
    strategy.exit("SX", from_entry="Short", stop=short_stop, limit=short_limit)

// ===== OPEN P&L STOP =====
if strategy.position_size != 0 and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
