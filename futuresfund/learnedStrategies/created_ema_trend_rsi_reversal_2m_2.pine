//@version=5
// Built from: RSI mean-reversion within EMA trend + ROC momentum confirmation, ta.ema, ta.rsi, ta.roc, ta.crossover, ta.crossunder
strategy("EMA Trend RSI Reversal 2m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")
tod = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
s_min = sess_start_hr * 60 + sess_start_mn
e_min = sess_end_hr * 60 + sess_end_mn
in_session = use_session ? (s_min < e_min ? (tod >= s_min and tod < e_min) : (tod >= s_min or tod < e_min)) : true
// ===== INDICATORS =====
ema_fast_len = input.int(20, "EMA Fast", minval=5, maxval=100)
ema_slow_len = input.int(50, "EMA Slow", minval=20, maxval=200)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)
rsi_os = input.int(30, "RSI Oversold", minval=10, maxval=40)
rsi_ob = input.int(70, "RSI Overbought", minval=60, maxval=90)
roc_len = input.int(5, "ROC Length", minval=2, maxval=20)
cooldown_bars = input.int(8, "Cooldown Bars", minval=1, maxval=50)
ema_f = ta.ema(close, ema_fast_len)
ema_s = ta.ema(close, ema_slow_len)
rsi_v = ta.rsi(close, rsi_len)
roc_v = ta.roc(close, roc_len)
// ===== SIGNALS =====
trend_long = ema_f > ema_s
trend_short = ema_f < ema_s
trig_long = ta.crossover(rsi_v, rsi_os)
trig_short = ta.crossunder(rsi_v, rsi_ob)
conf_long = roc_v > 0
conf_short = roc_v < 0
var int last_bar = 0
can_trade = bar_index - last_bar >= cooldown_bars
long_sig = in_session and trend_long and trig_long and conf_long and can_trade
short_sig = in_session and trend_short and trig_short and conf_short and can_trade
// ===== EXECUTION =====
if long_sig
    strategy.entry("Long", strategy.long)
    strategy.exit("LX", from_entry="Long", stop=long_stop, limit=long_limit)
    last_bar := bar_index
if short_sig
    strategy.entry("Short", strategy.short)
    strategy.exit("SX", from_entry="Short", stop=short_stop, limit=short_limit)
    last_bar := bar_index
// ===== OPEN P&L STOP =====
if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
