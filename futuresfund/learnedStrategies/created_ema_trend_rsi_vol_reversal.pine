//@version=5
// Built from: Delta Volume BOS Night Shift card (session timing, volume filter) + POC RSI Reversal (RSI trigger), using ta.ema, ta.rsi, ta.sma, ta.crossover, ta.crossunder
strategy("EMA Trend RSI Vol Reversal", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")

// ===== INPUTS =====
ema_trend_len = input.int(200, "Trend EMA Length", minval=50, maxval=500)
ema_fast_len = input.int(20, "Fast EMA Length", minval=5, maxval=100)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)
rsi_oversold = input.int(30, "RSI Oversold", minval=10, maxval=40)
rsi_overbought = input.int(70, "RSI Overbought", minval=60, maxval=90)
vol_ma_len = input.int(20, "Volume MA Length", minval=5, maxval=100)
vol_mult = input.float(1.5, "Volume Multiplier", minval=1.0, maxval=3.0, step=0.1)
cooldown_bars = input.int(10, "Cooldown Bars", minval=3, maxval=100)

// ===== CALCULATIONS =====
ema_trend = ta.ema(close, ema_trend_len)
ema_fast = ta.ema(close, ema_fast_len)
rsi_val = ta.rsi(close, rsi_len)
vol_ma = ta.sma(volume, vol_ma_len)
vol_ok = volume > vol_ma * vol_mult

h = hour(time, "America/New_York")
m = minute(time, "America/New_York")
s_start = sess_start_hr * 60 + sess_start_mn
s_end = sess_end_hr * 60 + sess_end_mn
in_session = use_session ? (s_start < s_end ? (h*60+m >= s_start and h*60+m < s_end) : (h*60+m >= s_start or h*60+m < s_end)) : true

var int last_entry_bar = 0
cooldown_ok = bar_index - last_entry_bar >= cooldown_bars

// ===== ENTRIES =====
long_sig = in_session and cooldown_ok and close > ema_trend and close > ema_fast and ta.crossover(rsi_val, rsi_oversold) and vol_ok
short_sig = in_session and cooldown_ok and close < ema_trend and close < ema_fast and ta.crossunder(rsi_val, rsi_overbought) and vol_ok

if long_sig and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)

if short_sig and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)

// ===== STOP CHECK =====
if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
