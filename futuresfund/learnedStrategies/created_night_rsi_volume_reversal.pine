//@version=5
// Built from: Night Session Outside Bar Reversal (trend+trigger in night session), RSI reversal + volume confirmation. Indicators: ta.ema, ta.rsi, ta.sma, ta.crossover, ta.crossunder.
strategy("Night RSI Volume Reversal", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")

// ===== PARAMETERS =====
ema_len = input.int(200, "EMA Length", minval=50, maxval=500)
rsi_len = input.int(14, "RSI Length", minval=7, maxval=30)
rsi_ob = input.int(70, "RSI Overbought", minval=55, maxval=85)
rsi_os = input.int(30, "RSI Oversold", minval=15, maxval=45)
vol_ma_len = input.int(20, "Volume MA Length", minval=10, maxval=60)
vol_mult = input.float(1.5, "Volume Multiplier", minval=1.0, maxval=3.0)
cooldown_bars = input.int(4, "Cooldown Bars", minval=2, maxval=20)

// ===== SESSION LOGIC =====
h = hour(time, "America/New_York")
m = minute(time, "America/New_York")
hm = h * 100 + m
start_hm = sess_start_hr * 100 + sess_start_mn
end_hm = sess_end_hr * 100 + sess_end_mn
in_session = use_session ? (start_hm < end_hm ? (hm >= start_hm and hm < end_hm) : (hm >= start_hm or hm < end_hm)) : true

// ===== INDICATORS =====
ema_val = ta.ema(close, ema_len)
rsi_val = ta.rsi(close, rsi_len)
vol_avg = ta.sma(volume, vol_ma_len)
vol_spike = volume > vol_avg * vol_mult

// ===== ENTRY LOGIC =====
var int last_entry_bar = 0
can_trade = in_session and (bar_index - last_entry_bar >= cooldown_bars)

long_signal = can_trade and close > ema_val and ta.crossover(rsi_val, rsi_os) and vol_spike
short_signal = can_trade and close < ema_val and ta.crossunder(rsi_val, rsi_ob) and vol_spike

if long_signal
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index
if short_signal
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index

// ===== EXITS =====
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv

if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)
if strategy.position_size < 0
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)

// ===== OPEN P&L CHECK =====
if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
