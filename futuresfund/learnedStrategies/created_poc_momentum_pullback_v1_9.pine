//@version=5
// Built from: POC Pullback Momentum v2, RSI 3system v2. Indicators: ta.rsi, ta.atr, ta.ema.
strategy("POC Momentum Pullback v1", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv                = input.float(2, "Point Value ($)")
stop_pct          = input.float(0.1, "Stop (% of account)", minval=0.1, maxval=3)
tp_pct            = input.float(1, "Take Profit (% of account)", minval=0.1, maxval=4)
stop_cash         = input.float(0, "Stop ($)", minval=0, maxval=1500)
tp_cash           = input.float(0, "Take Profit ($)", minval=0, maxval=2000)
use_trail         = input.bool(false, "Enable Trailing Stop")
trail_pct         = input.float(50, "Trail: Keep % of Peak Profit")
trail_step_acct   = input.float(1, "Trail: Tighten every % of account")
trail_step_pct    = input.float(50, "Trail: Tighten by X% per step")
trail_min_pct     = input.float(2, "Trail: Min Profit (% of account)")
stop_dollars      = strategy.initial_capital * stop_pct / 100
tp_dollars        = strategy.initial_capital * tp_pct / 100
trail_step_amt    = strategy.initial_capital * trail_step_acct / 100
trail_min_dollars = strategy.initial_capital * trail_min_pct / 100
if stop_cash > 0
    stop_dollars := stop_cash
if tp_cash > 0
    tp_dollars := tp_cash
if strategy.position_size != 0 and not na(stop_dollars)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION =====
use_session   = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0,  "Session Start Minute")
sess_end_hr   = input.int(16,  "Session End Hour (ET)")
sess_end_mn   = input.int(0,  "Session End Minute")
sess_bar_hr = hour(time, "America/New_York")
sess_bar_mn = minute(time, "America/New_York")
sess_bar_t = sess_bar_hr * 100 + sess_bar_mn
sess_clock_start = sess_start_hr * 100 + sess_start_mn
sess_clock_end = sess_end_hr * 100 + sess_end_mn
in_session = not use_session or (sess_clock_start > sess_clock_end ? (sess_bar_t >= sess_clock_start or sess_bar_t < sess_clock_end) : (sess_bar_t >= sess_clock_start and sess_bar_t < sess_clock_end))
if not in_session
    strategy.close_all(comment="Session")

// === INPUTS ===
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)
atrLen = input.int(14, "ATR Length", minval=5, maxval=50)
emaLen = input.int(50, "EMA Trend", minval=20, maxval=200)

// === RISK CALC ===

// === INDICATORS ===
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)
emaVal = ta.ema(close, emaLen)

// === SESSION FILTER ===
// Guideline 1: Flatten at 16:45 NY. Enter only during session.
// Session runs 18:00 to 16:45 next day.

// === LOGIC ===
// Trend Filter: Price above EMA for longs, below for shorts.
trendLong = close > emaVal
trendShort = close < emaVal

// Trigger: RSI Oversold/Overbought pullback in trend direction.
// Long: Trend is up, RSI dips below 30 (oversold) and crosses back above.
// Short: Trend is down, RSI rises above 70 (overbought) and crosses back below.
rsiCrossLong = ta.crossover(rsi, 30)
rsiCrossShort = ta.crossunder(rsi, 70)

// Cooldown: Prevent overtrading.
var int lastEntryBar = -100
cooldownBars = 2
isCooldown = (bar_index - lastEntryBar) < cooldownBars

// === EXECUTION ===
if in_session and not isCooldown
    // Long Entry
    if trendLong and rsiCrossLong
        strategy.entry("Long", strategy.long)
        lastEntryBar := bar_index
        
    // Short Entry
    if trendShort and rsiCrossShort
        strategy.entry("Short", strategy.short)
        lastEntryBar := bar_index

// === EXIT LOGIC ===
// Fixed stops and targets based on account percentage.
// Long Stop: close - stop_dollars / pv
// Long Limit: close + tp_dollars / pv
// Short Stop: close + stop_dollars / pv
// Short Limit: close - tp_dollars / pv

// We use strategy.exit with specific prices calculated relative to the current close
// Note: In Pine, strategy.exit prices are fixed at the time of the call. 
// To implement dynamic stops per trade, we would typically use strategy.exit("...", from_entry="...", stop=..., limit=...) 
// but since we don't track individual trade IDs easily without arrays (which are restricted or complex), 
// we apply the exit logic generally. However, the prompt requires: 
// "Every entry has strategy.exit... Fixed prices only... no trail arguments".
// And: "The stop and the take profit are a percent of the account... not a dollar amount".
// To make this work for multiple concurrent trades or sequential trades without arrays, 
// we rely on the fact that `strategy.exit` applies to the position. 
// Since we are using `strategy.fixed` qty, we can exit the whole position.

// Calculate prices based on current close. 
// This is a simplification for the script structure requested. 
// In a real engine, we'd track entry price. Here, we approximate using current close 
// for the exit command, which effectively sets the exit for the current position state.
// To be precise, we should calculate based on entry price, but we don't have `entry_price` variable 
// without arrays or `strategy.position_avg_price`. We use `strategy.position_avg_price` which is built-in.

avgPrice = strategy.position_avg_price
longStop = avgPrice - stop_dollars / pv
longLimit = avgPrice + tp_dollars / pv
shortStop = avgPrice + stop_dollars / pv
shortLimit = avgPrice - tp_dollars / pv

// Apply exits
strategy.exit("ExitLong", "Long", stop=longStop, limit=longLimit)
strategy.exit("ExitShort", "Short", stop=shortStop, limit=shortLimit)

// === GUIDELINE 1: FLATTEN AT 16:45 ===
