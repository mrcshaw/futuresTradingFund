//@version=5
// Built from: POC Pullback Momentum v2, delta_volume_breakout_night_no_reversal.pine
// Indicators: ta.ema, ta.rsi, ta.tr, ta.pivothigh, ta.pivotlow
strategy("POC Momentum Reversal 15m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv                = input.float(2, "Point Value ($)")
stop_pct          = input.float(0.1, "Stop (% of account)", minval=0.1, maxval=3)
tp_pct            = input.float(1, "Take Profit (% of account)", minval=0.1, maxval=4)
stop_cash         = input.float(0, "Stop ($)", minval=0, maxval=1500)
tp_cash           = input.float(0, "Take Profit ($)", minval=0, maxval=2000)
use_trail         = input.bool(false, "Enable Trailing Stop")
trail_pct         = input.float(50, "Trail: Keep % of Peak Profit")
trail_step_acct   = input.float(1, "Trail: Tighten every % of account")
trail_step_pct    = input.float(50, "Trail: Tighten by X% per step")
trail_min_pct     = input.float(2, "Trail: Min Profit (% of account)")
stop_dollars      = strategy.initial_capital * stop_pct / 100
tp_dollars        = strategy.initial_capital * tp_pct / 100
trail_step_amt    = strategy.initial_capital * trail_step_acct / 100
trail_min_dollars = strategy.initial_capital * trail_min_pct / 100
if stop_cash > 0
    stop_dollars := stop_cash
if tp_cash > 0
    tp_dollars := tp_cash
if strategy.position_size != 0 and not na(stop_dollars)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")
pivot_left = input.int(2, "Pivot Left", minval=1, maxval=50)
pivot_right = input.int(2, "Pivot Right", minval=1, maxval=50)


// ===== SESSION =====
use_session   = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0,  "Session Start Minute")
sess_end_hr   = input.int(16,  "Session End Hour (ET)")
sess_end_mn   = input.int(0,  "Session End Minute")
sess_bar_hr = hour(time, "America/New_York")
sess_bar_mn = minute(time, "America/New_York")
sess_bar_t = sess_bar_hr * 100 + sess_bar_mn
sess_clock_start = sess_start_hr * 100 + sess_start_mn
sess_clock_end = sess_end_hr * 100 + sess_end_mn
in_session = not use_session or (sess_clock_start > sess_clock_end ? (sess_bar_t >= sess_clock_start or sess_bar_t < sess_clock_end) : (sess_bar_t >= sess_clock_start and sess_bar_t < sess_clock_end))
if not in_session
    strategy.close_all(comment="Session")

// === INPUTS ===

// === RISK CALCULATION ===

// === INDICATORS ===
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
rsi = ta.rsi(close, 14)
atr = ta.atr(14)

// Pivot Structure (2 bars left/right)
ph = ta.pivothigh(high, pivot_left, pivot_right)
pl = ta.pivotlow(low, pivot_left, pivot_right)

// === SESSION FILTER (Guideline 1) ===
// Session runs 18:00 NY to 16:45 NY next day

// === COOLDOWN ===
var int last_entry_bar = -100
var int cooldown_bars = 4 // Bars to wait after entry
if bar_index > last_entry_bar and bar_index <= last_entry_bar + cooldown_bars
    strategy.cancel_all() // Cancel pending orders if in cooldown

// === LOGIC ===
// Trend Filter: EMA20 > EMA50 for Longs, EMA20 < EMA50 for Shorts
long_trend = ema20 > ema50
short_trend = ema20 < ema50

// Trigger: RSI Oversold/Overbought + Pivot Confirmation
long_cond = long_trend and ta.crossover(rsi, 30) and not na(pl)
short_cond = short_trend and ta.crossunder(rsi, 70) and not na(ph)

// === EXECUTION ===
if in_session and long_cond and bar_index > last_entry_bar + cooldown_bars
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index

if in_session and short_cond and bar_index > last_entry_bar + cooldown_bars
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index

// === EXIT & TRAILING ===
// Calculate dynamic stop/limit based on current close
long_stop = close - (stop_dollars / pv)
long_tp = close + (tp_dollars / pv)
short_stop = close + (stop_dollars / pv)
short_tp = close - (tp_dollars / pv)

// Trailing logic
if use_trail
    // Simple trail: if profit exceeds trail_min_dollars, adjust stop to trail_step_amt below peak
    // Note: Pine strategy.exit handles trailing via 'trail_length' or 'trail_offset'
    // We use trail_offset for % based logic roughly
    strategy.exit("ExitLong", "Long", stop=long_stop, limit=long_tp, trail_offset=trail_step_amt, trail_length=100)
    strategy.exit("ExitShort", "Short", stop=short_stop, limit=short_tp, trail_offset=trail_step_amt, trail_length=100)
else
    strategy.exit("ExitLong", "Long", stop=long_stop, limit=long_tp)
    strategy.exit("ExitShort", "Short", stop=short_stop, limit=short_tp)

// === GUIDELINE 1: FLATTEN AT 16:45 ===
