//@version=5
// Built from: POC Pullback Momentum v2 (poc_pullback_momentum_v2_13.pine), RSI 3system v2 (rsi_3system_v2.pine)
// Indicators: ta.ema, ta.rsi, ta.atr, ta.pivothigh, ta.pivotlow

strategy("POC Momentum Reversal", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv                = input.float(2, "Point Value ($)")
stop_pct          = input.float(0.1, "Stop (% of account)", minval=0.1, maxval=3)
tp_pct            = input.float(1, "Take Profit (% of account)", minval=0.1, maxval=4)
stop_cash         = input.float(0, "Stop ($)", minval=0, maxval=1500)
tp_cash           = input.float(0, "Take Profit ($)", minval=0, maxval=2000)
use_trail         = input.bool(false, "Enable Trailing Stop")
trail_pct         = input.float(50, "Trail: Keep % of Peak Profit")
trail_step_acct   = input.float(1, "Trail: Tighten every % of account")
trail_step_pct    = input.float(50, "Trail: Tighten by X% per step")
trail_min_pct     = input.float(2, "Trail: Min Profit (% of account)")
stop_dollars      = strategy.initial_capital * stop_pct / 100
tp_dollars        = strategy.initial_capital * tp_pct / 100
trail_step_amt    = strategy.initial_capital * trail_step_acct / 100
trail_min_dollars = strategy.initial_capital * trail_min_pct / 100
if stop_cash > 0
    stop_dollars := stop_cash
if tp_cash > 0
    tp_dollars := tp_cash
if strategy.position_size != 0 and not na(stop_dollars)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION =====
use_session   = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0,  "Session Start Minute")
sess_end_hr   = input.int(16,  "Session End Hour (ET)")
sess_end_mn   = input.int(0,  "Session End Minute")
sess_bar_hr = hour(time, "America/New_York")
sess_bar_mn = minute(time, "America/New_York")
sess_bar_t = sess_bar_hr * 100 + sess_bar_mn
sess_clock_start = sess_start_hr * 100 + sess_start_mn
sess_clock_end = sess_end_hr * 100 + sess_end_mn
in_session = not use_session or (sess_clock_start > sess_clock_end ? (sess_bar_t >= sess_clock_start or sess_bar_t < sess_clock_end) : (sess_bar_t >= sess_clock_start and sess_bar_t < sess_clock_end))
if not in_session
    strategy.close_all(comment="Session")

// === RISK ===


// === INPUTS ===
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)
atrLen = input.int(14, "ATR Length", minval=5, maxval=50)
atrMult = input.float(1.5, "ATR Multiplier", minval=0.5, maxval=5.0)
emaLen = input.int(50, "EMA Length", minval=20, maxval=200)
cooldownBars = input.int(50, "Cooldown Bars", minval=10, maxval=200)

// === INDICATORS ===
rsi = ta.rsi(close, rsiLen)
emaVal = ta.ema(close, emaLen)
atrVal = ta.atr(atrLen)

// Pivot Structure
leftBar = 5
rightBar = 5
ph = ta.pivothigh(high, leftBar, rightBar)
pl = ta.pivotlow(low, leftBar, rightBar)

// === LOGIC ===
// Trend Filter: Price above EMA for longs, below for shorts
longTrend = close > emaVal
shortTrend = close < emaVal

// Momentum Reversal Trigger
// Long: Price pulls back to EMA or lower, RSI oversold, then reverses
longTrigger = longTrend and ta.crossover(rsi, 30) and close > ta.lowest(low, 10)[1]
shortTrigger = shortTrend and ta.crossunder(rsi, 70) and close < ta.highest(high, 10)[1]

// Cooldown
var int lastEntryBar = -999
var bool inCooldown = false
if bar_index != lastEntryBar
    inCooldown := false
if inCooldown
    if bar_index - lastEntryBar > cooldownBars
        inCooldown := false

// === EXECUTION ===
if longTrigger and not inCooldown
    if in_session
        strategy.entry("Long", strategy.long)
    lastEntryBar := bar_index
    inCooldown := true

if shortTrigger and not inCooldown
    if in_session
        strategy.entry("Short", strategy.short)
    lastEntryBar := bar_index
    inCooldown := true

// === EXIT ===
// Calculate dynamic stop and target based on current close
longStop = close - stop_dollars / pv
longTarget = close + tp_dollars / pv
shortStop = close + stop_dollars / pv
shortTarget = close - tp_dollars / pv

// Use trailing stop if enabled
if use_trail
    // Simplified trailing logic: if profit > trail_min_dollars, adjust stop to breakeven + trail_pct
    // Note: Pine strategy.exit handles trailing via trail_points or trail_percentage
    // Here we use trail_percentage relative to peak profit
    strategy.exit("ExitLong", "Long", stop=longStop, limit=longTarget, trail_percentage=trail_pct, trail_offset=trail_min_dollars)
    strategy.exit("ExitShort", "Short", stop=shortStop, limit=shortTarget, trail_percentage=trail_pct, trail_offset=trail_min_dollars)
else
    strategy.exit("ExitLong", "Long", stop=longStop, limit=longTarget)
    strategy.exit("ExitShort", "Short", stop=shortStop, limit=shortTarget)

// === GUIDELINE 1: FLATTEN AT 16:45 NY ===
