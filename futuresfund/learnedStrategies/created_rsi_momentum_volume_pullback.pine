//@version=5
// Built from: Delta Volume BOS Night Shift card (volume spike + trend filter + momentum), ta.ema, ta.rsi, ta.sma, ta.mom
strategy("RSI Momentum Volume Pullback", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")

// ===== PARAMETERS =====
ema_len = input.int(50, "EMA Length", minval=10, maxval=200)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)
rsi_long = input.int(35, "RSI Long Level", minval=20, maxval=50)
rsi_short = input.int(65, "RSI Short Level", minval=50, maxval=80)
vol_ma_len = input.int(20, "Volume MA Length", minval=10, maxval=60)
vol_mult = input.float(1.2, "Volume Multiplier", minval=1.0, maxval=3.0, step=0.1)
cooldown_bars = input.int(12, "Cooldown Bars", minval=4, maxval=60)

// ===== SESSION LOGIC =====
hourET = hour(time, "America/New_York")
minET = minute(time, "America/New_York")
startMin = sess_start_hr * 60 + sess_start_mn
endMin = sess_end_hr * 60 + sess_end_mn
curMin = hourET * 60 + minET
in_session = use_session ? (startMin < endMin ? (curMin >= startMin and curMin < endMin) : (curMin >= startMin or curMin < endMin)) : true

// ===== INDICATORS =====
ema_val = ta.ema(close, ema_len)
rsi_val = ta.rsi(close, rsi_len)
vol_ma = ta.sma(volume, vol_ma_len)
vol_spike = volume > vol_ma * vol_mult
mom_val = ta.mom(close, 3)

// ===== ENTRY CONDITIONS =====
long_sig = close > ema_val and ta.crossover(rsi_val, rsi_long) and vol_spike and mom_val > 0
short_sig = close < ema_val and ta.crossunder(rsi_val, rsi_short) and vol_spike and mom_val < 0

// ===== COOLDOWN =====
var int last_entry_bar = -1
cd_ok = bar_index - last_entry_bar >= cooldown_bars

// ===== EXECUTION =====
if in_session and long_sig and cd_ok and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index
if in_session and short_sig and cd_ok and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index

// ===== EXITS =====
if strategy.position_size > 0
    long_stop = close - stop_dollars / pv
    long_limit = close + tp_dollars / pv
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)
if strategy.position_size < 0
    short_stop = close + stop_dollars / pv
    short_limit = close - tp_dollars / pv
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)

// ===== OPEN P&L CHECK =====
if strategy.position_size != 0 and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
