//@version=5
// Built from: Delta Volume BOS Night Shift card (volume confirmation in trend), POC RSI Reversal v4 (RSI timing), indicators: ta.ema, ta.rsi, ta.sma, ta.mom, ta.highest, ta.lowest, ta.crossover, ta.crossunder
strategy("RSI Volume Momentum Pullback", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")
ss = sess_start_hr * 60 + sess_start_mn
se = sess_end_hr * 60 + sess_end_mn
cm = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
in_session = use_session ? (ss < se ? (cm >= ss and cm < se) : (cm >= ss or cm < se)) : true
// ===== PARAMS =====
ema_len = input.int(50, "EMA Length", minval=20, maxval=200)
rsi_len = input.int(14, "RSI Length", minval=7, maxval=30)
rsi_long_th = input.int(40, "RSI Long Th", minval=20, maxval=50)
rsi_short_th = input.int(60, "RSI Short Th", minval=50, maxval=80)
vol_ma_len = input.int(20, "Vol MA Len", minval=10, maxval=50)
mom_len = input.int(5, "Mom Len", minval=3, maxval=15)
hh_len = input.int(10, "HH Lookback", minval=5, maxval=30)
cooldown_bars = input.int(5, "Cooldown Bars", minval=1, maxval=50)
// ===== INDICATORS =====
ema_val = ta.ema(close, ema_len)
rsi_val = ta.rsi(close, rsi_len)
vol_ma = ta.sma(volume, vol_ma_len)
mom_val = ta.mom(close, mom_len)
hh = ta.highest(high, hh_len)
ll = ta.lowest(low, hh_len)
// ===== COOLDOWN =====
var int last_entry_bar = 0
can_trade = bar_index - last_entry_bar >= cooldown_bars
// ===== ENTRIES =====
long_sig = in_session and can_trade and close > ema_val and ta.crossover(rsi_val, rsi_long_th) and volume > vol_ma and mom_val > 0 and close >= hh * 0.999
short_sig = in_session and can_trade and close < ema_val and ta.crossunder(rsi_val, rsi_short_th) and volume > vol_ma and mom_val < 0 and close <= ll * 1.001
if long_sig
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index
    strategy.exit("LX", from_entry="Long", stop=long_stop, limit=long_limit)
if short_sig
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index
    strategy.exit("SX", from_entry="Short", stop=short_stop, limit=short_limit)
// ===== RISK =====
if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
