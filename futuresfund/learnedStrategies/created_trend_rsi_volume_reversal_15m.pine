//@version=5
// Built from: POC RSI Reversal v4 + Delta Volume BOS Night Shift, ta.ema, ta.rsi, ta.sma, ta.crossover, ta.crossunder
strategy("Trend RSI Volume Reversal 15m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(500, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(750, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")
cur_hr = hour(time, "America/New_York")
cur_mn = minute(time, "America/New_York")
in_session = use_session ? (cur_hr >= sess_start_hr or cur_hr < sess_end_hr) : true
ema_len = input.int(20, "EMA Length", minval=5, maxval=200)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=50)
rsi_os = input.int(30, "RSI Oversold", minval=10, maxval=40)
rsi_ob = input.int(70, "RSI Overbought", minval=60, maxval=90)
vol_len = input.int(20, "Volume MA Length", minval=5, maxval=100)
cooldown = input.int(4, "Cooldown Bars", minval=1, maxval=50)
var int last_entry_bar = 0
ema_val = ta.ema(close, ema_len)
rsi_val = ta.rsi(close, rsi_len)
vol_ma = ta.sma(volume, vol_len)
vol_ok = volume > vol_ma
long_sig = in_session and close > ema_val and ta.crossover(rsi_val, rsi_os) and vol_ok and bar_index - last_entry_bar >= cooldown
short_sig = in_session and close < ema_val and ta.crossunder(rsi_val, rsi_ob) and vol_ok and bar_index - last_entry_bar >= cooldown
if long_sig
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)
    last_entry_bar := bar_index
if short_sig
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)
    last_entry_bar := bar_index
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
if strategy.position_size != 0 and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
