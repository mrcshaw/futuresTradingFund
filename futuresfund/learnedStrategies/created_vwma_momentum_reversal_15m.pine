//@version=5
// Built from: Night Session Outside Bar Reversal (short stops, session filter) + POC RSI Reversal (RSI trigger, fixed dollar exits), ta.ema, ta.rsi, ta.mom, ta.crossover, ta.crossunder, math.sum
strategy("VWMA Momentum Reversal 15m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(400, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(750, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")
cur_min = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
start_min = sess_start_hr * 60 + sess_start_mn
end_min = sess_end_hr * 60 + sess_end_mn
in_session = use_session ? (start_min < end_min ? (cur_min >= start_min and cur_min < end_min) : (cur_min >= start_min or cur_min < end_min)) : true
// ===== INDICATORS =====
ema_slow_len = input.int(55, "EMA Slow", minval=20, maxval=200)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)
rsi_ob = input.int(72, "RSI Overbought", minval=50, maxval=90)
rsi_os = input.int(28, "RSI Oversold", minval=10, maxval=50)
mom_len = input.int(3, "Momentum Bars", minval=2, maxval=10)
vwma_len = input.int(28, "VWMA Length", minval=10, maxval=80)
cooldown_bars = input.int(8, "Cooldown Bars", minval=2, maxval=50)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
mom_val = ta.mom(close, mom_len)
vwma_val = math.sum(close * volume, vwma_len) / math.sum(volume, vwma_len)
// ===== ENTRY LOGIC =====
var int last_entry_bar = 0
can_enter = in_session and (bar_index - last_entry_bar >= cooldown_bars)
long_signal = can_enter and close > ema_slow and ta.crossover(rsi_val, rsi_os) and mom_val > 0 and close > vwma_val
short_signal = can_enter and close < ema_slow and ta.crossunder(rsi_val, rsi_ob) and mom_val < 0 and close < vwma_val
if long_signal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)
if short_signal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)
// ===== RISK CHECK =====
if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
