//@version=5
// Built from: Delta Volume BOS Night Shift card + POC RSI Reversal v4 study, ta.vwma, ta.rsi, ta.mom, ta.sma
strategy("VWMA RSI Momentum Shift 15m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")
// ===== PARAMETERS =====
vwma_len = input.int(28, "VWMA Length", minval=10, maxval=100)
rsi_len = input.int(14, "RSI Length", minval=7, maxval=30)
rsi_buy = input.int(35, "RSI Buy Level", minval=20, maxval=50)
rsi_sell = input.int(65, "RSI Sell Level", minval=50, maxval=80)
mom_len = input.int(5, "Momentum Length", minval=3, maxval=20)
cooldown_bars = input.int(12, "Cooldown Bars", minval=4, maxval=100)
// ===== SESSION LOGIC =====
cur_tm = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
start_tm = sess_start_hr * 60 + sess_start_mn
end_tm = sess_end_hr * 60 + sess_end_mn
in_session = use_session ? (start_tm < end_tm ? (cur_tm >= start_tm and cur_tm < end_tm) : (cur_tm >= start_tm or cur_tm < end_tm)) : true
// ===== INDICATORS =====
vwma_val = ta.vwma(close, vwma_len)
rsi_val = ta.rsi(close, rsi_len)
mom_val = ta.mom(close, mom_len)
vol_avg = ta.sma(volume, 20)
// ===== ENTRY CONDITIONS =====
long_sig = close > vwma_val and rsi_val > rsi_buy and rsi_val[1] <= rsi_buy and mom_val > 0 and volume > vol_avg
short_sig = close < vwma_val and rsi_val < rsi_sell and rsi_val[1] >= rsi_sell and mom_val < 0 and volume > vol_avg
// ===== COOLDOWN =====
var int last_entry_bar = 0
can_trade = bar_index - last_entry_bar >= cooldown_bars
// ===== EXECUTION =====
if in_session and can_trade and long_sig and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)
if in_session and can_trade and short_sig and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)
// ===== STOP CHECK =====
if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
