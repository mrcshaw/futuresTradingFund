//@version=5
// Built from: Delta Volume BOS + POC RSI Reversal (VWMA trend + RSI trigger + volume confirmation), ta.rsi, math.sum, ta.sma, ta.crossover, ta.crossunder
strategy("VWMA RSI Momentum Shift", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")

long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")

// ===== INDICATORS =====
vwma_len = input.int(20, "VWMA Length", minval=5, maxval=100)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=50)
rsi_buy = input.int(30, "RSI Buy Level", minval=10, maxval=40)
rsi_sell = input.int(70, "RSI Sell Level", minval=60, maxval=90)
vol_sma_len = input.int(20, "Volume SMA Length", minval=5, maxval=100)
cooldown_bars = input.int(6, "Cooldown Bars", minval=1, maxval=50)

vwma = math.sum(close * volume, vwma_len) / math.sum(volume, vwma_len)
rsi_val = ta.rsi(close, rsi_len)
vol_sma = ta.sma(volume, vol_sma_len)

// ===== SESSION LOGIC =====
et_hour = hour(time, "America/New_York")
et_min = minute(time, "America/New_York")
in_session = use_session ? (et_hour >= sess_start_hr or et_hour < sess_end_hr) : true

// ===== COOLDOWN =====
var int last_entry_bar = -9999
can_trade = (bar_index - last_entry_bar) >= cooldown_bars

// ===== ENTRY CONDITIONS =====
long_cond = close > vwma and ta.crossover(rsi_val, rsi_buy) and volume > vol_sma and in_session and can_trade
short_cond = close < vwma and ta.crossunder(rsi_val, rsi_sell) and volume > vol_sma and in_session and can_trade

// ===== ENTRIES =====
if long_cond
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index

if short_cond
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index

// ===== EXITS =====
if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)

if strategy.position_size < 0
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)

// ===== OPEN P&L GUARD =====
if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
