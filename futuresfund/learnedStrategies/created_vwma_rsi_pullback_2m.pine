//@version=5
// Built from: POC RSI Reversal (lower ATR mult cut drawdown) + Delta Volume BOS (VWMA trend), ta.ema, ta.rsi, ta.crossover, ta.crossunder, ta.sma
strategy("VWMA RSI Pullback 2m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(500, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(750, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")
sess_start = sess_start_hr * 60 + sess_start_mn
sess_end = sess_end_hr * 60 + sess_end_mn
cur_min = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
in_session = use_session ? (sess_start < sess_end ? (cur_min >= sess_start and cur_min < sess_end) : (cur_min >= sess_start or cur_min < sess_end)) : true
// ===== INDICATORS =====
ema_fast_len = input.int(50, "EMA Fast Length", minval=10, maxval=200)
ema_slow_len = input.int(200, "EMA Slow Length", minval=50, maxval=400)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)
rsi_oversold = input.int(35, "RSI Oversold", minval=20, maxval=45)
rsi_overbought = input.int(65, "RSI Overbought", minval=55, maxval=80)
vol_ma_len = input.int(20, "Volume MA Length", minval=5, maxval=50)
cooldown_bars = input.int(8, "Cooldown Bars", minval=2, maxval=50)
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi = ta.rsi(close, rsi_len)
vol_ma = ta.sma(volume, vol_ma_len)
// ===== SIGNALS =====
long_trend = close > ema_slow and close > ema_fast
short_trend = close < ema_slow and close < ema_fast
long_trigger = ta.crossover(rsi, rsi_oversold) and volume > vol_ma
short_trigger = ta.crossunder(rsi, rsi_overbought) and volume > vol_ma
var int last_entry_bar = 0
can_trade = bar_index - last_entry_bar >= cooldown_bars
// ===== ENTRIES =====
if in_session and can_trade and long_trend and long_trigger
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)
if in_session and can_trade and short_trend and short_trigger
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)
// ===== STOP CHECK =====
if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
