//@version=5
strategy("Hull MA Cross", overlay=true,
  initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=5.50,
  slippage=1, pyramiding=0, process_orders_on_close=true)
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv

// ===== RISK =====
pv                = input.float(2, "Point Value ($)")
stop_dollars      = input.int(750, "Stop ($)", minval=250, maxval=1500)
tp_dollars        = input.int(1250, "Take Profit ($)", minval=250, maxval=2000)
use_trail         = input.bool(false, "Enable Trailing Stop")
trail_step_amt    = input.int(500, "Trail: Tighten every ($)", minval=0, maxval=2000)
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)", minval=0, maxval=2000)

if strategy.position_size != 0 and not na(stop_dollars)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")
    if strategy.openprofit >= tp_dollars
        strategy.close_all(comment="TP")

// ===== SESSION =====
use_session   = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0,  "Session Start Minute")
sess_end_hr   = input.int(16,  "Session End Hour (ET)")
sess_end_mn   = input.int(0,  "Session End Minute")
sess_bar_hr = hour(time, "America/New_York")
sess_bar_mn = minute(time, "America/New_York")
sess_bar_t = sess_bar_hr * 100 + sess_bar_mn
sess_clock_start = sess_start_hr * 100 + sess_start_mn
sess_clock_end   = sess_end_hr * 100 + sess_end_mn
in_session = not use_session or (sess_clock_start > sess_clock_end ? (sess_bar_t >= sess_clock_start or sess_bar_t < sess_clock_end) : (sess_bar_t >= sess_clock_start and sess_bar_t < sess_clock_end))
if not in_session
    strategy.close_all(comment="Session")

// Long only. RSI crossing above level is the trigger on closed 4-hour bars. Daily regression slope is the filter.
// The chart may be 2, 5, or 15 minutes. A trade still open at 16:45 New York is closed.

fastLen  = input.int(4,  "Fast Hull", minval=2, maxval=200)
slowLen  = input.int(100, "Slow Hull", minval=2, maxval=400)
rsiLen   = input.int(14, "RSI length", minval=2, maxval=100)
rsiLevel = input.float(50.0, "RSI above", minval=1, maxval=99)
regLen   = input.int(20, "Daily regression length", minval=2, maxval=200)
maxLoss  = input.float(1800.0, "Max loss per trade", minval=1, maxval=1800)

rsi4   = request.security(syminfo.tickerid, "240", ta.rsi(close, rsiLen), lookahead=barmerge.lookahead_off)
regime = request.security(syminfo.tickerid, "D",  ta.linreg(close, regLen, 0), lookahead=barmerge.lookahead_off)

rsiCrossUp = ta.crossover(rsi4, rsiLevel)

// desk indicator ta.sma
_desk_gate = ta.sma(close, 50)
_desk_long = close > _desk_gate
if rsiCrossUp and close > regime and in_session and strategy.position_size == 0 and _desk_long
    strategy.entry("Long", strategy.long)
    strategy.exit("Stop", from_entry="Long", stop=long_stop, limit=long_limit)

if ta.crossunder(rsi4, rsiLevel) and strategy.position_size > 0
    strategy.close("Long", comment="RSI exit")
