//@version=5
// Smart Trail NO CONDITIONS — ES Evening Session 2min
// Entry on trend flip; risk management: stop, TP, trail. OzzyBacktestEngine for long-only verification.
// Add OzzyBacktestEngine library: https://www.tradingview.com/script/y4wMeSpt-Replica-of-TradingView-s-Backtesting-Engine-with-Arrays/
strategy("Smart Trail NO CONDITIONS ES Evening", overlay=true,
  initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=5.50,
  slippage=3, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false)

// ===== SMART TRAIL (from NO CONDITIONS indicator) =====
length      = input.int(14, "Smart Trail Length", minval=1, maxval=100)
multiplier  = input.float(2.0, "Smart Trail Multiplier", minval=0.1, maxval=10.0, step=0.1)
source      = input.source(close, "Smart Trail Source")
sensitivity = input.int(3, "Smart Trail Sensitivity (1-5)", minval=1, maxval=5)

// ===== SESSION (ES Evening 18-9 ET) =====
use_session   = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0,  "Session Start Minute")
sess_end_hr   = input.int(9,  "Session End Hour (ET)")
sess_end_mn   = input.int(0,  "Session End Minute")

// ===== RISK =====
pv                = input.float(50.0, "Point Value ($)")
stop_dollars      = input.float(300.0, "Stop ($)")
tp_dollars        = input.float(500.0, "Take Profit ($)")
use_trail         = input.bool(false, "Enable Trailing Stop")
trail_pct         = input.float(75.0, "Trail: Keep % of Peak Profit")
trail_step_amt    = input.float(100.0, "Trail: Tighten every $X profit")
trail_step_pct    = input.float(80.0, "Trail: Tighten by X% per step")
trail_min_dollars = input.float(200.0, "Trail: Min Profit Before Trailing ($)")

// ===== REVERSAL ON STOP =====
use_reversal     = input.bool(true, "Reverse on Stop-Out", group="Reversal")
rev_stop_dollars = input.float(300.0, "Reversal Stop ($)", minval=50, group="Reversal")
rev_tp_dollars   = input.float(500.0, "Reversal TP ($)", minval=50, group="Reversal")

// ===== OZZY BACKTEST ENGINE (long-only) =====
use_ozzy    = input.bool(true, "Show Ozzy Backtest Table (Long Only)", group="OzzyBacktest")
start_qty   = input.float(25000.0, "Start Capital ($)", group="OzzyBacktest")
trade_qty   = input.float(250000.0, "Trade Notional ($)", group="OzzyBacktest", tooltip="For 1 ES: ~50 * price. ES 5000 => 250000.")

// ===== COMPUTED =====
float stop_pts     = stop_dollars / pv
float tp_pts       = tp_dollars / pv
float rev_stop_pts = rev_stop_dollars / pv
float rev_tp_pts   = rev_tp_dollars / pv

// ===== SESSION =====
bar_hr = hour(time, "America/New_York")
bar_mn = minute(time, "America/New_York")
bar_t  = bar_hr * 100 + bar_mn
int s_start = sess_start_hr * 100 + sess_start_mn
int s_end   = sess_end_hr * 100 + sess_end_mn

bool in_session = not use_session or (s_start > s_end ? (bar_t >= s_start or bar_t < s_end) : (bar_t >= s_start and bar_t < s_end))

prev_hr = hour(time[1], "America/New_York")
prev_mn = minute(time[1], "America/New_York")
prev_t  = prev_hr * 100 + prev_mn
bool was_in_session = not use_session or (s_start > s_end ? (prev_t >= s_start or prev_t < s_end) : (prev_t >= s_start and prev_t < s_end))
bool session_ended = was_in_session and not in_session

if session_ended and strategy.position_size != 0
    strategy.close_all(comment="Session Close")

// ===== SMART TRAIL (exact logic from NO CONDITIONS indicator) =====
atr_val = ta.atr(length)
volatility_factor = atr_val * multiplier * (sensitivity / 3.0)
basic_up   = source - volatility_factor
basic_down = source + volatility_factor

var float trail_up   = na
var float trail_down = na
var int   smart_trend = 1

trail_up   := source > nz(trail_up[1]) and source[1] > nz(trail_up[1]) ? math.max(nz(trail_up[1]), basic_up) : basic_up
trail_down := source < nz(trail_down[1]) and source[1] < nz(trail_down[1]) ? math.min(nz(trail_down[1]), basic_down) : basic_down

smart_trend := source > nz(trail_down[1]) ? 1 : source < nz(trail_up[1]) ? -1 : nz(smart_trend[1], 1)

float smart_trail_value = smart_trend == 1 ? trail_up : trail_down
bool  smart_trend_changed = smart_trend != nz(smart_trend[1]) and bar_index > 1

// ===== SIGNALS =====
smartTrailBull = smart_trend_changed and smart_trend == 1
smartTrailBear = smart_trend_changed and smart_trend == -1

// ===== ENTRIES =====
var float current_stop    = 0.0
var float peak_profit_pts = 0.0
var float entry_price     = 0.0
var int   last_dir        = 0
var bool  is_reversal     = false
var bool  reversal_pending = false

bool long_ok  = smartTrailBull and in_session and strategy.position_size <= 0
bool short_ok = smartTrailBear and in_session and strategy.position_size >= 0

if long_ok
    entry_price     := close
    current_stop    := close - stop_pts
    peak_profit_pts := 0.0
    last_dir        := 1
    is_reversal     := false
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=current_stop, limit=entry_price + tp_pts)
else if short_ok
    entry_price     := close
    current_stop    := close + stop_pts
    peak_profit_pts := 0.0
    last_dir        := -1
    is_reversal     := false
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", stop=current_stop, limit=entry_price - tp_pts)

// ===== STOP-OUT -> REVERSAL =====
if strategy.position_size == 0 and strategy.position_size[1] != 0
    if not is_reversal and last_dir != 0
        int idx = strategy.closedtrades - 1
        if idx >= 0 and strategy.closedtrades.profit(idx) < 0
            reversal_pending := true
    peak_profit_pts := 0.0
    is_reversal     := false

if use_reversal and reversal_pending and strategy.position_size == 0 and in_session
    reversal_pending := false
    is_reversal      := true
    peak_profit_pts  := 0.0
    if last_dir == 1
        current_stop := close + rev_stop_pts
        last_dir     := -1
        strategy.entry("RevShort", strategy.short)
        strategy.exit("XRS", "RevShort", stop=current_stop, limit=close - rev_tp_pts)
    else if last_dir == -1
        current_stop := close - rev_stop_pts
        last_dir     := 1
        strategy.entry("RevLong", strategy.long)
        strategy.exit("XRL", "RevLong", stop=current_stop, limit=close + rev_tp_pts)

// ===== TRAILING STOP =====
if use_trail and strategy.position_size != 0
    float avg = strategy.position_avg_price
    if strategy.position_size > 0
        float profit_now = high - avg
        if profit_now > peak_profit_pts
            peak_profit_pts := profit_now
        if peak_profit_pts >= trail_min_dollars / pv
            float peak_dollars = peak_profit_pts * pv
            int   steps        = math.floor(peak_dollars / trail_step_amt)
            float keep_pct     = math.min(trail_pct + steps * trail_step_pct, 95.0)
            float new_stop     = avg + peak_profit_pts * (keep_pct / 100.0)
            if new_stop > current_stop
                current_stop := new_stop
                strategy.exit("XL", "Long", stop=current_stop, limit=avg + tp_pts)
    else
        float profit_now = avg - low
        if profit_now > peak_profit_pts
            peak_profit_pts := profit_now
        if peak_profit_pts >= trail_min_dollars / pv
            float peak_dollars = peak_profit_pts * pv
            int   steps        = math.floor(peak_dollars / trail_step_amt)
            float keep_pct     = math.min(trail_pct + steps * trail_step_pct, 95.0)
            float new_stop     = avg - peak_profit_pts * (keep_pct / 100.0)
            if new_stop < current_stop
                current_stop := new_stop
                strategy.exit("XS", "Short", stop=current_stop, limit=avg - tp_pts)

// ===== OZZY BACKTEST ENGINE (long-only) =====
// Add library: https://www.tradingview.com/script/y4wMeSpt-Replica-of-TradingView-s-Backtesting-Engine-with-Arrays/
// Then uncomment the import and _backtest call below, and remove/comment the fallback table.
var float ozzy_entry = na
var bool  ozzy_in_long = false

enterLong = smartTrailBull and in_session
if enterLong[1] and not ozzy_in_long
    ozzy_in_long := true
    ozzy_entry   := open

exitLong = ozzy_in_long and (smartTrailBear or low <= ozzy_entry - stop_pts or high >= ozzy_entry + tp_pts)
if exitLong
    ozzy_in_long := false
    ozzy_entry   := na

// Uncomment after adding OzzyBacktestEngine library to use:
// import OztheWoz/Replica-of-TradingView-s-Backtesting-Engine-with-Arrays/1 as Ozzy
// [netProfit, netPct, tradeAmt, pctProf, pf, maxDD, maxDDPct, avgTr, avgTrPct] = Ozzy._backtest(enterLong, exitLong, start_qty, trade_qty)

var table ozzy_table = table.new(position.top_right, 3, 10, bgcolor=color.new(#1e1e1e, 15), border_width=1)
if use_ozzy
    table.cell(ozzy_table, 0, 0, "OzzyBacktest (Long Only)", text_color=color.yellow, text_size=size.small)
    table.cell(ozzy_table, 0, 1, "Add library:", text_color=color.gray, text_size=size.tiny)
    table.cell(ozzy_table, 0, 2, "TradingView → y4wMeSpt", text_color=color.gray, text_size=size.tiny)
    table.cell(ozzy_table, 0, 3, "Uncomment import +", text_color=color.gray, text_size=size.tiny)
    table.cell(ozzy_table, 0, 4, "_backtest() in script", text_color=color.gray, text_size=size.tiny)

// ===== PLOT =====
trail_color = smart_trend == 1 ? color.new(color.lime, 0) : color.new(color.red, 0)
plot(smart_trail_value, "Smart Trail", color=trail_color, linewidth=2)

bullish = close > smart_trail_value and smart_trend == 1
bearish = close < smart_trail_value and smart_trend == -1
candleColor = bullish ? color.new(color.green, 20) : bearish ? color.new(color.red, 20) : color.new(color.gray, 40)
barcolor(candleColor)

plotshape(smartTrailBull, "Bull Signal", shape.diamond, location.belowbar, color.new(color.lime, 30), size=size.small)
plotshape(smartTrailBear, "Bear Signal", shape.diamond, location.abovebar, color.new(color.red, 30), size=size.small)
plotshape(long_ok, "Long Entry", shape.arrowup, location.belowbar, color.lime, size=size.tiny)
plotshape(short_ok, "Short Entry", shape.arrowdown, location.abovebar, color.red, size=size.tiny)

bool rev_long  = is_reversal and strategy.position_size > 0 and strategy.position_size[1] == 0
bool rev_short = is_reversal and strategy.position_size < 0 and strategy.position_size[1] == 0
plotshape(rev_long, "Rev Long", shape.arrowup, location.belowbar, color.orange, size=size.tiny)
plotshape(rev_short, "Rev Short", shape.arrowdown, location.abovebar, color.orange, size=size.tiny)
