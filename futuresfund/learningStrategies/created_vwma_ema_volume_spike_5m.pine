//@version=5
// Built from: Delta Volume BOS Night Shift card (VWMA + volume spike + session timing), EMA trend filter, RSI confirmation. Indicators: ta.ema, ta.rsi, ta.sma, ta.crossover, ta.crossunder, math.sum.
strategy("VWMA EMA Volume Spike 5m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(50, "Point Value ($)")
stop_dollars = input.int(500, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(750, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")
h = hour(time, "America/New_York")
m = minute(time, "America/New_York")
in_session = use_session ? (h >= sess_start_hr or h < sess_end_hr) : true

// ===== COOLDOWN =====
cooldown_bars = input.int(12, "Cooldown (bars)", minval=4, maxval=60)
var int last_entry_bar = -9999

// ===== INDICATORS =====
ema_len = input.int(50, "EMA Length", minval=20, maxval=200)
vwma_len = input.int(20, "VWMA Length", minval=10, maxval=50)
vol_ma_len = input.int(20, "Volume MA Length", minval=10, maxval=50)
rsi_len = input.int(14, "RSI Length", minval=7, maxval=30)
rsi_long_max = input.int(65, "RSI Long Max", minval=50, maxval=80)
rsi_short_min = input.int(35, "RSI Short Min", minval=20, maxval=50)
ema_val = ta.ema(close, ema_len)
vwma_val = math.sum(close * volume, vwma_len) / math.sum(volume, vwma_len)
vol_ma = ta.sma(volume, vol_ma_len)
rsi_val = ta.rsi(close, rsi_len)

// ===== ENTRY CONDITIONS =====
long_trend = close > ema_val
long_trigger = ta.crossover(vwma_val, close)
long_vol = volume > vol_ma * 1.5
long_rsi = rsi_val < rsi_long_max
short_trend = close < ema_val
short_trigger = ta.crossunder(vwma_val, close)
short_vol = volume > vol_ma * 1.5
short_rsi = rsi_val > rsi_short_min

// ===== EXECUTION =====
can_trade = in_session and (bar_index - last_entry_bar >= cooldown_bars)
if can_trade and long_trend and long_trigger and long_vol and long_rsi and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index
    strategy.exit("LX", from_entry="Long", stop=long_stop, limit=long_limit)
if can_trade and short_trend and short_trigger and short_vol and short_rsi and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index
    strategy.exit("SX", from_entry="Short", stop=short_stop, limit=short_limit)

// ===== FLAT AT SESSION END =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
if strategy.position_size != 0 and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
