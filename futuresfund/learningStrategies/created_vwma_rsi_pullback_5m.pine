//@version=5
// Built from: Card "Delta Volume BOS Night Shift" (vwma_len ~28, vol_ma_len ~48) + POC RSI Reversal (RSI pullback in trend), indicators: ta.rsi, ta.ema, math.sum
strategy("VWMA RSI Pullback 5m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")
// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")
h = hour(time, "America/New_York")
m = minute(time, "America/New_York")
in_session = use_session ? (h >= sess_start_hr or h < sess_end_hr) : true
// ===== PARAMETERS =====
vwma_len = input.int(28, "VWMA Length", minval=10, maxval=100)
rsi_len = input.int(14, "RSI Length", minval=7, maxval=30)
vol_ma_len = input.int(48, "Volume MA Length", minval=20, maxval=100)
rsi_buy = input.int(38, "RSI Buy Threshold", minval=20, maxval=50)
rsi_sell = input.int(62, "RSI Sell Threshold", minval=50, maxval=80)
cooldown_bars = input.int(4, "Cooldown Bars", minval=1, maxval=20)
// ===== INDICATORS =====
vol_sum = math.sum(volume, vwma_len)
price_sum = math.sum(close * volume, vwma_len)
vwma = vol_sum > 0 ? price_sum / vol_sum : close
rsi_val = ta.rsi(close, rsi_len)
vol_ma = ta.ema(volume, vol_ma_len)
// ===== ENTRY LOGIC =====
var int last_entry_bar = 0
long_cond = close > vwma and ta.crossover(rsi_val, rsi_buy) and volume > vol_ma
short_cond = close < vwma and ta.crossunder(rsi_val, rsi_sell) and volume > vol_ma
can_enter = in_session and bar_index - last_entry_bar >= cooldown_bars
if can_enter and long_cond and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index
if can_enter and short_cond and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index
// ===== EXITS =====
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)
if strategy.position_size < 0
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)
// ===== OPEN P&L CHECK =====
if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
// ===== 16:45 HARD FLATTEN =====
if h == 16 and m >= 45 and strategy.position_size != 0
    strategy.close_all(comment="1645 Flatten")
