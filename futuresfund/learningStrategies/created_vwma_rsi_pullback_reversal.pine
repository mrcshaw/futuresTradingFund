//@version=5
// Built from: VWMA slope + RSI pullback (delta_volume_breakout_night card, poc_rsi_reversal_v4), math.sum, ta.rsi, ta.crossover, ta.crossunder
strategy("VWMA RSI Pullback Reversal", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(500, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(750, "Take Profit ($)", minval=250, maxval=2000)
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")
vwma_len = input.int(20, "VWMA Length", minval=5, maxval=100)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)
rsi_os = input.int(35, "RSI Oversold", minval=20, maxval=45)
rsi_ob = input.int(65, "RSI Overbought", minval=55, maxval=80)
slope_bars = input.int(3, "Slope Bars", minval=2, maxval=10)
cooldown_bars = input.int(12, "Cooldown Bars", minval=4, maxval=60)
hr = hour(time, "America/New_York")
mn = minute(time, "America/New_York")
t = hr * 60 + mn
st = sess_start_hr * 60 + sess_start_mn
et = sess_end_hr * 60 + sess_end_mn
in_session = use_session ? (st < et ? (t >= st and t < et) : (t >= st or t < et)) : true
vwma = math.sum(close * volume, vwma_len) / math.sum(volume, vwma_len)
slope = vwma - vwma[slope_bars]
rsi_val = ta.rsi(close, rsi_len)
long_sig = slope > 0 and ta.crossover(rsi_val, rsi_os) and close < vwma
short_sig = slope < 0 and ta.crossunder(rsi_val, rsi_ob) and close > vwma
var int last_bar = 0
ok = bar_index - last_bar >= cooldown_bars
if in_session and ok and strategy.position_size == 0
    if long_sig
        strategy.entry("Long", strategy.long)
        last_bar := bar_index
    else if short_sig
        strategy.entry("Short", strategy.short)
        last_bar := bar_index
if strategy.position_size > 0
    strategy.exit("LX", from_entry="Long", stop=long_stop, limit=long_limit)
if strategy.position_size < 0
    strategy.exit("SX", from_entry="Short", stop=short_stop, limit=short_limit)
if strategy.position_size != 0 and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
