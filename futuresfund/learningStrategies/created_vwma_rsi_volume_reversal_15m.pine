//@version=5
// Built from: Delta Volume BOS + POC RSI Reversal lessons, VWMA/EMA/RSI/volume indicators
strategy("VWMA RSI Volume Reversal 15m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")

// ===== INDICATORS =====
vwma_len = input.int(27, "VWMA Length", minval=10, maxval=100)
ema_len = input.int(55, "EMA Length", minval=20, maxval=200)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)
rsi_lo = input.int(30, "RSI Long Trigger", minval=10, maxval=40)
rsi_hi = input.int(70, "RSI Short Trigger", minval=60, maxval=90)
vol_ma_len = input.int(40, "Volume MA Length", minval=10, maxval=100)
cooldown_bars = input.int(8, "Cooldown Bars", minval=1, maxval=50)

// ===== SESSION LOGIC =====
hm = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
start_hm = sess_start_hr * 60 + sess_start_mn
end_hm = sess_end_hr * 60 + sess_end_mn
in_session = use_session ? (start_hm < end_hm ? hm >= start_hm and hm < end_hm : hm >= start_hm or hm < end_hm) : true

// ===== INDICATOR VALUES =====
vwma_val = ta.vwma(close, vwma_len)
ema_val = ta.ema(close, ema_len)
rsi_val = ta.rsi(close, rsi_len)
vol_ma = ta.sma(volume, vol_ma_len)

// ===== ENTRY CONDITIONS =====
long_trend = close > vwma_val and close > ema_val
short_trend = close < vwma_val and close < ema_val
long_trigger = ta.crossover(rsi_val, rsi_lo)
short_trigger = ta.crossunder(rsi_val, rsi_hi)
vol_confirm = volume > vol_ma

// ===== COOLDOWN =====
var int last_entry_bar = 0
can_trade = bar_index - last_entry_bar >= cooldown_bars

// ===== ENTRIES =====
if in_session and long_trend and long_trigger and vol_confirm and can_trade and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index
if in_session and short_trend and short_trigger and vol_confirm and can_trade and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index

// ===== EXITS =====
if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)
if strategy.position_size < 0
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)

// ===== RISK CHECK =====
if strategy.position_size != 0 and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
