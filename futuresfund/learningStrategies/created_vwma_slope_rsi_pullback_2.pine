//@version=5
// Built from: VWMA slope trend + RSI mean-reversion pullback, ta.vwma, ta.rsi, ta.highest, ta.lowest, ta.crossover, ta.crossunder
strategy("VWMA Slope RSI Pullback", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv
// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")
// ===== INDICATORS =====
vwma_len = input.int(20, "VWMA Length", minval=5, maxval=100)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)
rsi_ob = input.int(70, "RSI Overbought", minval=50, maxval=90)
rsi_os = input.int(30, "RSI Oversold", minval=10, maxval=50)
swing_len = input.int(10, "Swing Lookback", minval=5, maxval=50)
cooldown_bars = input.int(5, "Cooldown Bars", minval=1, maxval=50)
vwma = ta.vwma(close, vwma_len)
rsi = ta.rsi(close, rsi_len)
hi = ta.highest(high, swing_len)
lo = ta.lowest(low, swing_len)
// Session
t = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
start_t = sess_start_hr * 60 + sess_start_mn
end_t = sess_end_hr * 60 + sess_end_mn
in_session = use_session ? (start_t < end_t ? (t >= start_t and t < end_t) : (t >= start_t or t < end_t)) : true
// Cooldown
var int last_entry_bar = -1
can_trade = bar_index - last_entry_bar >= cooldown_bars
// Long: trend up + RSI exits oversold + pullback to recent low
long_sig = in_session and can_trade and close > vwma and ta.crossover(rsi, rsi_os) and low <= lo[1]
// Short: trend down + RSI exits overbought + pullback to recent high
short_sig = in_session and can_trade and close < vwma and ta.crossunder(rsi, rsi_ob) and high >= hi[1]
if long_sig and strategy.position_size <= 0
    strategy.entry("L", strategy.long)
    last_entry_bar := bar_index
if short_sig and strategy.position_size >= 0
    strategy.entry("S", strategy.short)
    last_entry_bar := bar_index
if strategy.position_size > 0
    strategy.exit("XL", from_entry="L", stop=long_stop, limit=long_limit)
if strategy.position_size < 0
    strategy.exit("XS", from_entry="S", stop=long_stop, limit=long_limit)
if strategy.position_size != 0 and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
