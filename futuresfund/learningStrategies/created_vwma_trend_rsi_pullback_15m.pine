//@version=5
// Built from: Delta Volume BOS Night (vwma_len ~28, vol_ma_len ~54) + POC RSI Reversal (RSI trigger), EMA trend filter, VWMA volume confirmation
strategy("VWMA Trend RSI Pullback 15m", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(2, "Point Value ($)")
stop_dollars = input.int(500, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(750, "Take Profit ($)", minval=250, maxval=2000)
use_trail = input.bool(false, "Enable Trailing Stop")
trail_step_amt = input.int(500, "Trail: Tighten every ($)")
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)")

long_stop = close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = close + stop_dollars / pv
short_limit = close - tp_dollars / pv

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")

cur_hr = hour(time, "America/New_York")
cur_mn = minute(time, "America/New_York")
cur_tm = cur_hr * 60 + cur_mn
start_tm = sess_start_hr * 60 + sess_start_mn
end_tm = sess_end_hr * 60 + sess_end_mn
in_session = use_session ? (start_tm <= end_tm ? (cur_tm >= start_tm and cur_tm < end_tm) : (cur_tm >= start_tm or cur_tm < end_tm)) : true

// ===== INDICATORS =====
ema_len = input.int(50, "EMA Length", minval=10, maxval=200)
vwma_len = input.int(28, "VWMA Length", minval=10, maxval=100)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)
rsi_oversold = input.int(35, "RSI Oversold", minval=20, maxval=45)
rsi_overbought = input.int(65, "RSI Overbought", minval=55, maxval=80)
cooldown_bars = input.int(4, "Cooldown Bars", minval=2, maxval=20)

ema_val = ta.ema(close, ema_len)
vwma_val = math.sum(close * volume, vwma_len) / math.sum(volume, vwma_len)
rsi_val = ta.rsi(close, rsi_len)

// ===== COOLDOWN =====
var int last_entry_bar = -999
bars_since_entry = bar_index - last_entry_bar

// ===== ENTRY LOGIC =====
long_signal = in_session and bars_since_entry >= cooldown_bars and close > ema_val and close > vwma_val and ta.crossover(rsi_val, rsi_oversold)
short_signal = in_session and bars_since_entry >= cooldown_bars and close < ema_val and close < vwma_val and ta.crossunder(rsi_val, rsi_overbought)

if long_signal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index
    strategy.exit("Long Exit", from_entry="Long", stop=long_stop, limit=long_limit)

if short_signal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index
    strategy.exit("Short Exit", from_entry="Short", stop=short_stop, limit=short_limit)

// ===== RISK CHECK =====
if strategy.position_size != 0 and not na(stop_dollars) and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
