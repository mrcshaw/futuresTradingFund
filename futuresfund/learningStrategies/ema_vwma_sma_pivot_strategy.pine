//@version=5
strategy("EMA 200 + EMA 55 + SMA 25 Pivot Structure", overlay=true,
  initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=5.50,
  slippage=1, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false,
  max_bars_back=5000, max_labels_count=500)

// 200 EMA + 55 EMA + 25 SMA — trade only in the direction of the 55 EMA
// Long: 25 SMA crosses above 55 EMA AND higher highs AND 55 EMA slope > min
// Short: 25 SMA crosses below 55 EMA AND lower lows AND 55 EMA slope < -min

// ===== INDICATORS =====
ema_len  = input.int(200, "200 EMA Length", minval=1, group="Indicators")
ema55_len = input.int(55, "55 EMA Length", minval=1, group="Indicators")
sma_len  = input.int(25, "25 SMA Length", minval=1, group="Indicators")
ema55_slope_len = input.int(5, "55 EMA Slope Lookback", minval=1, maxval=20, group="Indicators", tooltip="Bars to measure 55 EMA slope.")
min_slope = input.float(0.0, "Min 55 EMA Slope (pts)", minval=0.0, step=0.5, group="Indicators", tooltip="Long: slope > this. Short: slope < -this. 0 = any rise/fall.")

// ===== PIVOT (same as Pivot Points High Low indicator) =====
leftLenH  = input.int(title="Pivot High", defval=7, minval=1, inline="Pivot High", group="Pivot")
rightLenH = input.int(title="/", defval=7, minval=1, inline="Pivot High", group="Pivot")
leftLenL  = input.int(title="Pivot Low", defval=7, minval=1, inline="Pivot Low", group="Pivot")
rightLenL = input.int(title="/", defval=7, minval=1, inline="Pivot Low", group="Pivot")

// ===== SESSION — Night 18:00–8:00 ET =====
use_session   = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0,  "Session Start Minute")
sess_end_hr   = input.int(8,  "Session End Hour (ET)")
sess_end_mn   = input.int(0,  "Session End Minute")

// ===== CROSSOVER CONFIRMATION =====
cross_confirm_bars = input.int(1, "Cross Confirm Bars", minval=1, maxval=10, step=1, group="Cross Filter", tooltip="SMA must stay on correct side of EMA for this many bars after the initial cross.")
cross_min_gap      = input.float(0.0, "Cross Min Gap (pts)", minval=0.0, step=0.25, group="Cross Filter", tooltip="SMA must be at least this far from EMA to confirm. 0 = any separation.")

// ===== FILTERS =====
cooldown_bars  = input.int(5, "Cooldown (bars)", minval=0, maxval=100, step=1)

// ===== RISK =====
pv           = input.float(50.0, "Point Value ($)")
stop_dollars = input.float(600.0, "Stop ($)")
tp_dollars   = input.float(1500.0, "Take Profit ($)")
use_trail    = input.bool(false, "Enable Trailing Stop", group="Trailing")
trail_pct    = input.float(50.0, "Trail: Keep % of Peak Profit", minval=10, maxval=90, group="Trailing")
trail_step_amt = input.float(500.0, "Trail: Tighten every $X profit", minval=100, group="Trailing")
trail_step_pct = input.float(5.0, "Trail: Tighten by X% per step", minval=1, maxval=20, group="Trailing")
trail_min_dollars = input.float(300.0, "Trail: Min Profit Before Trailing ($)", minval=50, group="Trailing")
use_breakeven = input.bool(false, "Enable Breakeven", group="Breakeven")
be_trigger_dollars = input.float(150.0, "BE Trigger ($)", minval=50, group="Breakeven")

float stop_pts = stop_dollars / pv
float tp_pts   = tp_dollars / pv
float be_trigger_pts = be_trigger_dollars / pv

// ===== SESSION LOGIC =====
bar_hr = hour(time, "America/New_York")
bar_mn = minute(time, "America/New_York")
bar_t  = bar_hr * 100 + bar_mn
int s_start = sess_start_hr * 100 + sess_start_mn
int s_end   = sess_end_hr * 100 + sess_end_mn
bool in_session = not use_session or (s_start > s_end ? (bar_t >= s_start or bar_t < s_end) : (bar_t >= s_start and bar_t < s_end))

prev_hr = hour(time[1], "America/New_York")
prev_mn = minute(time[1], "America/New_York")
prev_t  = prev_hr * 100 + prev_mn
bool was_in_session = not use_session or (s_start > s_end ? (prev_t >= s_start or prev_t < s_end) : (prev_t >= s_start and prev_t < s_end))
bool session_ended = was_in_session and not in_session

if session_ended and strategy.position_size != 0
    strategy.close_all(comment="Session Close")

// ===== INDICATORS =====
float ema200 = ta.ema(close, ema_len)
float ema55  = ta.ema(close, ema55_len)
float sma25 = ta.sma(close, sma_len)

// ===== PIVOTS (exact copy from Pivot Points High Low indicator) =====
ph = ta.pivothigh(leftLenH, rightLenH)
pl = ta.pivotlow(leftLenL, rightLenL)

drawLabel(_offset, _pivot, _style, _color, _textColor) =>
    if not na(_pivot)
        label.new(bar_index[_offset], _pivot, str.tostring(_pivot, format.mintick), style=_style, color=_color, textcolor=_textColor)

drawLabel(rightLenH, ph, label.style_label_down, color.white, color.black)
drawLabel(rightLenL, pl, label.style_label_up, color.white, color.black)

// Track last 2 pivot highs and lows for structure comparison
var float ph_prev  = na
var float ph_prev2 = na
var float pl_prev  = na
var float pl_prev2 = na

// ===== CONFIRMED CROSSOVERS =====
var int bars_above = 0
var int bars_below = 0

bool raw_cross_up   = ta.crossover(sma25, ema55)
bool raw_cross_down = ta.crossunder(sma25, ema55)

if raw_cross_up
    bars_above := 1
    bars_below := 0
else if raw_cross_down
    bars_below := 1
    bars_above := 0
else
    if sma25 > ema55
        bars_above := bars_above + 1
        bars_below := 0
    else if sma25 < ema55
        bars_below := bars_below + 1
        bars_above := 0

float sma_ema_gap = math.abs(sma25 - ema55)
bool gap_ok = cross_min_gap <= 0 or sma_ema_gap >= cross_min_gap

bool confirmed_cross_up   = bars_above == cross_confirm_bars and gap_ok
bool confirmed_cross_down = bars_below == cross_confirm_bars and gap_ok

// ===== 55 EMA DIRECTION =====
float ema55_slope = ema55 - ema55[ema55_slope_len]
bool ema55_bull   = ema55_slope > min_slope
bool ema55_bear   = ema55_slope < -min_slope

// ===== STATE MACHINE =====
//  0 = idle (waiting for cross)
//  1 = armed long  (cross up confirmed, waiting for higher-high pivot)
//  2 = long structure confirmed (HH seen, waiting for next pivot low to enter)
// -1 = armed short (cross down confirmed, waiting for lower-low pivot)
// -2 = short structure confirmed (LL seen, waiting for next pivot high to enter)
var int trade_state = 0
var int arm_bar     = -9999

// Arm on confirmed crossover
if confirmed_cross_up and trade_state <= 0
    trade_state := 1
    arm_bar     := bar_index
if confirmed_cross_down and trade_state >= 0
    trade_state := -1
    arm_bar     := bar_index

// Disarm if SMA crosses back the other way
if trade_state > 0 and raw_cross_down
    trade_state := 0
if trade_state < 0 and raw_cross_up
    trade_state := 0

// Disarm on session end
if session_ended
    trade_state := 0

bool long_entry  = false
bool short_entry = false

// Only consider pivots whose ACTUAL bar (not confirmation bar) was after we armed.
// ta.pivothigh confirms rightLenH bars late; the real high was at bar_index - rightLenH.
bool ph_is_post_arm = not na(ph) and (bar_index - rightLenH) >= arm_bar
bool pl_is_post_arm = not na(pl) and (bar_index - rightLenL) >= arm_bar

// LONG FLOW: armed → first post-cross pivot high that is higher than previous → wait for pivot low → enter
if trade_state == 1 and ph_is_post_arm
    if not na(ph_prev) and ph > ph_prev
        trade_state := 2

if trade_state == 2 and pl_is_post_arm
    long_entry := true
    trade_state := 0

// SHORT FLOW: armed → first post-cross pivot low that is lower than previous → wait for pivot high → enter
if trade_state == -1 and pl_is_post_arm
    if not na(pl_prev) and pl < pl_prev
        trade_state := -2

if trade_state == -2 and ph_is_post_arm
    short_entry := true
    trade_state := 0

// Update pivot tracking AFTER state checks so comparisons use the previous values
if not na(ph)
    ph_prev2 := ph_prev
    ph_prev  := ph
if not na(pl)
    pl_prev2 := pl_prev
    pl_prev  := pl

// ===== SIGNALS =====
var int last_trade_bar = -9999
bool cooled_down = bar_index - last_trade_bar >= cooldown_bars

bool long_sig  = long_entry and ema55_bull and in_session and cooled_down and strategy.position_size <= 0
bool short_sig = short_entry and ema55_bear and in_session and cooled_down and strategy.position_size >= 0

// ===== ENTRIES =====
var float current_stop    = 0.0
var float entry_price     = 0.0
var float peak_profit_pts = 0.0
var bool  be_active       = false

if long_sig
    current_stop    := close - stop_pts
    entry_price     := close
    peak_profit_pts := 0.0
    be_active       := false
    last_trade_bar  := bar_index
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=current_stop, limit=close + tp_pts)
else if short_sig
    current_stop    := close + stop_pts
    entry_price     := close
    peak_profit_pts := 0.0
    be_active       := false
    last_trade_bar  := bar_index
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", stop=current_stop, limit=close - tp_pts)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    be_active       := false
    peak_profit_pts := 0.0

if use_breakeven and strategy.position_size != 0 and not be_active
    if strategy.position_size > 0
        if close - entry_price >= be_trigger_pts
            be_active    := true
            current_stop := entry_price + 0.25
            strategy.exit("XL", "Long", stop=current_stop, limit=entry_price + tp_pts)
    else if strategy.position_size < 0
        if entry_price - close >= be_trigger_pts
            be_active    := true
            current_stop := entry_price - 0.25
            strategy.exit("XS", "Short", stop=current_stop, limit=entry_price - tp_pts)

if strategy.position_size == 0
    be_active := false

// ===== TRAILING STOP =====
if use_trail and strategy.position_size != 0
    if strategy.position_size > 0
        float avg        = strategy.position_avg_price
        float profit_now = high - avg
        if profit_now > peak_profit_pts
            peak_profit_pts := profit_now
        if peak_profit_pts >= trail_min_dollars / pv
            float peak_dollars = peak_profit_pts * pv
            int   steps        = math.floor(peak_dollars / trail_step_amt)
            float keep_pct    = math.min(trail_pct + steps * trail_step_pct, 95.0)
            float new_stop    = avg + peak_profit_pts * (keep_pct / 100.0)
            if new_stop > current_stop
                current_stop := new_stop
                strategy.exit("XL", "Long", stop=current_stop, limit=avg + tp_pts)
    else if strategy.position_size < 0
        float avg        = strategy.position_avg_price
        float profit_now = avg - low
        if profit_now > peak_profit_pts
            peak_profit_pts := profit_now
        if peak_profit_pts >= trail_min_dollars / pv
            float peak_dollars = peak_profit_pts * pv
            int   steps        = math.floor(peak_dollars / trail_step_amt)
            float keep_pct    = math.min(trail_pct + steps * trail_step_pct, 95.0)
            float new_stop    = avg - peak_profit_pts * (keep_pct / 100.0)
            if new_stop < current_stop
                current_stop := new_stop
                strategy.exit("XS", "Short", stop=current_stop, limit=avg - tp_pts)

// ===== CRITERIA DISPLAY TABLE (NEVER REMOVE) =====
var table crit_table = table.new(position.top_right, 3, 10, bgcolor=color.new(color.black, 70), border_width=1)

table.cell(crit_table, 0, 0, "Criterion", text_color=color.white, text_size=size.tiny)
table.cell(crit_table, 1, 0, "Long", text_color=color.lime, text_size=size.tiny)
table.cell(crit_table, 2, 0, "Short", text_color=color.red, text_size=size.tiny)

// Row 1: SMA/EMA Cross
table.cell(crit_table, 0, 1, "SMA Cross EMA", text_color=color.white, text_size=size.tiny)
table.cell(crit_table, 1, 1, confirmed_cross_up ? "✓ (" + str.tostring(bars_above) + "b)" : str.tostring(bars_above) + "b", text_color=confirmed_cross_up ? color.lime : (sma25 > ema55 ? color.new(color.lime, 50) : color.gray), text_size=size.tiny)
table.cell(crit_table, 2, 1, confirmed_cross_down ? "✓ (" + str.tostring(bars_below) + "b)" : str.tostring(bars_below) + "b", text_color=confirmed_cross_down ? color.red : (sma25 < ema55 ? color.new(color.red, 50) : color.gray), text_size=size.tiny)

// Row 2: Gap
table.cell(crit_table, 0, 2, "Gap (" + str.tostring(sma_ema_gap, "#.##") + " pts)", text_color=color.white, text_size=size.tiny)
table.cell(crit_table, 1, 2, gap_ok ? "1" : "0", text_color=gap_ok ? color.lime : color.gray, text_size=size.tiny)
table.cell(crit_table, 2, 2, gap_ok ? "1" : "0", text_color=gap_ok ? color.red : color.gray, text_size=size.tiny)

// Row 3: Higher Highs / Lower Lows
bool hh = not na(ph_prev) and not na(ph_prev2) and ph_prev > ph_prev2
bool ll = not na(pl_prev) and not na(pl_prev2) and pl_prev < pl_prev2
table.cell(crit_table, 0, 3, "Structure", text_color=color.white, text_size=size.tiny)
table.cell(crit_table, 1, 3, hh ? "HH" : "---", text_color=hh ? color.lime : color.gray, text_size=size.tiny)
table.cell(crit_table, 2, 3, ll ? "LL" : "---", text_color=ll ? color.red : color.gray, text_size=size.tiny)

// Row 4: EMA55 Slope
table.cell(crit_table, 0, 4, "EMA55 Slope (" + str.tostring(ema55_slope, "#.##") + ")", text_color=color.white, text_size=size.tiny)
table.cell(crit_table, 1, 4, ema55_bull ? "1" : "0", text_color=ema55_bull ? color.lime : color.gray, text_size=size.tiny)
table.cell(crit_table, 2, 4, ema55_bear ? "1" : "0", text_color=ema55_bear ? color.red : color.gray, text_size=size.tiny)

// Row 5: Session
table.cell(crit_table, 0, 5, "Session", text_color=color.white, text_size=size.tiny)
table.cell(crit_table, 1, 5, in_session ? "1" : "0", text_color=in_session ? color.lime : color.gray, text_size=size.tiny)
table.cell(crit_table, 2, 5, in_session ? "1" : "0", text_color=in_session ? color.lime : color.gray, text_size=size.tiny)

// Row 6: State Machine
string state_txt = trade_state == 0 ? "Idle" : trade_state == 1 ? "Armed Long" : trade_state == 2 ? "HH confirmed" : trade_state == -1 ? "Armed Short" : trade_state == -2 ? "LL confirmed" : "?"
color state_col = trade_state > 0 ? color.lime : trade_state < 0 ? color.red : color.gray
table.cell(crit_table, 0, 6, "State", text_color=color.yellow, text_size=size.tiny)
table.cell(crit_table, 1, 6, state_txt, text_color=state_col, text_size=size.tiny)
table.cell(crit_table, 2, 6, "", text_size=size.tiny)

// Row 7: Pivots
string ph_txt = not na(ph_prev) ? str.tostring(ph_prev, "#.##") : "---"
string pl_txt = not na(pl_prev) ? str.tostring(pl_prev, "#.##") : "---"
table.cell(crit_table, 0, 7, "Last PH / PL", text_color=color.yellow, text_size=size.tiny)
table.cell(crit_table, 1, 7, ph_txt, text_color=color.white, text_size=size.tiny)
table.cell(crit_table, 2, 7, pl_txt, text_color=color.white, text_size=size.tiny)

// Row 8: Signal
string sig_txt = long_sig ? "LONG TRIGGERED" : short_sig ? "SHORT TRIGGERED" : "---"
color sig_col = long_sig ? color.lime : short_sig ? color.red : color.gray
table.cell(crit_table, 0, 8, "Signal", text_color=color.yellow, text_size=size.tiny)
table.cell(crit_table, 1, 8, sig_txt, text_color=sig_col, text_size=size.tiny)
table.cell(crit_table, 2, 8, "", text_size=size.tiny)

// ===== ENTRY LABELS WITH HOVER TOOLTIP (NEVER REMOVE) =====
if long_sig
    string tt = "LONG ENTRY\n" +
      "──────────────────\n" +
      "✓  SMA25 crossed above EMA55  (" + str.tostring(bars_above) + " bars, gap " + str.tostring(sma_ema_gap, "#.##") + " pts)\n" +
      (hh ? "✓" : "✗") + "  Higher Highs  (PH: " + str.tostring(nz(ph_prev), "#.##") + " > " + str.tostring(nz(ph_prev2), "#.##") + ")\n" +
      (ema55_bull ? "✓" : "✗") + "  EMA55 slope up  (" + str.tostring(ema55_slope, "#.##") + " pts)\n" +
      (in_session ? "✓" : "✗") + "  In session\n" +
      (cooled_down ? "✓" : "✗") + "  Cooldown\n" +
      "──────────────────\n" +
      "Entry: " + str.tostring(close, "#.##") + "\n" +
      "Stop: " + str.tostring(close - stop_pts, "#.##") + "  ($" + str.tostring(stop_dollars, "#") + ")\n" +
      "TP: " + str.tostring(close + tp_pts, "#.##") + "  ($" + str.tostring(tp_dollars, "#") + ")"
    label.new(bar_index, low, "▲", style=label.style_label_up, color=color.lime, textcolor=color.white, size=size.small, tooltip=tt)

if short_sig
    string tt = "SHORT ENTRY\n" +
      "──────────────────\n" +
      "✓  SMA25 crossed below EMA55  (" + str.tostring(bars_below) + " bars, gap " + str.tostring(sma_ema_gap, "#.##") + " pts)\n" +
      (ll ? "✓" : "✗") + "  Lower Lows  (PL: " + str.tostring(nz(pl_prev), "#.##") + " < " + str.tostring(nz(pl_prev2), "#.##") + ")\n" +
      (ema55_bear ? "✓" : "✗") + "  EMA55 slope down  (" + str.tostring(ema55_slope, "#.##") + " pts)\n" +
      (in_session ? "✓" : "✗") + "  In session\n" +
      (cooled_down ? "✓" : "✗") + "  Cooldown\n" +
      "──────────────────\n" +
      "Entry: " + str.tostring(close, "#.##") + "\n" +
      "Stop: " + str.tostring(close + stop_pts, "#.##") + "  ($" + str.tostring(stop_dollars, "#") + ")\n" +
      "TP: " + str.tostring(close - tp_pts, "#.##") + "  ($" + str.tostring(tp_dollars, "#") + ")"
    label.new(bar_index, high, "▼", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small, tooltip=tt)

// State debug
plotshape(confirmed_cross_up, "Cross Up Confirmed", shape.diamond, location.belowbar, color.new(color.blue, 40), size=size.tiny)
plotshape(confirmed_cross_down, "Cross Down Confirmed", shape.diamond, location.abovebar, color.new(color.blue, 40), size=size.tiny)
bgcolor(trade_state == 2 ? color.new(color.lime, 92) : trade_state == -2 ? color.new(color.red, 92) : na)

// ===== PLOT =====
plot(ema200, "200 EMA", color.purple, linewidth=2)
plot(ema55, "55 EMA", color.blue, linewidth=2)
plot(sma25, "25 SMA", color.orange, linewidth=2)
plot(strategy.position_size != 0 ? current_stop : na, "Stop", color.fuchsia, style=plot.style_stepline, linewidth=2)
