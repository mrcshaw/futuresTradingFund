//@version=5
strategy("EMA Crossover (No Flat)", overlay=true,
  initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=5.50,
  slippage=3, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false)

// ===== EMA =====
ema_len       = input.int(200, "EMA Length", minval=1)
ema_slope_len = input.int(5, "EMA Slope Lookback (bars)", minval=1)
min_slope     = input.float(0.5, "Min EMA Slope (pts)", minval=0.0, tooltip="Minimum slope to count as trending. Filters out flat markets.")

// ===== CROSSOVER SOURCE =====
use_vwap_cross = input.bool(false, "Also use VWAP crossovers", tooltip="When on, entries can trigger on close crossing EMA or VWAP.")

// ===== FLAT MARKET FILTER =====
use_flat_filter = input.bool(true, "Skip flat market", tooltip="When on, no trades when ATR is below Min ATR (choppy/sideways).")
atr_len        = input.int(14, "ATR Length", minval=1)
min_atr_pts    = input.float(0.5, "Min ATR (pts)", minval=0.0, step=0.25, tooltip="No trade when ATR is below this. 0 = disable.")

// ===== RISK =====
pv                = input.float(50.0, "Point Value ($)")
stop_dollars      = input.float(300.0, "Stop ($)")
tp_dollars        = input.float(300.0, "Take Profit ($)")
use_trail         = input.bool(true, "Enable Trailing Stop")
trail_pct         = input.float(45.0, "Trail: Keep % of Peak Profit")
trail_step_amt    = input.float(300.0, "Trail: Tighten every $X profit")
trail_step_pct    = input.float(10.0, "Trail: Tighten by X% per step")
trail_min_dollars = input.float(150.0, "Trail: Min Profit Before Trailing ($)")

// ===== SESSION =====
use_session_filter = input.bool(true, "Use Session Filter")
use_ny_sess    = input.bool(true, "Enable NY Session")
ny_start_hr    = input.int(9,  "NY Session Start Hour (ET)")
ny_start_mn    = input.int(30, "NY Session Start Minute")
ny_end_hr      = input.int(16, "NY Session End Hour (ET)")
ny_end_mn      = input.int(0,  "NY Session End Minute")
use_fut_sess   = input.bool(true, "Enable Futures Session")
fut_start_hr   = input.int(18, "Futures Start Hour (ET)")
fut_end_hr     = input.int(8,  "Futures End Hour (ET)")

// ===== COMPUTED =====
stop_pts = stop_dollars / pv
tp_pts   = tp_dollars / pv

// ===== SESSION LOGIC =====
bar_hr    = hour(time, "America/New_York")
bar_mn    = minute(time, "America/New_York")
bar_t     = bar_hr * 100 + bar_mn
ny_start  = ny_start_hr * 100 + ny_start_mn
ny_end    = ny_end_hr * 100 + ny_end_mn
fut_start = fut_start_hr * 100
fut_end   = fut_end_hr * 100
in_ny     = use_ny_sess and bar_t >= ny_start and bar_t < ny_end
in_fut    = use_fut_sess and (bar_t >= fut_start or bar_t < fut_end)
in_session = not use_session_filter or (in_ny or in_fut)

prev_hr = hour(time[1], "America/New_York")
prev_mn = minute(time[1], "America/New_York")
prev_t  = prev_hr * 100 + prev_mn
was_ny  = use_ny_sess and prev_t >= ny_start and prev_t < ny_end
was_fut = use_fut_sess and (prev_t >= fut_start or prev_t < fut_end)
session_ended = (was_ny or was_fut) and not in_session

if session_ended and strategy.position_size != 0
    strategy.close_all(comment="Session Close")

// ===== EMA & SLOPE =====
float ema_val   = ta.ema(close, ema_len)
float ema_slope = ema_val - ema_val[ema_slope_len]
bool  ema_up    = ema_slope > min_slope
bool  ema_down  = ema_slope < -min_slope

// ===== VWAP =====
float vwap_val = ta.vwap(hlc3)

// ===== CROSSOVERS =====
bool cross_ema_long  = ta.crossover(close, ema_val)
bool cross_ema_short = ta.crossunder(close, ema_val)
bool cross_vwap_long  = ta.crossover(close, vwap_val)
bool cross_vwap_short = ta.crossunder(close, vwap_val)

bool cross_long  = cross_ema_long or (use_vwap_cross and cross_vwap_long)
bool cross_short = cross_ema_short or (use_vwap_cross and cross_vwap_short)

// ===== FLAT MARKET FILTER =====
float atr_val  = ta.atr(atr_len)
bool not_flat  = not use_flat_filter or min_atr_pts <= 0 or atr_val >= min_atr_pts

// ===== SIGNALS (crossover + trend + not flat) =====
bool long_signal  = cross_long and ema_up and not_flat
bool short_signal = cross_short and ema_down and not_flat

// ===== ENTRIES =====
var float current_stop    = 0.0
var float peak_profit_pts = 0.0

if strategy.position_size == 0 and in_session
    if long_signal
        current_stop    := close - stop_pts
        peak_profit_pts := 0.0
        strategy.entry("Long", strategy.long)
        strategy.exit("XL", "Long", stop=current_stop, limit=close + tp_pts)
    else if short_signal
        current_stop    := close + stop_pts
        peak_profit_pts := 0.0
        strategy.entry("Short", strategy.short)
        strategy.exit("XS", "Short", stop=current_stop, limit=close - tp_pts)

// ===== TRAILING STOP =====
if use_trail
    if strategy.position_size > 0
        float avg        = strategy.position_avg_price
        float profit_now = high - avg
        if profit_now > peak_profit_pts
            peak_profit_pts := profit_now
        if peak_profit_pts >= trail_min_dollars / pv
            float peak_dollars = peak_profit_pts * pv
            int   steps        = math.floor(peak_dollars / trail_step_amt)
            float keep_pct     = math.min(trail_pct + steps * trail_step_pct, 95.0)
            float new_stop     = avg + peak_profit_pts * (keep_pct / 100.0)
            if new_stop > current_stop
                current_stop := new_stop
                strategy.exit("XL", "Long", stop=current_stop, limit=avg + tp_pts)
    else if strategy.position_size < 0
        float avg        = strategy.position_avg_price
        float profit_now = avg - low
        if profit_now > peak_profit_pts
            peak_profit_pts := profit_now
        if peak_profit_pts >= trail_min_dollars / pv
            float peak_dollars = peak_profit_pts * pv
            int   steps        = math.floor(peak_dollars / trail_step_amt)
            float keep_pct     = math.min(trail_pct + steps * trail_step_pct, 95.0)
            float new_stop     = avg - peak_profit_pts * (keep_pct / 100.0)
            if new_stop < current_stop
                current_stop := new_stop
                strategy.exit("XS", "Short", stop=current_stop, limit=avg - tp_pts)

// ===== LOGGING =====
if barstate.islast
    log.info("EMA={0} slope={1} ema_up={2} ema_down={3} atr={4} not_flat={5}", ema_val, ema_slope, ema_up, ema_down, atr_val, not_flat)

if long_signal and strategy.position_size == 0
    log.info("LONG CROSS bar={0} close={1} ema={2} slope={3}", bar_index, close, ema_val, ema_slope)

if short_signal and strategy.position_size == 0
    log.info("SHORT CROSS bar={0} close={1} ema={2} slope={3}", bar_index, close, ema_val, ema_slope)

if strategy.position_size[1] != 0 and strategy.position_size == 0 and strategy.closedtrades > 0
    log.info("TRADE CLOSED bar={0} pnl={1}", bar_index, strategy.closedtrades.profit(strategy.closedtrades - 1))

if use_trail and strategy.position_size != 0
    log.info("TRAIL bar={0} pos={1} stop={2} peak_profit={3}", bar_index, strategy.position_size, current_stop, peak_profit_pts * pv)

// ===== PLOT =====
plot(ema_val, "EMA", ema_up ? color.lime : ema_down ? color.red : color.gray, linewidth=2)
plot(strategy.position_size != 0 ? current_stop : na, "Stop", color.fuchsia, style=plot.style_stepline, linewidth=2)
plot(vwap_val, "VWAP", color.white, style=plot.style_line, linewidth=1)

plotshape(long_signal  and strategy.position_size == 0, "Long Signal",  shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(short_signal and strategy.position_size == 0, "Short Signal", shape.triangledown, location.abovebar, color.red,  size=size.small)

plot(ema_slope, "Slope", color.white, display=display.data_window)
plot(atr_val,   "ATR",   color.orange, display=display.data_window)
