//@version=5
// ============================================================
// Opening Range Breakout (10-11am ET)
// ============================================================
//
// CONCEPT:
//   Gather the highest and lowest price from 10am to 11am ET.
//   After 11am, trade the breakout:
//     LONG:  candle closes above the range high → buy, ride the trend up
//     SHORT: candle closes below the range low  → sell, ride the trend down
//   One breakout per day. Step trailing stop lets runners run.
//
// RULES:
//   1. 10-11am ET: track highest high and lowest low (the "range")
//   2. After 11am: first close beyond range + buffer = entry
//   3. Stop at fixed distance or opposite side of range
//   4. Step trailing stop locks in profit as trade runs
//   5. Close all at session end
// ============================================================

strategy("Opening Range Breakout", overlay=true,
  initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=4.50,
  slippage=1, pyramiding=0, process_orders_on_close=false, calc_on_every_tick=true)

// ===== RANGE WINDOW =====
range_start_hr   = input.int(10, "Range Start Hour (ET)", minval=0, maxval=23, group="Range")
range_start_mn   = input.int(0, "Range Start Minute", minval=0, maxval=59, group="Range")
range_end_hr     = input.int(11, "Range End Hour (ET)", minval=0, maxval=23, group="Range")
range_end_mn     = input.int(0, "Range End Minute", minval=0, maxval=59, group="Range")

// ===== ENTRY =====
break_buffer     = input.float(0.75, "Break Beyond Range (pts)", minval=0, step=0.25, group="Entry",
                     tooltip="Price must close this far beyond the range high/low to trigger entry.")
tick_size       = input.float(0.25, "Tick Size (pts)", minval=0.01, step=0.25, group="Entry",
                     tooltip="Full candle = open AND close at least one tick inside/outside the range. ES=0.25.")
use_ema_filter   = input.bool(false, "Require EMA Direction", group="Entry",
                     tooltip="Only long if EMA slopes up, only short if EMA slopes down.")
ema_len          = input.int(200, "EMA Length", minval=10, group="Entry")
ema_slope_bars   = input.int(10, "EMA Slope Lookback", minval=2, group="Entry")
ema_min_angle    = input.float(3.0, "Min EMA Angle (degrees)", minval=0, step=0.5, group="Entry")

// ===== STOP =====
pv               = input.float(50.0, "Point Value ($)", minval=0.1, group="Stop")
stop_mode        = input.string("Fixed $", "Stop Mode", options=["Fixed $", "Opposite Side", "ATR"], group="Stop",
                     tooltip="Fixed $: set distance. Opposite Side: stop at the other end of the range. ATR: multiple of ATR.")
stop_dollars     = input.float(300.0, "Fixed Stop ($)", minval=1, group="Stop")
atr_stop_mult    = input.float(2.0, "ATR Stop Multiplier", minval=0.5, step=0.5, group="Stop")
stop_buffer      = input.float(1.0, "Stop Buffer (pts, for Opposite Side)", minval=0, step=0.5, group="Stop")

// ===== TAKE PROFIT =====
tp_mode          = input.string("R Multiple", "TP Mode", options=["R Multiple", "Fixed $", "Off"], group="Take Profit")
take_profit_r    = input.float(2.0, "TP R Multiple", minval=0.5, step=0.5, group="Take Profit")
tp_dollars       = input.float(500.0, "TP Fixed ($)", minval=1, group="Take Profit")

// ===== TRAILING STOP =====
use_trail        = input.bool(true, "Enable Trailing Stop", group="Trail")
trail_pct        = input.float(45.0, "Trail: Keep % of Peak Profit", minval=5, maxval=95, group="Trail")
trail_step_amt   = input.float(1000.0, "Trail: Tighten every $X profit", minval=50, group="Trail")
trail_step_pct   = input.float(10.0, "Trail: Tighten by X% per step", minval=1, group="Trail")
trail_min_dollars = input.float(150.0, "Trail: Min Profit Before Trailing ($)", minval=0, group="Trail")

// ===== SESSION =====
trade_start_hr   = input.int(11, "Trade Start Hour (ET)", minval=0, maxval=23, group="Session",
                     tooltip="When to start looking for breakouts. Should be >= Range End Hour.")
trade_end_hr     = input.int(15, "Trade End Hour (ET)", minval=0, maxval=23, group="Session")
trade_end_mn     = input.int(30, "Trade End Minute", minval=0, maxval=59, group="Session")
max_trades_day   = input.int(5, "Max Trades Per Day", minval=1, group="Session",
                     tooltip="Allows re-entry attempts after stop-outs.")
daily_loss_lim   = input.float(500.0, "Daily Loss Limit ($)", minval=0, group="Session")
cool_bars        = input.int(2, "Cooldown After Exit (bars)", minval=0, group="Session")
loss_cool_bars   = input.int(5, "Cooldown After Loss (bars)", minval=0, group="Session",
                     tooltip="Bars to wait after stop-out before re-entry. Lower = can re-enter sooner.")

// ===== VISUALS =====
show_range       = input.bool(true, "Show Range Lines", group="Visuals")
show_ema         = input.bool(true, "Show EMA", group="Visuals")

// ============================================================
// COMPUTED
// ============================================================
ema_val    = ta.ema(close, ema_len)
atr_val    = ta.atr(14)
stop_pts   = stop_dollars / pv
tp_pts     = tp_dollars / pv

float ema_rise  = ema_val - ema_val[ema_slope_bars]
float ema_angle = math.todegrees(math.atan(ema_rise / ema_slope_bars))
bool ema_up     = ema_angle >= ema_min_angle
bool ema_down   = ema_angle <= -ema_min_angle

// ============================================================
// TIME WINDOWS (ET)
// ============================================================
bar_hr = hour(time, "America/New_York")
bar_mn = minute(time, "America/New_York")
bar_t  = bar_hr * 100 + bar_mn

int range_start_t = range_start_hr * 100 + range_start_mn
int range_end_t   = range_end_hr * 100 + range_end_mn
int trade_start_t = trade_start_hr * 100
int trade_end_t   = trade_end_hr * 100 + trade_end_mn

bool in_range_window = bar_t >= range_start_t and bar_t < range_end_t
bool in_trade_window = bar_t >= trade_start_t and bar_t < trade_end_t

// Detect new day (range window just started)
int prev_t = hour(time[1], "America/New_York") * 100 + minute(time[1], "America/New_York")
bool range_just_started = in_range_window and prev_t < range_start_t

// Detect session end for force close
bool trade_just_ended = bar_t >= trade_end_t and prev_t < trade_end_t

// ============================================================
// TRACK RANGE HIGH / LOW (10-11am)
// ============================================================
var float range_high    = na
var float range_low     = na
var bool  range_locked  = false
var bool  traded_today  = false

if range_just_started
    range_high   := high
    range_low    := low
    range_locked := false
    traded_today := false

if in_range_window and not range_locked
    range_high := math.max(nz(range_high, high), high)
    range_low  := math.min(nz(range_low, low), low)

if not in_range_window and not na(range_high) and not range_locked
    range_locked := true

// ============================================================
// DAILY TRACKING
// ============================================================
var float daily_pnl    = 0.0
var bool  daily_lock   = false
var int   last_ct      = 0
var int   trades_today = 0
var int   prev_day     = -1

ny_day = dayofweek(time, "America/New_York")
if ny_day != prev_day and in_range_window
    prev_day     := ny_day
    daily_pnl    := 0.0
    daily_lock   := false
    last_ct      := strategy.closedtrades
    trades_today := 0

if strategy.closedtrades > last_ct
    for i = last_ct to strategy.closedtrades - 1
        daily_pnl += strategy.closedtrades.profit(i)
    last_ct := strategy.closedtrades

if daily_loss_lim > 0 and daily_pnl <= -daily_loss_lim
    daily_lock := true

// ============================================================
// FORCE CLOSE
// ============================================================
if daily_lock and strategy.position_size != 0
    strategy.close_all(comment="Daily Limit")

if trade_just_ended and strategy.position_size != 0
    strategy.close_all(comment="Session Close")

// ============================================================
// COOLDOWN
// ============================================================
var int  last_exit_bar = -999
var bool last_was_loss = false

if strategy.position_size[1] != 0 and strategy.position_size == 0
    last_exit_bar := bar_index
    if strategy.closedtrades > 0
        last_was_loss := strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
    else
        last_was_loss := false

int active_cool = last_was_loss ? loss_cool_bars : cool_bars
bool cooled     = (bar_index - last_exit_bar) >= active_cool

bool can_enter = strategy.position_size == 0 and range_locked and in_trade_window and not daily_lock and cooled and trades_today < max_trades_day

// EMA filter (optional)
bool long_ok  = not use_ema_filter or ema_up
bool short_ok = not use_ema_filter or ema_down

// ============================================================
// ENTRY — BREAKOUT + RETEST (all steps require FULL candle closures)
// ============================================================
// 1. Candle CLOSES beyond range → breakout registered
// 2. A later candle CLOSES back INSIDE the range → retest
// 3. FULL candle outside the range (open AND close both beyond) → enter
// After stop out: retest flag resets so the cycle can repeat.
var float peak_profit_pts = 0.0
var float current_stop    = 0.0
var float current_tp      = na
var bool  broke_high      = false
var bool  broke_low       = false
var bool  retested_high   = false
var bool  retested_low    = false

// Reset on new day
if range_just_started
    broke_high     := false
    broke_low      := false
    retested_high  := false
    retested_low   := false

// After stop out: reset retest so we can re-enter if price comes back and breaks out again
if strategy.position_size == 0 and strategy.position_size[1] != 0
    retested_high := false
    retested_low  := false

// Step 1: candle closes beyond range = breakout
if range_locked and in_trade_window and not na(range_high) and close > range_high and not broke_high
    broke_high := true
if range_locked and in_trade_window and not na(range_low) and close < range_low and not broke_low
    broke_low := true

// Step 2: FULL candle back INSIDE the range
// Full candle = open AND close at least one tick below range_high AND at least one tick above range_low
bool full_candle_inside_high = (open <= range_high - tick_size and close <= range_high - tick_size) and (open >= range_low + tick_size and close >= range_low + tick_size)
bool full_candle_inside_low  = (open <= range_high - tick_size and close <= range_high - tick_size) and (open >= range_low + tick_size and close >= range_low + tick_size)
if broke_high and not retested_high and full_candle_inside_high and strategy.position_size == 0
    retested_high := true
if broke_low and not retested_low and full_candle_inside_low and strategy.position_size == 0
    retested_low := true

// Step 3: FULL candle back OUTSIDE (open AND close at least one tick beyond the level)
bool full_candle_outside_high = open >= range_high + tick_size and close >= range_high + tick_size
bool full_candle_outside_low  = open <= range_low - tick_size and close <= range_low - tick_size
bool long_retest_entry  = can_enter and long_ok and retested_high and full_candle_outside_high
bool short_retest_entry = can_enter and short_ok and retested_low and full_candle_outside_low

if long_retest_entry
    float s = 0.0
    if stop_mode == "Opposite Side"
        s := range_low - stop_buffer
    else if stop_mode == "ATR"
        s := close - atr_val * atr_stop_mult
    else
        s := close - stop_pts
    current_stop := s
    float risk = close - s
    if tp_mode == "R Multiple"
        current_tp := close + risk * take_profit_r
    else if tp_mode == "Fixed $"
        current_tp := close + tp_pts
    else
        current_tp := na
    peak_profit_pts := 0.0
    strategy.entry("Long", strategy.long)
    if na(current_tp)
        strategy.exit("XL", "Long", stop=current_stop)
    else
        strategy.exit("XL", "Long", stop=current_stop, limit=current_tp)
    trades_today += 1
    traded_today  := true
    retested_high := false

if short_retest_entry
    float s = 0.0
    if stop_mode == "Opposite Side"
        s := range_high + stop_buffer
    else if stop_mode == "ATR"
        s := close + atr_val * atr_stop_mult
    else
        s := close + stop_pts
    current_stop := s
    float risk = s - close
    if tp_mode == "R Multiple"
        current_tp := close - risk * take_profit_r
    else if tp_mode == "Fixed $"
        current_tp := close - tp_pts
    else
        current_tp := na
    peak_profit_pts := 0.0
    strategy.entry("Short", strategy.short)
    if na(current_tp)
        strategy.exit("XS", "Short", stop=current_stop)
    else
        strategy.exit("XS", "Short", stop=current_stop, limit=current_tp)
    trades_today += 1
    traded_today  := true
    retested_low  := false

// ============================================================
// STEP TRAILING STOP
// ============================================================
trail_min_pts = trail_min_dollars / pv

if use_trail
    if strategy.position_size > 0
        float avg = strategy.position_avg_price
        float profit_now = high - avg
        if profit_now > peak_profit_pts
            peak_profit_pts := profit_now
        if peak_profit_pts >= trail_min_pts
            float peak_dollars = peak_profit_pts * pv
            int steps = math.floor(peak_dollars / trail_step_amt)
            float keep_pct = math.min(trail_pct + steps * trail_step_pct, 95.0)
            float lock_pts = peak_profit_pts * (keep_pct / 100.0)
            float new_stop = avg + lock_pts
            if new_stop > current_stop
                current_stop := new_stop
                if na(current_tp)
                    strategy.exit("XL", "Long", stop=current_stop)
                else
                    strategy.exit("XL", "Long", stop=current_stop, limit=current_tp)
    else if strategy.position_size < 0
        float avg = strategy.position_avg_price
        float profit_now = avg - low
        if profit_now > peak_profit_pts
            peak_profit_pts := profit_now
        if peak_profit_pts >= trail_min_pts
            float peak_dollars = peak_profit_pts * pv
            int steps = math.floor(peak_dollars / trail_step_amt)
            float keep_pct = math.min(trail_pct + steps * trail_step_pct, 95.0)
            float lock_pts = peak_profit_pts * (keep_pct / 100.0)
            float new_stop = avg - lock_pts
            if new_stop < current_stop
                current_stop := new_stop
                if na(current_tp)
                    strategy.exit("XS", "Short", stop=current_stop)
                else
                    strategy.exit("XS", "Short", stop=current_stop, limit=current_tp)
    else
        peak_profit_pts := 0.0

// ============================================================
// PLOTS
// ============================================================
// Range lines — show after range is locked, hide after trade or session end
bool show_lines = show_range and range_locked and in_trade_window
plot(show_lines ? range_high : na, "Range High", color.aqua, 2, plot.style_stepline)
plot(show_lines ? range_low : na, "Range Low", color.orange, 2, plot.style_stepline)

plot(show_ema ? ema_val : na, "EMA", ema_up ? color.green : ema_down ? color.red : color.gray, 2)

plot(strategy.position_size != 0 ? current_stop : na, "Stop", color.fuchsia, 2, plot.style_stepline)
float show_tp = strategy.position_size != 0 and not na(current_tp) ? current_tp : na
plot(show_tp, "TP", color.lime, 1, plot.style_stepline)

plotshape(long_retest_entry, "Long Entry", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(short_retest_entry, "Short Entry", shape.triangledown, location.abovebar, color.red, size=size.small)

// Background: yellow during range gathering, blue during trade window
bgcolor(in_range_window ? color.new(color.yellow, 90) : in_trade_window ? color.new(color.blue, 96) : na)

// Data window
plot(range_locked ? range_high - range_low : na, "Range Size (pts)", display=display.data_window)
plot(ema_angle, "EMA Angle", display=display.data_window)
plot(trades_today, "Trades Today", display=display.data_window)
plot(daily_pnl, "Daily PnL ($)", display=display.data_window)
plot(broke_high ? 1 : 0, "Broke High", display=display.data_window)
plot(broke_low ? 1 : 0, "Broke Low", display=display.data_window)
plot(retested_high ? 1 : 0, "Retested High", display=display.data_window)
plot(retested_low ? 1 : 0, "Retested Low", display=display.data_window)
plot(full_candle_inside_high ? 1 : 0, "Full Candle Inside High", display=display.data_window)
plot(full_candle_outside_high ? 1 : 0, "Full Candle Outside High", display=display.data_window)
plot(can_enter ? 1 : 0, "Can Enter", display=display.data_window)
plot(cooled ? 1 : 0, "Cooled", display=display.data_window)
