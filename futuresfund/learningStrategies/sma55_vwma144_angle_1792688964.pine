//@version=5
// ES 5-minute. The trade is the 21 EMA crossing the 144 VWMA.
// Long when EMA crosses above VWMA. Short when EMA crosses below VWMA.
strategy("EMA VWMA Cross", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000, process_orders_on_close=true)

// ===== RISK =====
pv                = input.float(5, "Point Value ($)")
stop_dollars      = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars        = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
use_trail         = input.bool(false, "Enable Trailing Stop")
trail_pct         = input.float(50, "Trail keep (%)", minval=0, maxval=100)
trail_step_amt    = input.int(500, "Trail: Tighten every ($)", minval=0, maxval=2000)
trail_step_pct    = input.float(50, "Trail step (%)", minval=0, maxval=100)
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)", minval=0, maxval=2000)
long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
short_limit = close - tp_dollars / pv

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")
h = hour(time, "America/New_York")
m = minute(time, "America/New_York")
in_session = not use_session or (h > sess_start_hr or (h == sess_start_hr and m >= sess_start_mn) or h < sess_end_hr or (h == sess_end_hr and m < sess_end_mn))

// ===== SIGNAL =====
ema_len = input.int(21, "EMA Length", minval=5, maxval=200)
vwma_len = input.int(144, "VWMA Length", minval=5, maxval=200)
ema_line = ta.ema(close, ema_len)
vwma_line = ta.vwma(close, vwma_len)
plot(ema_line, "EMA", color.yellow, linewidth=1)
plot(vwma_line, "VWMA", color.blue, linewidth=1)
bull_cross = ta.crossover(ema_line, vwma_line)
bear_cross = ta.crossunder(ema_line, vwma_line)

// ===== EXECUTION =====
// desk indicator ta.rsi
_desk_gate = ta.rsi(close, 14)
_desk_long = _desk_gate > 50
_desk_short = _desk_gate < 50
if in_session and strategy.position_size == 0 and bull_cross and _desk_long
    strategy.entry("Long", strategy.long)
    strategy.exit("Long exit", from_entry="Long", stop=long_stop, limit=long_limit)
if in_session and strategy.position_size == 0 and bear_cross and _desk_short
    strategy.entry("Short", strategy.short)
    strategy.exit("Short exit", from_entry="Short", stop=short_stop, limit=short_limit)
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
if strategy.position_size != 0 and not na(stop_dollars)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")
