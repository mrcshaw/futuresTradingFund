//@version=5
strategy("Smart Trail Signals", overlay=true,
  initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=5.50,
  slippage=3, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false)
// ===== RISK =====
pv                = input.float(100, "Point Value ($)")
stop_dollars      = input.int(700, "Stop ($)", minval=50, maxval=700)
tp_dollars        = input.int(750, "Take Profit ($)", minval=50)
use_trail         = input.bool(false, "Enable Trailing Stop")
trail_pct         = input.float(50, "Trail keep (%)", minval=0, maxval=100)
trail_step_amt    = input.int(500, "Trail: Tighten every ($)", minval=0, maxval=2000)
trail_step_pct    = input.float(50, "Trail step (%)", minval=0, maxval=100)
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)", minval=0, maxval=2000)
long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
short_limit = close - tp_dollars / pv
if strategy.position_size != 0 and not na(stop_dollars)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")

// ===== SIGNAL SETTINGS =====
sensitivity = input.int(12, "Optimal Sensitivity", minval=1, tooltip="Adjusts the agility of the Smart Trail.")
min_score   = input.int(2, "Min AI Score to Trade (1-4)", minval=1, maxval=4, tooltip="Only take signals with this score or higher.")

// ===== TREND FILTER =====
ema_len       = input.int(25, "Trend EMA Length", minval=1)
ema_slope_len = input.int(5, "EMA Slope Lookback (bars)", minval=1)
min_slope     = input.float(0.2, "Min EMA Slope (pts)", minval=0.0, tooltip="Minimum slope to confirm trending. 0 = disabled.")
pullback_dollars = input.float(25, "Pullback Zone ($)", tooltip="How close price must be to 200 EMA for pullback entry.")

// ===== SESSION =====
use_session   = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0,  "Session Start Minute")
sess_end_hr   = input.int(8,  "Session End Hour (ET)")
sess_end_mn   = input.int(0,  "Session End Minute")

// ===== SKIP WINDOW (a time of day that keeps losing) =====
use_skip      = input.bool(true, "Skip This Time Of Day", group="Skip Window", tooltip="No trade opens inside this window, and an open trade is closed when it starts.")
skip_start_hr = input.int(19, "Skip Start Hour (ET)", minval=0, maxval=23, group="Skip Window")
skip_start_mn = input.int(30, "Skip Start Minute", minval=0, maxval=59, group="Skip Window")
skip_end_hr   = input.int(21, "Skip End Hour (ET)", minval=0, maxval=23, group="Skip Window")
skip_end_mn   = input.int(30, "Skip End Minute", minval=0, maxval=59, group="Skip Window")
skip_bar_t = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")
skip_from = skip_start_hr * 100 + skip_start_mn
skip_to = skip_end_hr * 100 + skip_end_mn
in_skip_window = use_skip and (skip_from > skip_to ? (skip_bar_t >= skip_from or skip_bar_t < skip_to) : (skip_bar_t >= skip_from and skip_bar_t < skip_to))
skip_window_open = not in_skip_window
if in_skip_window and strategy.position_size != 0
    strategy.close_all(comment="Skip Window")



// ===== COMPUTED =====
float stop_pts     = stop_dollars / pv
float tp_pts       = tp_dollars / pv
float pullback_pts = pullback_dollars / pv

// ===== SESSION LOGIC =====
bar_hr = hour(time, "America/New_York")
bar_mn = minute(time, "America/New_York")
bar_t  = bar_hr * 100 + bar_mn
int s_start = sess_start_hr * 100 + sess_start_mn
int s_end   = sess_end_hr * 100 + sess_end_mn

bool in_session = not use_session or (s_start > s_end ? (bar_t >= s_start or bar_t < s_end) : (bar_t >= s_start and bar_t < s_end))

prev_hr = hour(time[1], "America/New_York")
prev_mn = minute(time[1], "America/New_York")
prev_t  = prev_hr * 100 + prev_mn
bool was_in_session = not use_session or (s_start > s_end ? (prev_t >= s_start or prev_t < s_end) : (prev_t >= s_start and prev_t < s_end))
bool session_ended = was_in_session and not in_session

if session_ended and strategy.position_size != 0
    strategy.close_all(comment="Session Close")

// ===== SMART TRAIL (SuperTrend-style) =====
atr_val  = ta.atr(sensitivity)
up_level = hl2 - (sensitivity * 0.3) * atr_val
dn_level = hl2 + (sensitivity * 0.3) * atr_val

var float trail = na
var int   trend = 1

trail := na(trail) ? hl2 : trail

if trend == 1
    if close < trail
        trend := -1
        trail := dn_level
    else
        trail := math.max(trail, up_level)
else
    if close > trail
        trend := 1
        trail := up_level
    else
        trail := math.min(trail, dn_level)

// ===== REVERSAL ZONES (Keltner/Bollinger hybrid) =====
zone_basis = ta.ema(close, 20)
zone_rang  = ta.atr(20) * 2.0
zone_upper = zone_basis + zone_rang
zone_lower = zone_basis - zone_rang

// ===== 200 EMA TREND FILTER =====
float ema_val   = ta.ema(close, ema_len)
float ema_slope = ema_val - ema_val[ema_slope_len]
bool  ema_up    = ema_slope > min_slope
bool  ema_dn    = ema_slope < -min_slope

// ===== SIGNAL GENERATION =====
raw_buy  = ta.crossover(trend, 0) and ema_up
raw_sell = ta.crossunder(trend, 0) and ema_dn

// ===== AI CLASSIFICATION =====
rsi_val   = ta.rsi(close, 14)
vol_check = volume > ta.sma(volume, 20)

get_ai_score(is_buy) =>
    score = 2
    if is_buy
        if rsi_val > 60 and vol_check
            score := 4
        else if rsi_val > 50
            score := 3
        else
            score := 1
    else
        if rsi_val < 40 and vol_check
            score := 4
        else if rsi_val < 50
            score := 3
        else
            score := 1
    score

ai_score  = raw_buy ? get_ai_score(true) : raw_sell ? get_ai_score(false) : 0
is_strong = ai_score >= 3

// ===== PULLBACK STATE =====
// When a valid signal fires, arm the pullback. Enter when price returns to EMA.
var bool  armed_long  = false
var bool  armed_short = false
var int   armed_score_long  = 0
var int   armed_score_short = 0

if raw_buy and ai_score >= min_score
    armed_long       := true
    armed_score_long := ai_score
if raw_sell and ai_score >= min_score
    armed_short       := true
    armed_score_short := ai_score

if trend != 1
    armed_long := false
if trend != -1
    armed_short := false

bool near_ema   = math.abs(close - ema_val) <= pullback_pts
bool pull_long  = armed_long and near_ema
bool pull_short = armed_short and near_ema

// ===== ENTRIES =====
var float current_stop    = 0.0
var float peak_profit_pts = 0.0

bool long_ok  = pull_long and in_session and strategy.position_size <= 0
bool short_ok = pull_short and in_session and strategy.position_size >= 0

if long_ok
    current_stop    := close - stop_pts
    peak_profit_pts := 0.0
    armed_long      := false
    if skip_window_open
        strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)
else if short_ok
    current_stop    := close + stop_pts
    peak_profit_pts := 0.0
    armed_short     := false
    if skip_window_open
        strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)

// ===== TRAILING STOP =====
if use_trail
    if strategy.position_size > 0
        float avg        = strategy.position_avg_price
        float profit_now = high - avg
        if profit_now > peak_profit_pts
            peak_profit_pts := profit_now
        if peak_profit_pts >= trail_min_dollars / pv
            float peak_dollars = peak_profit_pts * pv
            int   steps        = math.floor(peak_dollars / trail_step_amt)
            float keep_pct     = math.min(trail_pct + steps * trail_step_pct, 95.0)
            float new_stop     = avg + peak_profit_pts * (keep_pct / 100.0)
            if new_stop > current_stop
                current_stop := new_stop
                strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)
    else if strategy.position_size < 0
        float avg        = strategy.position_avg_price
        float profit_now = avg - low
        if profit_now > peak_profit_pts
            peak_profit_pts := profit_now
        if peak_profit_pts >= trail_min_dollars / pv
            float peak_dollars = peak_profit_pts * pv
            int   steps        = math.floor(peak_dollars / trail_step_amt)
            float keep_pct     = math.min(trail_pct + steps * trail_step_pct, 95.0)
            float new_stop     = avg - peak_profit_pts * (keep_pct / 100.0)
            if new_stop < current_stop
                current_stop := new_stop
                strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)

// ===== PLOT =====
plot(ema_val, "200 EMA", ema_up ? color.lime : ema_dn ? color.red : color.gray, linewidth=2)
plot(trail, "Smart Trail", color = trend == 1 ? #00e676 : #ff5252, linewidth=2)

p_up = plot(zone_upper, "Zone Upper", color=color.new(#ff5252, 50))
p_dn = plot(zone_lower, "Zone Lower", color=color.new(#00e676, 50))
fill(p_up, p_dn, color = trend == 1 ? color.new(#00e676, 95) : color.new(#ff5252, 95), title="Zone Fill")

barcolor(trend == 1 ? (is_strong ? #00e676 : #2962ff) : (is_strong ? #ff5252 : #aa00ff))

plotshape(raw_buy and ai_score >= min_score, "Buy Signal", shape.triangleup, location.belowbar, #00e676, size=size.small)
plotshape(raw_sell and ai_score >= min_score, "Sell Signal", shape.triangledown, location.abovebar, #ff5252, size=size.small)
