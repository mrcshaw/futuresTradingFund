//@version=5
// Built from: Delta Volume BOS Night Shift + POC RSI Reversal v4, VWMA + RSI + Volume MA
strategy("VWMA RSI Volume Pullback", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)

// ===== RISK =====
pv = input.float(100, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=1500)
tp_dollars = input.int(500, "Take Profit ($)", minval=250, maxval=2000)
long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
short_limit = close - tp_dollars / pv

// ===== SESSION =====
use_session = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0, "Session Start Minute")
sess_end_hr = input.int(16, "Session End Hour (ET)")
sess_end_mn = input.int(0, "Session End Minute")

// ===== SKIP WINDOW (a time of day that keeps losing) =====
use_skip      = input.bool(true, "Skip This Time Of Day", group="Skip Window", tooltip="No trade opens inside this window, and an open trade is closed when it starts.")
skip_start_hr = input.int(19, "Skip Start Hour (ET)", minval=0, maxval=23, group="Skip Window")
skip_start_mn = input.int(30, "Skip Start Minute", minval=0, maxval=59, group="Skip Window")
skip_end_hr   = input.int(21, "Skip End Hour (ET)", minval=0, maxval=23, group="Skip Window")
skip_end_mn   = input.int(30, "Skip End Minute", minval=0, maxval=59, group="Skip Window")
skip_bar_t = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")
skip_from = skip_start_hr * 100 + skip_start_mn
skip_to = skip_end_hr * 100 + skip_end_mn
in_skip_window = use_skip and (skip_from > skip_to ? (skip_bar_t >= skip_from or skip_bar_t < skip_to) : (skip_bar_t >= skip_from and skip_bar_t < skip_to))
skip_window_open = not in_skip_window
if in_skip_window and strategy.position_size != 0
    strategy.close_all(comment="Skip Window")


// ===== INDICATORS =====
vwma_len = input.int(20, "VWMA Length", minval=5, maxval=100)
rsi_len = input.int(10, "RSI Length", minval=5, maxval=30)
vol_ma_len = input.int(20, "Volume MA Length", minval=5, maxval=50)
rsi_os = input.int(40, "RSI Oversold", minval=20, maxval=45)
rsi_ob = input.int(55, "RSI Overbought", minval=55, maxval=80)
cooldown_bars = input.int(8, "Cooldown Bars", minval=4, maxval=60)

// ===== CALCULATIONS =====
vwma = ta.vwma(close, vwma_len)
rsi = ta.rsi(close, rsi_len)
vol_ma = ta.sma(volume, vol_ma_len)
vol_ok = volume > vol_ma

long_sig = close > vwma and ta.crossover(rsi, rsi_os) and vol_ok
short_sig = close < vwma and ta.crossunder(rsi, rsi_ob) and vol_ok

// ===== SESSION LOGIC =====
hr = hour(time, "America/New_York")
mn = minute(time, "America/New_York")
after_start = (hr > sess_start_hr) or (hr == sess_start_hr and mn >= sess_start_mn)
before_end = (hr < sess_end_hr) or (hr == sess_end_hr and mn < sess_end_mn)
in_session = use_session ? (after_start or not before_end) : true

// ===== COOLDOWN =====
var int last_entry_bar = 0
can_trade = bar_index - last_entry_bar >= cooldown_bars

// ===== ENTRIES =====
if in_session and can_trade and long_sig and strategy.position_size == 0
    if skip_window_open
        strategy.entry("L", strategy.long)
    strategy.exit("XL", "L", stop=long_stop, limit=long_limit)
    last_entry_bar := bar_index
if in_session and can_trade and short_sig and strategy.position_size == 0
    if skip_window_open
        strategy.entry("S", strategy.short)
    strategy.exit("XS", "S", stop=long_stop, limit=long_limit)
    last_entry_bar := bar_index

// ===== EXITS =====
if strategy.position_size > 0
    strategy.exit("XL", from_entry="L", stop=long_stop, limit=long_limit)
if strategy.position_size < 0
    strategy.exit("XS", from_entry="S", stop=long_stop, limit=long_limit)

// ===== RISK CHECK =====
if strategy.position_size != 0 and strategy.openprofit <= -stop_dollars
    strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION CLOSE =====
if not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session")
