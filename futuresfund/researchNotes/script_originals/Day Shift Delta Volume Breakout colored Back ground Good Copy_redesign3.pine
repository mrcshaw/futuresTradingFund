//@version=5
strategy("Day Shift Delta Volume Breakout colored Back ground Good Copy Redesign 3", overlay=true,
  initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=5.50,
  slippage=1, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false,
  max_bars_back=5000, max_boxes_count=500)

// ===== RISK =====
pv                = input.float(50, "Point Value ($)")
stop_dollars      = input.int(250, "Stop ($)", minval=250, maxval=700)
tp_dollars        = input.int(500, "Take Profit ($)", minval=250)

// Force effective target to be larger than stop by at least one point if invalid
float eff_tp_dollars = tp_dollars <= stop_dollars ? stop_dollars + pv : tp_dollars

long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
short_limit = close - tp_dollars / pv

// Open profit backup close
if strategy.position_size != 0
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")

// ===== VOLUME PROFILE =====
profile_lookback = input.int(120, "Profile Lookback (bars)", minval=20, maxval=2000, step=10)
profile_rows     = input.int(10, "Price Levels (rows)", minval=5, maxval=100, step=5, tooltip="More rows = finer resolution but slower.")

// ===== DELTA VOLUME =====
min_delta_pct = input.float(3.0, "Min Delta Imbalance (%)", minval=0, maxval=80, step=5, tooltip="Net delta at POC must exceed this % of total POC volume to confirm direction. 0 = disabled.")

// ===== TREND FILTER =====
vwma_len       = input.int(50, "Trend VWMA Length", minval=1)
vwma_slope_len = input.int(5, "VWMA Slope Lookback (bars)", minval=1)
min_slope      = input.float(0.1, "Min VWMA Slope (pts)", minval=0, tooltip="0 = disabled.")

// ===== PIVOT =====
pivot_left  = input.int(2, "Pivot Left", minval=1, maxval=10)
pivot_right = input.int(2, "Pivot Right", minval=1, maxval=10)

// ===== FREQUENCY CONTROLS =====
min_bars_between_trades = input.int(12, "Min Bars Between Trades", minval=0, maxval=200)
max_trades_per_session  = input.int(1, "Max Trades Per Session", minval=1, maxval=10)

// ===== SESSION =====
// Fixed Session: 18:00 to 16:00 America/New_York
// Note: time(timeframe.period, session) requires a session string. 
// Since the session crosses midnight, we handle it with boolean logic on hour/minute as in the old script, 
// but we strictly define the start and end times here.
sess_start_hr = 18
sess_start_mn = 0
sess_end_hr   = 16
sess_end_mn   = 0

// ===== COMPUTED =====
float stop_pts = stop_dollars / pv
float tp_pts   = eff_tp_dollars / pv

// ===== SESSION LOGIC =====
bar_hr = hour(time, "America/New_York")
bar_mn = minute(time, "America/New_York")
bar_t  = bar_hr * 100 + bar_mn
int s_start = sess_start_hr * 100 + sess_start_mn
int s_end   = sess_end_hr * 100 + sess_end_mn

// Session is 18:00 to 16:00. This wraps around midnight.
// In session if time >= 18:00 OR time < 16:00
bool in_session = (bar_t >= s_start) or (bar_t < s_end)

prev_hr = hour(time[1], "America/New_York")
prev_mn = minute(time[1], "America/New_York")
prev_t  = prev_hr * 100 + prev_mn
bool was_in_session = (prev_t >= s_start) or (prev_t < s_end)
bool session_ended = was_in_session and not in_session

if session_ended and strategy.position_size != 0
    strategy.close_all(comment="Session Close")

// ===== VWMA TREND =====
float vwma_val   = ta.vwma(close, vwma_len)
float vwma_slope = vwma_val - vwma_val[vwma_slope_len]
bool  vwma_up    = min_slope <= 0 or vwma_slope > min_slope
bool  vwma_dn    = min_slope <= 0 or vwma_slope < -min_slope

// ===== VOLUME PROFILE WITH DELTA =====
int lb   = math.min(profile_lookback, bar_index)
int rows = profile_rows

float prof_hi   = ta.highest(high, lb > 0 ? lb : 1)
float prof_lo   = ta.lowest(low, lb > 0 ? lb : 1)
float prof_span = prof_hi - prof_lo
float step_size = prof_span > 0 ? prof_span / rows : na

var array<float> vol_total = array.new_float(100, 0.0)
var array<float> vol_up    = array.new_float(100, 0.0)
var array<float> vol_dn    = array.new_float(100, 0.0)

float poc_price = na
float poc_hi    = na
float poc_lo    = na
float poc_delta_pct = na
int   poc_row   = 0

if not na(step_size) and prof_span > 0 and lb > 1
    for a = 0 to 2
        arr = a == 0 ? vol_total : a == 1 ? vol_up : vol_dn
        if arr.size() != rows
            arr.clear()
            for i = 0 to rows - 1
                arr.push(0.0)
        else
            for i = 0 to rows - 1
                arr.set(i, 0.0)

    for iBar = 0 to lb - 1
        float bar_vol = volume[iBar]
        if bar_vol <= 0
            continue

        float bar_lo  = low[iBar]
        float bar_hi  = high[iBar]
        bool  bar_up  = close[iBar] >= open[iBar]

        int s_row = math.max(math.floor((bar_lo - prof_lo) / step_size), 0)
        int e_row = math.min(math.floor((bar_hi - prof_lo) / step_size), rows - 1)
        int span  = e_row - s_row + 1

        if span <= 0
            continue

        float per_row = bar_vol / span
        for k = 0 to span - 1
            int r = s_row + k
            if r >= 0 and r < rows
                vol_total.set(r, vol_total.get(r) + per_row)
                if bar_up
                    vol_up.set(r, vol_up.get(r) + per_row)
                else
                    vol_dn.set(r, vol_dn.get(r) + per_row)

    // Find POC
    float max_vol = 0.0
    for r = 0 to rows - 1
        float v = vol_total.get(r)
        if v > max_vol
            max_vol := v
            poc_row := r

    poc_price := prof_lo + (poc_row + 0.5) * step_size
    poc_lo    := prof_lo + poc_row * step_size
    poc_hi    := prof_lo + (poc_row + 1) * step_size

    // Delta at POC
    float poc_up  = vol_up.get(poc_row)
    float poc_dn  = vol_dn.get(poc_row)
    float poc_tot = vol_total.get(poc_row)
    poc_delta_pct := poc_tot > 0 ? ((poc_up - poc_dn) / poc_tot) * 100 : 0.0

// ===== FILTERS =====
bool delta_bull = not na(poc_delta_pct) and poc_delta_pct > 0 and (min_delta_pct <= 0 or poc_delta_pct > min_delta_pct)
bool delta_bear = not na(poc_delta_pct) and poc_delta_pct < 0 and (min_delta_pct <= 0 or poc_delta_pct < -min_delta_pct)

// ===== PIVOT CONFIRMATION =====
// Pivot low: low is lower than highs/lows of pivot_left bars to left and pivot_right bars to right
// Confirmation happens when the bar to the right of the pivot point is confirmed.
// If pivot_right is 2, the pivot point is at bar_index - 2. We confirm on bar_index.
int pv_off = pivot_right
bool pivot_low_confirmed = false
bool pivot_high_confirmed = false
float pivot_low_price = na
float pivot_high_price = na

if bar_index > pivot_left + pivot_right
    // Check pivot low at bar_index - pivot_right
    float pl = low[pivot_right]
    bool is_pl = true
    for i = 1 to pivot_left
        if pl >= low[pivot_right + i]
            is_pl := false
            break
    if is_pl
        for i = 1 to pivot_right
            if pl >= low[pivot_right - i]
                is_pl := false
                break
    if is_pl
        pivot_low_confirmed := true
        pivot_low_price := pl

    // Check pivot high at bar_index - pivot_right
    float ph = high[pivot_right]
    bool is_ph = true
    for i = 1 to pivot_left
        if ph <= high[pivot_right + i]
            is_ph := false
            break
    if is_ph
        for i = 1 to pivot_right
            if ph <= high[pivot_right - i]
                is_ph := false
                break
    if is_ph
        pivot_high_confirmed := true
        pivot_high_price := ph

// ===== ENTRY LOGIC (PULLBACK) =====
// Long: Close is inside POC zone, VWMA trend is up, Delta is positive, and a pivot low is confirmed inside the POC zone.
bool inside_poc_zone = not na(poc_lo) and not na(poc_hi) and close >= poc_lo and close <= poc_hi

bool long_entry_sig = false
bool short_entry_sig = false

// Long Conditions
if inside_poc_zone and vwma_up and delta_bull and pivot_low_confirmed and not na(pivot_low_price) and pivot_low_price >= poc_lo and pivot_low_price <= poc_hi
    long_entry_sig := true

// Short Conditions
if inside_poc_zone and vwma_dn and delta_bear and pivot_high_confirmed and not na(pivot_high_price) and pivot_high_price >= poc_lo and pivot_high_price <= poc_hi
    short_entry_sig := true

// ===== FREQUENCY CONTROLS IMPLEMENTATION =====
var int last_entry_bar = 0
var int session_trade_count = 0

// Reset session trade count when session ends
if session_ended
    session_trade_count := 0

// Check cooldown
bool cooldown_ok = (bar_index - last_entry_bar) >= min_bars_between_trades
// Check max trades
bool max_trades_ok = session_trade_count < max_trades_per_session

// ===== FINAL ENTRY LOGIC =====
bool do_long_entry = long_entry_sig and in_session and strategy.position_size <= 0 and cooldown_ok and max_trades_ok
bool do_short_entry = short_entry_sig and in_session and strategy.position_size >= 0 and cooldown_ok and max_trades_ok

if do_long_entry
    last_entry_bar := bar_index
    session_trade_count += 1
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)

else if do_short_entry
    last_entry_bar := bar_index
    session_trade_count += 1
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)

// ===== PLOT =====
plot(vwma_val, "VWMA", vwma_up ? color.lime : vwma_dn ? color.red : color.gray, linewidth=2)
float plo  = not na(poc_lo) ? poc_lo : na
float ppoc = not na(poc_price) ? poc_price : na
float phi  = not na(poc_hi) ? poc_hi : na
plot_lo  = plot(plo, "POC Low", #2962FF, style=plot.style_stepline, linewidth=2)
plot_poc = plot(ppoc, "POC", color.yellow, style=plot.style_stepline, linewidth=1)
plot_hi  = plot(phi, "POC High", #2962FF, style=plot.style_stepline, linewidth=2)
fill(plot_lo, plot_hi, color.new(color.blue, 90))

plotshape(do_long_entry, "Long Signal", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(do_short_entry, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

plot(not na(poc_delta_pct) ? poc_delta_pct : na, "POC Delta %", color.orange, display=display.data_window)
