//@version=5
// MNQ 5m POC delta breakout with VWMA trend filter, pivot confirmation,
// and one reversal trade after a stop-out.
// Arms on a POC-zone breakout (not inside the zone), confirms with a pivot,
// filters with VWMA slope and POC delta, and allows a single reversal
// entry after a stop-out. Flattens at 16:00 New York.

strategy("Day Shift Delta Volume Breakout Redesign 1", overlay=true,
  initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=5.50,
  slippage=1, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false,
  max_bars_back=5000, max_boxes_count=500)

// ===== RISK =====
pv           = input.float(100, "Point Value ($)")
stop_dollars = input.int(250, "Stop ($)", minval=250, maxval=700)
tp_dollars   = input.int(500, "Take Profit ($)", minval=250)

// ===== VOLUME PROFILE =====
profile_lookback = input.int(120, "Profile Lookback (bars)", minval=20, maxval=2000, step=10)
profile_rows     = input.int(15, "Price Levels (rows)", minval=5, maxval=100, step=5, tooltip="More rows = finer resolution but slower.")

// ===== DELTA VOLUME =====
min_delta_pct = input.float(8.0, "Min Delta Imbalance (%)", minval=0, maxval=80, step=5, tooltip="Net delta at POC must exceed this % of total POC volume to confirm direction. 0 = disabled.")

// ===== TREND FILTER =====
vwma_len       = input.int(25, "VWMA Length", minval=1)
vwma_slope_len = input.int(5, "VWMA Slope Lookback (bars)", minval=1)
min_slope      = input.float(0.5, "Min VWMA Slope (pts)", minval=0.0, tooltip="0 = disabled.")

// ===== PIVOT CONFIRMATION =====
pivot_len = input.int(2, "Pivot Length", minval=1, maxval=10)

// ===== COMPUTED =====
float stop_pts = stop_dollars / pv
float tp_pts   = tp_dollars / pv

// ===== SESSION LOGIC (18:00 - 16:00 New York) =====
string trade_session = "1800-1600"
bool in_session = not na(time(timeframe.period, trade_session))

int bar_hr = hour(time, "America/New_York")
int bar_mn = minute(time, "America/New_York")
bool is_1600 = bar_hr == 16 and bar_mn == 0

// ===== VWMA TREND =====
float vwma_val   = ta.vwma(close, vwma_len)
float vwma_slope = vwma_val - vwma_val[vwma_slope_len]
bool  vwma_up    = min_slope <= 0 or vwma_slope > min_slope
bool  vwma_dn    = min_slope <= 0 or vwma_slope < -min_slope

// ===== VOLUME PROFILE WITH DELTA =====
int lb   = math.min(profile_lookback, bar_index)
int rows = profile_rows

float prof_hi   = ta.highest(high, lb > 0 ? lb : 1)
float prof_lo   = ta.lowest(low, lb > 0 ? lb : 1)
float prof_span = prof_hi - prof_lo
float step_size = prof_span > 0 ? prof_span / rows : na

var array<float> vol_total = array.new_float(100, 0.0)
var array<float> vol_up    = array.new_float(100, 0.0)
var array<float> vol_dn    = array.new_float(100, 0.0)

float poc_price     = na
float poc_hi        = na
float poc_lo        = na
float poc_delta_pct = na
int   poc_row       = 0

if not na(step_size) and prof_span > 0 and lb > 1
    for a = 0 to 2
        array<float> arr = a == 0 ? vol_total : a == 1 ? vol_up : vol_dn
        if arr.size() != rows
            arr.clear()
            for i = 0 to rows - 1
                arr.push(0.0)
        else
            for i = 0 to rows - 1
                arr.set(i, 0.0)

    for iBar = 0 to lb - 1
        float bar_vol = volume[iBar]
        if bar_vol <= 0
            continue

        float bar_lo  = low[iBar]
        float bar_hi  = high[iBar]
        bool  bar_up  = close[iBar] >= open[iBar]

        int s_row = math.max(math.floor((bar_lo - prof_lo) / step_size), 0)
        int e_row = math.min(math.floor((bar_hi - prof_lo) / step_size), rows - 1)
        int span  = e_row - s_row + 1

        if span <= 0
            continue

        float per_row = bar_vol / span
        for k = 0 to span - 1
            int r = s_row + k
            if r >= 0 and r < rows
                vol_total.set(r, vol_total.get(r) + per_row)
                if bar_up
                    vol_up.set(r, vol_up.get(r) + per_row)
                else
                    vol_dn.set(r, vol_dn.get(r) + per_row)

    float max_vol = 0.0
    for r = 0 to rows - 1
        float v = vol_total.get(r)
        if v > max_vol
            max_vol := v
            poc_row := r

    poc_price := prof_lo + (poc_row + 0.5) * step_size
    poc_lo    := prof_lo + poc_row * step_size
    poc_hi    := prof_lo + (poc_row + 1) * step_size

    float poc_up  = vol_up.get(poc_row)
    float poc_dn  = vol_dn.get(poc_row)
    float poc_tot = vol_total.get(poc_row)
    poc_delta_pct := poc_tot > 0 ? ((poc_up - poc_dn) / poc_tot) * 100 : 0.0

// ===== BREAKOUT DETECTION (arm on breakout, not inside zone) =====
bool above_poc = not na(poc_hi) and close > poc_hi and close[1] <= poc_hi
bool below_poc = not na(poc_lo) and close < poc_lo and close[1] >= poc_lo

bool delta_bull = not na(poc_delta_pct) and poc_delta_pct > 0 and (min_delta_pct <= 0 or poc_delta_pct > min_delta_pct)
bool delta_bear = not na(poc_delta_pct) and poc_delta_pct < 0 and (min_delta_pct <= 0 or poc_delta_pct < -min_delta_pct)

bool in_poc_channel = not na(poc_lo) and not na(poc_hi) and close >= poc_lo and close <= poc_hi

// ===== ARM STATE =====
var int  armed_dir = 0
var bool reversal_armed = false

// Reset arm when price returns inside the POC zone
if in_poc_channel
    armed_dir := 0

// Arm long on breakout above POC with bullish delta and up VWMA slope
if above_poc and delta_bull and vwma_up and not in_poc_channel
    armed_dir := 1

// Arm short on breakout below POC with bearish delta and down VWMA slope
if below_poc and delta_bear and vwma_dn and not in_poc_channel
    armed_dir := -1

// ===== PIVOT CONFIRMATION =====
bool pivot_high_conf = not na(ta.pivothigh(high, pivot_len, pivot_len))
bool pivot_low_conf  = not na(ta.pivotlow(low, pivot_len, pivot_len))

// ===== REVERSAL LOGIC =====
// Detect a stop-out exit (comment "Open P&L > SL Risk")
var bool stop_out_pending = false
if strategy.position_size == 0 and strategy.position_size[1] != 0
    if strategy.closedtrades > 0
        string last_exit_comment = strategy.closedtrades.exit_comment(strategy.closedtrades - 1)
        if last_exit_comment == "Open P&L > SL Risk"
            stop_out_pending := true

// Allow one reversal trade in the opposite direction after a stop-out
bool reversal_long  = stop_out_pending and pivot_low_conf and vwma_up  and in_session and strategy.position_size <= 0
bool reversal_short = stop_out_pending and pivot_high_conf and vwma_dn and in_session and strategy.position_size >= 0

// ===== ENTRY SIGNALS =====
bool long_sig  = armed_dir == 1 and pivot_high_conf and in_session and strategy.position_size <= 0
bool short_sig = armed_dir == -1 and pivot_low_conf and in_session and strategy.position_size >= 0

// ===== EXITS =====
long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
short_limit = close - tp_dollars / pv

// Refresh exit orders every bar while in a position (stop at entry, limit tracks close)
if strategy.position_size > 0
    strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)
else if strategy.position_size < 0
    strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)

// Close if open profit <= -stop_dollars
if strategy.position_size != 0
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")

// Flatten at session end (16:00 New York)
if is_1600 and strategy.position_size != 0
    strategy.close_all(comment="Session Close")

// ===== ENTRIES =====
if long_sig
    armed_dir := 0
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)
else if short_sig
    armed_dir := 0
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)
else if reversal_long
    stop_out_pending := false
    armed_dir        := 0
    strategy.entry("LongRev", strategy.long)
    strategy.exit("XL", "LongRev", stop=long_stop, limit=long_limit)
else if reversal_short
    stop_out_pending := false
    armed_dir        := 0
    strategy.entry("ShortRev", strategy.short)
    strategy.exit("XS", "ShortRev", stop=short_stop, limit=short_limit)

// ===== POC PRESSURE FILL =====
float delta_strength = 0.0
color channel_fill = na
if not na(poc_delta_pct) and min_delta_pct > 0
    if poc_delta_pct > min_delta_pct
        delta_strength := math.min(1.0, poc_delta_pct / min_delta_pct)
        channel_fill := color.new(color.green, 95 - math.round(delta_strength * 45))
    else if poc_delta_pct < -min_delta_pct
        delta_strength := math.min(1.0, -poc_delta_pct / min_delta_pct)
        channel_fill := color.new(color.red, 95 - math.round(delta_strength * 45))

// ===== POC DELTA LABEL =====
var label lbl_poc = na
if not na(poc_hi) and not na(poc_lo) and not na(poc_delta_pct)
    float mid_y = (poc_lo + poc_hi) / 2
    string txt = poc_delta_pct >= 0 ? "+" + str.tostring(poc_delta_pct, "#.#") + "%" : str.tostring(poc_delta_pct, "#.#") + "%"
    if na(lbl_poc)
        lbl_poc := label.new(bar_index, mid_y, txt, style=label.style_label_center, color=color.new(color.gray, 70), textcolor=color.white, size=size.normal)
    else
        label.set_xy(lbl_poc, bar_index, mid_y)
        label.set_text(lbl_poc, txt)

// ===== PLOT =====
plot(vwma_val, "VWMA", vwma_up ? color.lime : vwma_dn ? color.red : color.gray, linewidth=2)
float plo  = not na(poc_lo) ? poc_lo : na
float ppoc = not na(poc_price) ? poc_price : na
float phi  = not na(poc_hi) ? poc_hi : na
plot_lo  = plot(plo, "POC Low", #2962FF, style=plot.style_stepline, linewidth=2)
plot_poc = plot(ppoc, "POC", color.yellow, style=plot.style_stepline, linewidth=1)
plot_hi  = plot(phi, "POC High", #2962FF, style=plot.style_stepline, linewidth=2)
fill(plot_lo, plot_hi, channel_fill)
plot(strategy.position_size != 0 ? (strategy.position_size > 0 ? strategy.position_avg_price - stop_pts : strategy.position_avg_price + stop_pts) : na, "Stop", color.fuchsia, style=plot.style_stepline, linewidth=2)

plotshape(long_sig or reversal_long, "Long Signal", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(short_sig or reversal_short, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

plot(not na(poc_delta_pct) ? poc_delta_pct : na, "POC Delta %", color.orange, display=display.data_window)
hline(0, "Zero", color=color.gray, linestyle=hline.style_dotted)

bgcolor(in_session ? na : color.new(color.gray, 92))
