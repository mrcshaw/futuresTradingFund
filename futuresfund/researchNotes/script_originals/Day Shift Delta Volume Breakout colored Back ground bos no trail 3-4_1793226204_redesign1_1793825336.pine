//@version=5
// How this script works
// The script opens a long when long_entry_sig is true and a short when short_entry_sig is true, using strategy.entry for the selected side.
// Its stop is the strategy.exit stop, set to long_stop for longs and short_stop for shorts from the stop_dollars input divided by the point value.
// It also sets a limit at tp_dollars divided by the point value and can close all positions at session end when the session filter is enabled.

strategy("Day Shift Delta Volume Breakout Redesign 1", overlay=true,
  initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=5.50,
  slippage=1, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false,
  max_bars_back=5000)
// ===== RISK =====
pv                = input.float(50, "Point Value ($)")
stop_dollars      = input.int(250, "Stop ($)", minval=250, maxval=700)
tp_dollars        = input.int(500, "Take Profit ($)", minval=250)
long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
short_limit = close - tp_dollars / pv
if strategy.position_size != 0 and not na(stop_dollars)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")

// ===== INPUTS =====

vwma_len          = input.int(50, "Trend VWMA Length", minval=1, maxval=500)
vwma_slope_len    = input.int(5, "VWMA Slope Lookback (bars)", minval=1, maxval=100)
min_slope         = input.float(0.0, "Min VWMA Slope (pts)", minval=0.0, maxval=10.0)

use_session       = input.bool(true, "Use Session Filter")
sess_start_hr     = input.int(18, "Session Start Hour (ET)", minval=0, maxval=23)
sess_start_mn     = input.int(0,  "Session Start Minute", minval=0, maxval=59)
sess_end_hr       = input.int(16,  "Session End Hour (ET)", minval=0, maxval=23)
sess_end_mn       = input.int(0,  "Session End Minute", minval=0, maxval=59)

profile_lookback  = input.int(100, "Profile Lookback (bars)", minval=10, maxval=500)
poc_zone_pct      = input.float(10.0, "POC Zone % of Range", minval=1.0, maxval=50.0)
delta_min_pct     = input.float(10.0, "Min POC Delta %", minval=0.0, maxval=100.0)
pivot_len         = input.int(5, "Pivot Length", minval=1, maxval=50)
use_reversal      = input.bool(false, "Use Reversal Logic")

// ===== SESSION LOGIC =====
// Construct session string dynamically is not allowed in time() directly with variables in older versions,
// but in v5 we can use a fixed string if inputs are static, or we must use a workaround.
// However, time() requires a string literal.
// We will use a fixed session string based on defaults, but the inputs allow changing the *logic* of entry/exit.
// To strictly follow "time(timeframe.period, session)", we need a string.
// Since inputs are dynamic, we cannot pass them directly to time().
// Workaround: We will define the session string based on the inputs at compile time? No, inputs are runtime.
// Standard practice in Pine for dynamic sessions is to use `time(timeframe.period, "0000-2359")` and filter with `hour`/`minute` or use `session` variable if it's a string input.
// The prompt says: "time(timeframe.period, session) takes a session such as '0930-1600'".
// It also says "Give each new input a default...".
// If I use dynamic inputs for session start/end, I cannot pass them to `time()` directly.
// I will use a static session string "0000-2359" for the `time()` call to get the NY time, and then manually check if the current time is within the specified hours/minutes.
// OR, I can use `input.session` which returns a string. But the prompt asks for `sess_start_hr` etc.
// Let's stick to manual time checking for the "in_session" boolean, and use `time(timeframe.period, "0000-2359", "America/New_York")` to get the NY time components?
// Actually, `time(timeframe.period, "0000-2359", "America/New_York")` returns the time in NY.
// We can extract hour and minute from that.

ny_time = time(timeframe.period, "0000-2359", "America/New_York")
ny_hour = hour(ny_time, "America/New_York")
ny_minute = minute(ny_time, "America/New_York")

in_session = false
if use_session
    // Check if current NY time is between start and end
    // Handle overnight sessions (e.g., 18:00 to 16:00)
    start_minutes = sess_start_hr * 60 + sess_start_mn
    end_minutes   = sess_end_hr * 60 + sess_end_mn
    current_minutes = ny_hour * 60 + ny_minute

    if start_minutes < end_minutes
        in_session := current_minutes >= start_minutes and current_minutes < end_minutes
    else
        // Overnight session
        in_session := current_minutes >= start_minutes or current_minutes < end_minutes

// Flatten at 16:00 NY
is_flatten_time = (ny_hour == 16 and ny_minute == 0)

// ===== TREND FILTER =====
vwma_val = ta.vwma(close, vwma_len)
vwma_slope = vwma_val - vwma_val[vwma_slope_len]

trend_long  = vwma_slope > min_slope
trend_short = vwma_slope < -min_slope

// ===== VOLUME PROFILE CALCULATION =====
// We need to calculate POC and Delta over the last `profile_lookback` bars.
// We will use arrays to store up/down volume per bin.
int bin_count = 50
var array<float> up_vols = array.new_float(bin_count, 0.0)
var array<float> down_vols = array.new_float(bin_count, 0.0)

// Reset arrays
for i = 0 to bin_count - 1
    array.set(up_vols, i, 0.0)
    array.set(down_vols, i, 0.0)

// Get High and Low of the lookback period
float high_range = ta.highest(high, profile_lookback)
float low_range  = ta.lowest(low, profile_lookback)
float range_size = high_range - low_range
float bin_size   = range_size / bin_count

// Iterate through lookback bars to build profile
for i = 0 to profile_lookback - 1
    float price = close[i]
    // Map price to bin index
    int bin_idx = math.floor((price - low_range) / bin_size)
    // Clamp bin index
    if bin_idx < 0
        bin_idx := 0
    if bin_idx >= bin_count
        bin_idx := bin_count - 1

    float vol = volume[i]
    if close[i] > open[i]
        array.set(up_vols, bin_idx, array.get(up_vols, bin_idx) + vol)
    else
        array.set(down_vols, bin_idx, array.get(down_vols, bin_idx) + vol)

// Find POC (Max Volume Bin)
int poc_idx = 0
float max_vol = 0.0
for i = 0 to bin_count - 1
    float total_vol = array.get(up_vols, i) + array.get(down_vols, i)
    if total_vol > max_vol
        max_vol := total_vol
        poc_idx := i

// Calculate POC Price and Zone
float poc_price = low_range + (poc_idx + 0.5) * bin_size
float poc_zone_width = range_size * (poc_zone_pct / 100.0)
float poc_zone_high = poc_price + poc_zone_width
float poc_zone_low  = poc_price - poc_zone_width

// Calculate POC Delta
float poc_up_vol   = array.get(up_vols, poc_idx)
float poc_down_vol = array.get(down_vols, poc_idx)
float poc_total_vol = poc_up_vol + poc_down_vol
float poc_delta = 0.0
if poc_total_vol > 0
    poc_delta := (poc_up_vol - poc_down_vol) / poc_total_vol * 100.0

// ===== ARMING LOGIC =====
var bool armed_long = false
var bool armed_short = false
var bool reversal_allowed = false
var int last_exit_dir = 0 // 1 for long stop, -1 for short stop

// Check if close is inside POC zone
bool inside_poc_zone = close >= poc_zone_low and close <= poc_zone_high

// Update Arm States
// Long Arm: Close breaks above POC Zone, Trend Long, Delta >= Min
if close > poc_zone_high and trend_long and poc_delta >= delta_min_pct
    armed_long := true
    armed_short := false
    // Reset reversal if new breakout? Plan: "disable reversal until the next POC breakout"
    // So a new breakout resets the reversal flag?
    // "take one opposite-direction trade... then disable reversal until the next POC breakout"
    // This implies the reversal flag is cleared on a *new* POC breakout.
    reversal_allowed := false

// Short Arm: Close breaks below POC Zone, Trend Short, Delta <= -Min
if close < poc_zone_low and trend_short and poc_delta <= -delta_min_pct
    armed_short := true
    armed_long := false
    reversal_allowed := false

// Disarm if close returns inside POC zone
if inside_poc_zone
    armed_long := false
    armed_short := false

// ===== PIVOT LOGIC =====
// ta.pivothigh returns the value of the pivot high, or na.
// It confirms `pivot_len` bars later.
// We need to check if a pivot high was confirmed in the previous bar.
// `ta.pivothigh(high, pivot_len, pivot_len)` returns the high of the pivot bar if a pivot is confirmed at the current bar (which is `pivot_len` bars after the pivot).
// To enter on the *break* of the pivot, we need to know the pivot price and check if current close breaks it.
// However, `ta.pivothigh` only gives the value when the pivot is *confirmed*.
// A common pattern:
// `ph = ta.pivothigh(high, pivot_len, pivot_len)`
// If `ph` is not na, a pivot high was confirmed `pivot_len` bars ago.
// But we want to enter when close *breaks* the pivot.
// If we use `ph`, we know the price level. We can check if `close > ph` (for long).
// But `ph` is only available on the confirmation bar.
// If we enter on the confirmation bar, we are entering on the bar where the pivot is confirmed.
// The plan says: "enter on the next confirmed pivot in the armed direction... long on a pivot high break".
// This usually means: Identify a pivot high. Wait for price to break above it.
// Since `ta.pivothigh` confirms late, we might miss the initial break.
// Alternative: Use `ta.pivotlow`/`ta.pivothigh` to identify the level, and store it.
// Let's store the last confirmed pivot high and low.

var float last_pivot_high = na
var float last_pivot_low  = na

ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low, pivot_len, pivot_len)

if not na(ph)
    last_pivot_high := ph
if not na(pl)
    last_pivot_low := pl

// Entry Conditions
// Long: Armed Long, Close > Last Pivot High
// Short: Armed Short, Close < Last Pivot Low
// Reversal: If reversal_allowed, allow opposite entry on pivot break.

bool long_entry_sig = false
bool short_entry_sig = false

if in_session and strategy.position_size == 0
    // Standard Long
    if armed_long and not na(last_pivot_high) and close > last_pivot_high
        long_entry_sig := true

    // Standard Short
    if armed_short and not na(last_pivot_low) and close < last_pivot_low
        short_entry_sig := true

    // Reversal Logic
    if use_reversal and reversal_allowed
        // If last exit was Long (stopped out), look for Short entry
        if last_exit_dir == 1 and not na(last_pivot_low) and close < last_pivot_low
            short_entry_sig := true
            reversal_allowed := false // Disable after use

        // If last exit was Short (stopped out), look for Long entry
        if last_exit_dir == -1 and not na(last_pivot_high) and close > last_pivot_high
            long_entry_sig := true
            reversal_allowed := false // Disable after use

// ===== EXECUTION =====
// Exits

// Check for Stop Outs to trigger Reversal Logic
// We need to detect if a position was closed by stop.
// `strategy.closedtrades` can help, but simpler:
// If we were long and now size is 0, and the close was below the stop?
// Or use `strategy.position_size` change.
// Let's track previous position size.
var int prev_pos_size = 0

if strategy.position_size != prev_pos_size
    if prev_pos_size > 0 and strategy.position_size == 0
        // Long position closed
        // Check if it was a stop out
        // We can approximate by checking if the low of the current bar went below the stop?
        // Or simply assume if it closed and we didn't take profit, it might be stop.
        // Better: Use `strategy.closedtrades.profit`?
        // For simplicity and robustness in Pine, we can check if the close is below the entry - stop?
        // Actually, `strategy.exit` handles the stop.
        // To trigger reversal, we need to know *why* it closed.
        // If `use_reversal` is true, we can set `last_exit_dir` when a position closes.
        // We don't know for sure if it was stop or TP without checking P&L.
        // If P&L is negative, it's likely a stop.
        float last_trade_pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
        if last_trade_pnl < 0
            last_exit_dir := 1 // Long stopped out
            if use_reversal
                reversal_allowed := true
    if prev_pos_size < 0 and strategy.position_size == 0
        // Short position closed
        float last_trade_pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
        if last_trade_pnl < 0
            last_exit_dir := -1 // Short stopped out
            if use_reversal
                reversal_allowed := true

prev_pos_size := strategy.position_size

// Execute Entries
if long_entry_sig
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)

if short_entry_sig
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)

// Manage Exits (Execute on every bar while position is open)
if strategy.position_size > 0
    strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)
if strategy.position_size < 0
    strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)

// Flatten at Session End
if is_flatten_time and strategy.position_size != 0
    strategy.close_all(comment="Session End")

// ===== PLOTS =====
plot(vwma_val, "VWMA", color.blue, linewidth=2)
plot(poc_price, "POC", color.red, style=plot.style_linebr, linewidth=2)
plot(poc_zone_high, "POC Zone High", color.orange, style=plot.style_linebr)
plot(poc_zone_low, "POC Zone Low", color.orange, style=plot.style_linebr)
plotshape(long_entry_sig, "Long Signal", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(short_entry_sig, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)
bgcolor(in_session ? color.new(color.green, 95) : na)
