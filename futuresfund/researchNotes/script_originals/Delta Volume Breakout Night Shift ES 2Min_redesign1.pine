//@version=5
strategy("Delta Volume Breakout Night Shift Redesign 1", overlay=true,
  initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=5.50,
  slippage=1, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false,
  max_bars_back=5000)
// ===== RISK =====
pv                = input.float(20, "Point Value ($)")
stop_dollars      = input.int(250, "Stop ($)", minval=250, maxval=700)
tp_dollars        = input.int(500, "Take Profit ($)", minval=250)
use_trail         = input.bool(false, "Enable Trailing Stop")
trail_pct         = input.float(50, "Trail keep (%)", minval=0, maxval=100)
trail_step_amt    = input.int(500, "Trail: Tighten every ($)", minval=0, maxval=2000)
trail_step_pct    = input.float(50, "Trail step (%)", minval=0, maxval=100)
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)", minval=0, maxval=2000)
long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
short_limit = close - tp_dollars / pv
if strategy.position_size != 0 and not na(stop_dollars)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")

// ===== INPUTS =====

// Profile
profile_lookback  = input.int(33, "Profile Lookback (bars)", minval=5, maxval=200)
profile_rows      = input.int(10, "Price Levels (rows)", minval=5, maxval=100)
min_delta_pct     = input.float(10.0, "Min Delta Imbalance (%)", minval=0, maxval=80)

// Trend
vwma_len          = input.int(50, "VWMA Length", minval=1, maxval=500)
vwma_slope_len    = input.int(5, "VWMA Slope Lookback (bars)", minval=1, maxval=50)

// Entry
pivot_len         = input.int(3, "Pivot Length", minval=1, maxval=20)
use_reversal      = input.bool(true, "Use Reversal Entry")

// ===== SESSION =====
sess_str = "1800-1600"
in_session = not na(time(timeframe.period, sess_str))

// Flatten at session end
if strategy.position_size != 0 and not in_session
    strategy.close_all(comment="Session Close")

// ===== VOLUME PROFILE =====
int lb = math.min(profile_lookback, bar_index)
int rows = profile_rows

float prof_hi = na
float prof_lo = na

if lb > 0
    // Calculate high/low excluding current bar
    float max_h = low[1]
    float min_l = high[1]
    for i = 1 to lb
        max_h := math.max(max_h, high[i])
        min_l := math.min(min_l, low[i])
    prof_hi := max_h
    prof_lo := min_l

float prof_span = prof_hi - prof_lo
float step_size = prof_span > 0 ? prof_span / rows : na

var array<float> vol_total = array.new_float(100, 0.0)
var array<float> vol_up    = array.new_float(100, 0.0)
var array<float> vol_dn    = array.new_float(100, 0.0)

float poc_price = na
float poc_hi    = na
float poc_lo    = na
float poc_delta_pct = na
int   poc_row   = 0

if not na(step_size) and prof_span > 0 and lb > 1
    // Initialize arrays
    for a = 0 to 2
        arr = a == 0 ? vol_total : a == 1 ? vol_up : vol_dn
        if arr.size() != rows
            arr.clear()
            for i = 0 to rows - 1
                arr.push(0.0)
        else
            for i = 0 to rows - 1
                arr.set(i, 0.0)

    // Populate profile
    for iBar = 1 to lb
        float bar_vol = volume[iBar]
        if bar_vol <= 0
            continue

        float bar_lo  = low[iBar]
        float bar_hi  = high[iBar]
        bool  bar_up  = close[iBar] >= open[iBar]

        int s_row = math.max(math.floor((bar_lo - prof_lo) / step_size), 0)
        int e_row = math.min(math.floor((bar_hi - prof_lo) / step_size), rows - 1)
        int span  = e_row - s_row + 1

        if span <= 0
            continue

        float per_row = bar_vol / span
        for k = 0 to span - 1
            int r = s_row + k
            if r >= 0 and r < rows
                vol_total.set(r, vol_total.get(r) + per_row)
                if bar_up
                    vol_up.set(r, vol_up.get(r) + per_row)
                else
                    vol_dn.set(r, vol_dn.get(r) + per_row)

    // Find POC
    float max_vol = 0.0
    for r = 0 to rows - 1
        float v = vol_total.get(r)
        if v > max_vol
            max_vol := v
            poc_row := r

    poc_price := prof_lo + (poc_row + 0.5) * step_size
    poc_lo    := prof_lo + poc_row * step_size
    poc_hi    := prof_lo + (poc_row + 1) * step_size

    // Delta at POC
    float poc_up  = vol_up.get(poc_row)
    float poc_dn  = vol_dn.get(poc_row)
    float poc_tot = vol_total.get(poc_row)
    poc_delta_pct := poc_tot > 0 ? ((poc_up - poc_dn) / poc_tot) * 100 : 0.0

// ===== TREND FILTER =====
float vwma_val   = ta.vwma(close, vwma_len)
float vwma_slope = vwma_val - vwma_val[vwma_slope_len]
bool  long_trend  = close > vwma_val and vwma_slope > 0
bool  short_trend = close < vwma_val and vwma_slope < 0

// ===== ARMING LOGIC =====
var int armed_dir = 0

// Breakout conditions
bool above_poc = not na(poc_hi) and close > poc_hi and close[1] <= poc_hi
bool below_poc = not na(poc_lo) and close < poc_lo and close[1] >= poc_lo

bool delta_bull = min_delta_pct <= 0 or (not na(poc_delta_pct) and poc_delta_pct > min_delta_pct)
bool delta_bear = min_delta_pct <= 0 or (not na(poc_delta_pct) and poc_delta_pct < -min_delta_pct)

// Arm
if above_poc and long_trend and delta_bull
    armed_dir := 1
else if below_poc and short_trend and delta_bear
    armed_dir := -1

// Disarm if close returns inside POC zone
if not na(poc_lo) and not na(poc_hi)
    if close >= poc_lo and close <= poc_hi
        armed_dir := 0

// ===== PIVOT ENTRY =====
float pl = ta.pivotlow(low, pivot_len, pivot_len)
float ph = ta.pivothigh(high, pivot_len, pivot_len)

var bool reversal_allowed = false
var float entry_price = na
var float stop_price = na
var int last_exit_dir = 0

// Detect stop out for reversal
if strategy.position_size[1] != 0 and strategy.position_size == 0
    // Check if it was a stop out
    bool was_stop = false
    if strategy.position_size[1] > 0
        if not na(stop_price) and close < stop_price
            was_stop := true
    else if strategy.position_size[1] < 0
        if not na(stop_price) and close > stop_price
            was_stop := true
    
    if was_stop and use_reversal
        reversal_allowed := true
    last_exit_dir := strategy.position_size[1] > 0 ? 1 : -1

// Clear reversal flag at session end
if not in_session
    reversal_allowed := false

// Entry Logic
bool long_entry_sig = false
bool short_entry_sig = false

if in_session and strategy.position_size == 0
    if armed_dir == 1 and not na(pl) and pl > poc_hi
        if not reversal_allowed
            long_entry_sig := true
        else
            if last_exit_dir == -1
                long_entry_sig := true
    
    if armed_dir == -1 and not na(ph) and ph < poc_lo
        if not reversal_allowed
            short_entry_sig := true
        else
            if last_exit_dir == 1
                short_entry_sig := true

// ===== EXITS =====
float stop_pts = stop_dollars / pv
float tp_pts   = tp_dollars / pv


// ===== ENTRIES =====
if long_entry_sig
    entry_price := close
    stop_price := close - stop_pts
    reversal_allowed := false
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)
else if short_entry_sig
    entry_price := close
    stop_price := close + stop_pts
    reversal_allowed := false
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)

// Update exits every bar while in position
if strategy.position_size > 0
    strategy.exit("XL", "Long", stop=long_stop, limit=long_limit)
else if strategy.position_size < 0
    strategy.exit("XS", "Short", stop=short_stop, limit=short_limit)

// ===== PLOTS =====
plot(vwma_val, "VWMA", long_trend ? color.lime : short_trend ? color.red : color.gray, linewidth=2)

float plo  = not na(poc_lo) ? poc_lo : na
float ppoc = not na(poc_price) ? poc_price : na
float phi  = not na(poc_hi) ? poc_hi : na

plot_lo  = plot(plo, "POC Low", #2962FF, style=plot.style_stepline, linewidth=2)
plot_poc = plot(ppoc, "POC", color.yellow, style=plot.style_stepline, linewidth=1)
plot_hi  = plot(phi, "POC High", #2962FF, style=plot.style_stepline, linewidth=2)

color channel_fill = color.new(color.gray, 95)
if not na(poc_delta_pct)
    if poc_delta_pct > min_delta_pct
        channel_fill := color.new(color.green, 90)
    else if poc_delta_pct < -min_delta_pct
        channel_fill := color.new(color.red, 90)

fill(plot_lo, plot_hi, channel_fill)

plotshape(long_entry_sig, "Long Signal", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(short_entry_sig, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

plot(not na(poc_delta_pct) ? poc_delta_pct : na, "POC Delta %", color.orange, display=display.data_window)
