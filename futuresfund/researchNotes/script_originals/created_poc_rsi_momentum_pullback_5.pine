//@version=5
// Built from: POC Pullback Momentum v2, RSI 3system v2, <RSI, ATR, Pivot Structure>
strategy("POC RSI Momentum Pullback", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv                = input.float(20, "Point Value ($)")
stop_dollars      = input.int(250, "Stop ($)", minval=250, maxval=750)
tp_dollars        = input.int(500, "Take Profit ($)", minval=250)
use_trail         = input.bool(false, "Enable Trailing Stop")
trail_pct         = input.float(50, "Trail keep (%)", minval=0, maxval=100)
trail_step_amt    = input.int(500, "Trail: Tighten every ($)", minval=0, maxval=2000)
trail_step_pct    = input.float(50, "Trail step (%)", minval=0, maxval=100)
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)", minval=0, maxval=2000)
long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
short_limit = close - tp_dollars / pv
if strategy.position_size != 0 and not na(stop_dollars)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")

// ===== SESSION =====
use_session   = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0,  "Session Start Minute")
sess_end_hr   = input.int(16,  "Session End Hour (ET)")
sess_end_mn   = input.int(0,  "Session End Minute")
sess_bar_hr = hour(time, "America/New_York")
sess_bar_mn = minute(time, "America/New_York")
sess_bar_t = sess_bar_hr * 100 + sess_bar_mn
sess_clock_start = sess_start_hr * 100 + sess_start_mn
sess_clock_end = sess_end_hr * 100 + sess_end_mn
in_session = not use_session or (sess_clock_start > sess_clock_end ? (sess_bar_t >= sess_clock_start or sess_bar_t < sess_clock_end) : (sess_bar_t >= sess_clock_start and sess_bar_t < sess_clock_end))
if not in_session
    strategy.close_all(comment="Session")

// === INPUTS ===
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)
atrLen = input.int(14, "ATR Length", minval=5, maxval=50)
pivotLeft = input.int(5, "Pivot Left", minval=1, maxval=20)
pivotRight = input.int(5, "Pivot Right", minval=1, maxval=20)

// === RISK MANAGEMENT ===

// === INDICATORS ===
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)
pivotLow = ta.pivotlow(low, pivotLeft, pivotRight)
pivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)

// === SESSION FILTER ===
// Guideline 1: Flatten at 16:45 NY. Enter only during active session.

// === LOGIC ===
// Condition 1: Trend/Structure Filter - Price is above a recent Pivot Low (Higher Low)
// Condition 2: Trigger - RSI is oversold (<30) and rising, or crosses above 30
// This captures momentum reversals after a pullback.

isPivotLow = not na(pivotLow)
isRSIOverbought = ta.crossover(rsi, 30)

// Long Entry Logic
longCondition = in_session and isPivotLow and isRSIOverbought
if longCondition
    if in_session
        strategy.entry("Long", strategy.long)
        strategy.exit("ExitLong", "Long", stop=long_stop, limit=long_limit)

// Short Entry Logic
// Condition 1: Price below Pivot High (Lower High)
// Condition 2: RSI is overbought (>70) and falling, or crosses below 70
isPivotHigh = not na(pivotHigh)
isRSIOversold = ta.crossunder(rsi, 70)

shortCondition = in_session and isPivotHigh and isRSIOversold
if shortCondition
    if in_session
        strategy.entry("Short", strategy.short)
        strategy.exit("ExitShort", "Short", stop=short_stop, limit=short_limit)

// === EXIT LOGIC ===
// Fixed Stop and Limit based on account percentage
longStopPrice = close - stop_dollars / pv
longLimitPrice = close + tp_dollars / pv
shortStopPrice = close + stop_dollars / pv
shortLimitPrice = close - tp_dollars / pv

strategy.exit("ExitLong", "Long", stop=long_stop, limit=long_limit)
strategy.exit("ExitShort", "Short", stop=short_stop, limit=short_limit)

// Guideline 1: Flatten all trades at 16:45 NY to prevent overnight risk
