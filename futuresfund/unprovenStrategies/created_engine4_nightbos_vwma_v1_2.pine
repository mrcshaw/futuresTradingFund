//@version=5
// Built from: Night BOS VWMA Momentum, Engine4_NewBreakout_v1, <ta.vwma, ta.atr, ta.crossover>
strategy("Engine4_NightBOS_VWMA_v1", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000, default_qty_value=1)
// ===== RISK =====
pv                = input.float(50, "Point Value ($)")
stop_dollars      = input.int(250, "Stop ($)", minval=250, maxval=750)
tp_dollars        = input.int(500, "Take Profit ($)", minval=250)
use_trail         = input.bool(false, "Enable Trailing Stop")
trail_pct         = input.float(50, "Trail keep (%)", minval=0, maxval=100)
trail_step_amt    = input.int(500, "Trail: Tighten every ($)", minval=0, maxval=2000)
trail_step_pct    = input.float(50, "Trail step (%)", minval=0, maxval=100)
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)", minval=0, maxval=2000)
long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
short_limit = close - tp_dollars / pv
if strategy.position_size != 0 and not na(stop_dollars)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")
pivot_left = input.int(5, "Pivot Left", minval=1, maxval=50)
pivot_right = input.int(5, "Pivot Right", minval=1, maxval=50)


// ===== SESSION =====
use_session   = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0,  "Session Start Minute")
sess_end_hr   = input.int(16,  "Session End Hour (ET)")
sess_end_mn   = input.int(0,  "Session End Minute")
sess_bar_hr = hour(time, "America/New_York")
sess_bar_mn = minute(time, "America/New_York")
sess_bar_t = sess_bar_hr * 100 + sess_bar_mn
sess_clock_start = sess_start_hr * 100 + sess_start_mn
sess_clock_end = sess_end_hr * 100 + sess_end_mn
in_session = not use_session or (sess_clock_start > sess_clock_end ? (sess_bar_t >= sess_clock_start or sess_bar_t < sess_clock_end) : (sess_bar_t >= sess_clock_start and sess_bar_t < sess_clock_end))
if not in_session
    strategy.close_all(comment="Session")

// === INPUTS ===
len_vwma = input.int(28, "VWMA Length", minval=1, maxval=100)
len_atr = input.int(28, "ATR Length", minval=1, maxval=100)
atr_mult = input.float(3.0, "ATR Mult", minval=1.0, maxval=10.0)
cooldown_bars = input.int(20, "Cooldown Bars", minval=1, maxval=100)

// === RISK ===

// === SESSION & COOLDOWN ===
var int last_bar = -1
var bool can_trade = true
if bar_index != last_bar
    if not can_trade
        can_trade := bar_index >= last_bar + cooldown_bars
    last_bar := bar_index

// === INDICATORS ===
vwma_val = ta.vwma(close, len_vwma)
atr_val = ta.atr(len_atr)
bos_high = ta.pivothigh(high, pivot_left, pivot_right)
bos_low = ta.pivotlow(low, pivot_left, pivot_right)

// BOS Logic: Check for pivot high/low at bar 5
var float bos_high_price = na
var float bos_low_price = na
var int bos_bar = -1

if not na(bos_high)
    bos_high_price := bos_high
    bos_bar := bar_index
    bos_low_price := na

if not na(bos_low)
    bos_low_price := bos_low
    bos_bar := bar_index
    bos_high_price := na

// === LOGIC ===
// Long: Price > VWMA and BOS Low formed recently (within 10 bars) and price breaks above BOS Low
// Short: Price < VWMA and BOS High formed recently and price breaks below BOS High

is_bullish_structure = not na(bos_low_price) and bar_index - bos_bar <= 10
is_bearish_structure = not na(bos_high_price) and bar_index - bos_bar <= 10

// Trigger: Close above BOS Low for long, Close below BOS High for short
long_condition = is_bullish_structure and close > bos_low_price and ta.crossover(close, bos_low_price)
short_condition = is_bearish_structure and close < bos_low_price and ta.crossunder(close, bos_low_price) // Fixed typo: bos_low_price -> bos_high_price? No, short breaks below BOS High.
// Correction: Short breaks below BOS High.
short_condition = is_bearish_structure and close < bos_high_price and ta.crossunder(close, bos_high_price)

// === EXECUTION ===
if in_session and can_trade
    if long_condition
        strategy.entry("Long", strategy.long)
        strategy.exit("ExitLong", "Long", stop=long_stop, limit=long_limit)
        can_trade := false
    if short_condition
        strategy.entry("Short", strategy.short)
        strategy.exit("ExitShort", "Short", stop=short_stop, limit=short_limit)
        can_trade := false

// === EXIT ===
// Calculate stop and limit prices
long_tp = close + tp_dollars / pv
short_tp = close - tp_dollars / pv

// Use strategy.exit with fixed prices
strategy.exit("ExitLong", "Long", stop=long_stop, limit=long_limit)
strategy.exit("ExitShort", "Short", stop=short_stop, limit=short_limit)

// === FLATTEN AT 16:45 ===
