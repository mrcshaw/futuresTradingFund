//@version=5
// Built from: POC Pullback Momentum v2, RSI 3system v2, Smart Trail + POC Delta Combined
// Indicators: ta.ema, ta.rsi, ta.atr, ta.pivothigh, ta.pivotlow

strategy("POC Momentum Reversal", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000)
// ===== RISK =====
pv                = input.float(5, "Point Value ($)")
stop_dollars      = input.int(250, "Stop ($)", minval=250, maxval=750)
tp_dollars        = input.int(500, "Take Profit ($)", minval=250)
use_trail         = input.bool(false, "Enable Trailing Stop")
trail_pct         = input.float(50, "Trail keep (%)", minval=0, maxval=100)
trail_step_amt    = input.int(500, "Trail: Tighten every ($)", minval=0, maxval=2000)
trail_step_pct    = input.float(50, "Trail step (%)", minval=0, maxval=100)
trail_min_dollars = input.int(1000, "Trail: Min Profit ($)", minval=0, maxval=2000)
long_stop = strategy.position_size > 0 ? strategy.position_avg_price - stop_dollars / pv : close - stop_dollars / pv
long_limit = close + tp_dollars / pv
short_stop = strategy.position_size < 0 ? strategy.position_avg_price + stop_dollars / pv : close + stop_dollars / pv
short_limit = close - tp_dollars / pv
if strategy.position_size != 0 and not na(stop_dollars)
    if strategy.openprofit <= -stop_dollars
        strategy.close_all(comment="Open P&L > SL Risk")
pivot_left = input.int(5, "Pivot Left", minval=1, maxval=50)
pivot_right = input.int(5, "Pivot Right", minval=1, maxval=50)


// ===== SESSION =====
use_session   = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0,  "Session Start Minute")
sess_end_hr   = input.int(16,  "Session End Hour (ET)")
sess_end_mn   = input.int(0,  "Session End Minute")
sess_bar_hr = hour(time, "America/New_York")
sess_bar_mn = minute(time, "America/New_York")
sess_bar_t = sess_bar_hr * 100 + sess_bar_mn
sess_clock_start = sess_start_hr * 100 + sess_start_mn
sess_clock_end = sess_end_hr * 100 + sess_end_mn
in_session = not use_session or (sess_clock_start > sess_clock_end ? (sess_bar_t >= sess_clock_start or sess_bar_t < sess_clock_end) : (sess_bar_t >= sess_clock_start and sess_bar_t < sess_clock_end))
if not in_session
    strategy.close_all(comment="Session")

// === INPUTS ===
lookback = input.int(20, "Lookback Period", minval=10, maxval=50)
atr_len = input.int(14, "ATR Length", minval=5, maxval=20)
rsi_len = input.int(14, "RSI Length", minval=7, maxval=20)

// === RISK CALCULATIONS ===

// === INDICATORS ===
atr = ta.atr(atr_len)
rsi = ta.rsi(close, rsi_len)
ema_fast = ta.ema(close, 9)
ema_slow = ta.ema(close, 21)

// Pivot Structure for Reversal Confirmation
ph = ta.pivothigh(high, pivot_left, pivot_right)
pl = ta.pivotlow(low, pivot_left, pivot_right)
last_high = ta.valuewhen(not na(ph), high, 1)
last_low = ta.valuewhen(not na(pl), low, 1)

// === SESSION FILTER ===
// Guideline 1: Flatten at 16:45 NY. Entry window 18:00 - 16:45.

// === COOLDOWN ===
var int last_entry_bar = -100
var int cooldown_bars = 15 // Bars to wait after entry
if bar_index == last_entry_bar + cooldown_bars
    cooldown_bars := 0 // Reset cooldown logic if needed, or keep simple bar check

// === LOGIC ===
// Long Condition: Price above EMA, RSI oversold/recovering, Pivot Low structure
long_cond = close > ema_slow and ta.crossover(rsi, 30) and low < last_low

// Short Condition: Price below EMA, RSI overbought/recovering, Pivot High structure
short_cond = close < ema_slow and ta.crossunder(rsi, 70) and high > last_high

// === EXECUTION ===
if long_cond and in_session
    strategy.entry("Long", strategy.long)
    strategy.exit("Long", "Long", stop=long_stop, limit=long_limit)
    last_entry_bar := bar_index
    strategy.exit("Long", "Long", stop=long_stop, limit=long_limit)

if short_cond and in_session
    strategy.entry("Short", strategy.short)
    strategy.exit("Short", "Short", stop=short_stop, limit=short_limit)
    last_entry_bar := bar_index
    strategy.exit("Short", "Short", stop=short_stop, limit=short_limit)

// === SESSION END FLATTEN ===
